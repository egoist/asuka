// Package std/json reads and writes JSON as typed values: the compiler
// knows the type read or written, so there's no schema to declare and
// nothing to cast.
//
//   struct Note { title: string; done: bool = false }
//
//   let notes: [Note] = try json.decode(text)
//   let same = try json.decode<[Note]>(text)
//   let out = json.encode(notes, indent: 2)
//
// A struct reads from an object by its fields' names; a field the object
// doesn't have is empty (nil, 0, false, "", an empty array or map), but
// a missing struct is an error. An enum without payloads reads from its
// case's name, an optional from null; [T] from an array, [string: T] from
// an object. A generic function may read or write its
// T: each call then needs a T JSON can say, which the compiler checks
// where it's called.
//
// What has no shape known as the program compiles is a Value: any JSON,
// as it is. json.parse(text) reads one; a struct's field may be one, for
// the part of a document that's free-form.
//
//   let v = try json.parse(text)
//   let version = v.get("engines")?.get("node")?.asString() ?? "any"

/// The value of type T that text says. It throws when text isn't JSON or
/// doesn't fit T (a value of the wrong type, a missing struct, a number
/// past int's range), or nests arrays and objects more than 512 deep, its
/// message saying what. T comes from what's expected of the call (let
/// notes: [Note] = try json.decode(text)) or is given: json.decode<[Note]>(text).
pub native fn decode<T>(text: string) throws -> T

/// value as JSON text: on one line, or with indent spaces per level.
/// Fields are written in their declaration order, a map's entries in its
/// own order.
pub native fn encode<T>(value: T, indent: int = 0) -> string
