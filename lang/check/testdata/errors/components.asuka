// Components: their bodies are declarations.

component Row2(title: string) {
  prop compact = false
  event archive

  Text(title)
}

component Body {
  state count = 0
  count += 1 // ERROR "an assignment in a view"
  print("hi") // ERROR "a void isn't a view"
  let x = await later() // ERROR "await only where code may wait"

  Column {
    Row2("a") { compact: true; on archive { count = 0 } }
    Row2(title: "b", compact: true) // ERROR "compact is a prop of Row2: set it in the block"
    Row2("c") { title: "x" } // ERROR "title is a parameter of Row2: pass it in the parentheses"
    Row2("d") { on press { } } // ERROR "Row2 has no event press \(its events: archive\)"
    Text("x") { colour: .red } // ERROR "Text has no prop colour \(did you mean color\?\)"
    Text("y") { Text("z") } // ERROR "Text takes no children"
    Button("b") { on press { count = count + 1 } }
    Text("{count}") { color: .notAColor } // ERROR "notAColor isn't a semantic color"
    Toggle { bind on: count } // ERROR "bind on takes a bool, and this is an int"
  }
}

async fn later() -> int {
  return 1
}

component Emits {
  event done(n: int)
  Button("go") { on press { emit done(1); emit done("x") } } // ERROR "argument n is a string, not an int"
}

store Data {
  state n = 0
  Text("no") // ERROR "a store has no views or statements"
}

fn risky() throws -> int = 1

component Declares {
  let n = try risky() // ERROR "what a component's body declares can't throw: give a fallback"
  let m = try risky() catch { 0 }
  Column {
    let inner = 3 // ERROR "a let in a view: .*declare it in the body, beside its state"
    var w = 1 // ERROR "var in a view: .*a value that changes is state"
    Text("{inner} {w} {n} {m}") // known names, if not values
  }
}

component Unknown {
  Text("x") {
    colourful: .red // ERROR "Text has no prop colourful"
    things: [] // ERROR "Text has no prop things"
  }
}

fn bitsOfBools(a: bool, b: bool) -> bool = a | b && !b // ERROR "\| takes ints, not a bool"

// A List's rows come from one for: a header, a status, a second for
// aren't rows.
component Feed {
  state ids = [1, 2]

  List {
    Text("Header") // ERROR "a List's rows come from one for in it"
    for id in ids key id { Text("{id}") }
    for id in ids key id { Text("again {id}") } // ERROR "a List has one for"
  }
}
