style card {
  padding: 16
  radius: 12
  background: .secondarySystemBackground
  shadow: Shadow(y: 2, blur: 8, color: #0000001a)
}

style title {
  fontSize: 20
  weight: .semibold
  color: #333
}

style chip(tint: Color, size: float = 13) {
  padding: [4, 10]
  radius: 999
  color: tint
  pressed { opacity: 0.7 }
}

pub style largeCard {
  use t: Theme
  style: [card, chip(.red)]
  padding: t.padding
}

style View { borderColor: .separator }

component Card(heading: string) {
  prop children: View

  Column {
    style: [card, if selected { chip(.accent) }]
    gap: 8
    width: 100%
    Text(heading) {
      style: title
      color: #ff3b30
    }
    children
  }
}

component Dashboard {
  Grid {
    columns: [1fr, 1fr, 2fr]
    gap: 12
    Card("Today") {
      Text("Sunny") {
        style: [
          if urgent { chip(.red) } else if read { title } else { card },
          match kind {
            .note => chip(.blue, size: 15)
            _ => []
          },
        ]
      }
    }
    Card("Week") {
      Text("Rain") { opacity: 0.6 }
    }
  }
}

pub component Checkbox {
  prop checked = false
  event checkedChange(checked: bool)
  pub variant checked = checked
  variant disabled = !enabled

  View {
    variant: 1
    on press { checked = !checked }
  }
}

component Agree {
  Checkbox {
    checked { background: .accent }
    style: box
  }
}
