import std/http
import platform/sensors.{Accelerometer}

screen Weather(city: string) {
  let forecast = load fetchForecast(city)
  state readings: [float] = []

  task {
    for await reading in Accelerometer.updates(every: 100ms) {
      readings.append(reading.x)
    }
  }

  effect(city) {
    let id = watch(city)
    cleanup { unwatch(id) }
  }
  cleanup { cleanup(city) }

  task(city) {
    let (today, week) = await all(fetchToday(city), fetchWeek(city))
    let fastest = await race(mirror1(city), mirror2(city))
    let summary = await spawn {
      return summarize(today, week, fastest)
    }
    await withTimeout(5s) {
      await http.post("/seen", body: summary)
    }
  }

  title: city

  match forecast {
    .pending => ProgressView()
    .ready(f) => Text("{f.high}° / {f.low}°")
    .failed(e) => Button("Retry") {
      on tap { forecast.reload() }
    }
  }
  if let last = forecast.value?.updated {
    Text("Updated {last.relative}") { fontSize: 12 }
  }
  Boundary {
    Chart(readings)
  } on error(e) {
    Text("The chart failed: {e.message}")
  }
}

async fn fetchForecast(city: string) throws -> Forecast {
  let cached = try? await cache.get(city)
  if let c = cached {
    return c
  }
  let f: Forecast = try await http.get("/forecast/{city}").json()
  return f
}

fn later(f: async fn(string) -> int) {}

async fn refreshAll() {
  let refresh = async () => {
    await sleep(1ms)
  }
  await refresh()
  later(async s => s.count())
}

worker SearchIndex(language: string = "en") {
  var words: [string: [int]] = [:]
  let stop = ["the", language]

  pub fn add(id: int, text: string) {
    for w in text.fields() {
      if !stop.contains(w) { words[w.lower()] = (words[w.lower()] ?? []) + [id] }
    }
  }
  pub fn find(q: string) -> [int] = words[q.lower()] ?? []
  fn clear() { words = [:] }
}

store Notes {
  let index = SearchIndex()
  state results: [int] = []

  pub async fn search(q: string) { results = await index.find(q) }
}
