// A Split's sidebar in sections: Sidebars of Destinations.

state chosen = 0

component Gallery {
  Split("Gallery") {
    bind selected: chosen
    Sidebar("Views") {
      Destination("Text") {
        icon: "textformat"
        Text("the text page")
      }
      Destination("Images") { Text("the images page") }
    }
    Sidebar("Controls") {
      Destination("Buttons") {
        badge: "New"
        Screen {
          toolbar {
            Button("Top") { on press { chosen = 0 } }
          }
          Text("the buttons page")
        }
      }
    }
    Destination("About") {
      section: "More"
      Text("the about page")
    }
  }
}

test "sections" {
  let app = mount(Gallery())
  app.expect("the text page")
  chosen = 2
  app.expect("the buttons page", "Buttons")
  app.expectNo("the text page")
  app.tap("Top")
  app.expect("the text page")
  chosen = 3
  app.expect("the about page")
  app.tap("Images")
  app.expect("the images page")
  expect(chosen == 1)
  app.in(.sidebar).expect("Text", "Buttons", "About")
}

// Destinations from a for and an if: the sidebar follows them, and the
// one shown stays shown as others come and go.
state folders = ["Inbox", "Work"]
state archive = false
state picked = 0

component Mail {
  Split("Mail") {
    bind selected: picked
    Sidebar("Folders") {
      for f in folders key f {
        Destination(f) { Text("the {f} folder") }
      }
    }
    if archive {
      Destination("Archive") { Text("the archive") }
    }
    Destination("Settings") { Text("the settings") }
  }
}

test "destinations from a for and an if" {
  let app = mount(Mail())
  app.in(.sidebar).expect("Inbox", "Work", "Settings")
  app.in(.sidebar).expectNo("Archive")
  app.tap("Work")
  app.expect("the Work folder")
  // One added before it: Work stays shown, one further down.
  folders = ["Drafts", "Inbox", "Work"]
  await app.idle()
  app.in(.sidebar).expect("Drafts")
  app.expect("the Work folder")
  expect(picked == 2)
  archive = true
  await app.idle()
  app.tap("Archive")
  app.expect("the archive")
  // The one shown goes: the one at its place shows instead.
  archive = false
  await app.idle()
  app.in(.sidebar).expectNo("Archive")
  app.expect("the settings")
  expect(picked == 3)
}

app { Gallery() }
