// Strings: interpolation, escapes, raw and multi-line strings, methods.

test "interpolation" {
  let name = "Asuka"
  let n = 3
  print("Hello, {name}! {n} items, {n * 2} doubled, {1.5}, {n > 2}")
  print("braces: \{ and \}; tab:[\t]")
  print(r"raw: \n {name}")
  let block = """
    one
      two {n}
    three
    """
  print(block)
}

test "methods" {
  let s = "  Hello, World  "
  let t = s.trim()
  print(t)
  print(t.upper())
  print(t.lower())
  print(t.count())
  expect(t.contains("World"))
  expect(t.hasPrefix("Hello") && t.hasSuffix("World"))
  print(t.replace("World", "Asuka"))
  print(t.split(", ").count())
  print(t.slice(0, 5))
  print(t.find("World") ?? -1)
  print("x".repeat(3))
  expect("".isEmpty())
  print("42".toInt()! + 1)
  expect("nope".toInt() == none)
  print("2.5".toFloat()!)
  print(["a", "b", "c"].joined(separator: "-"))
  print("héllo".count())
  print("héllo".byteCount())
  print(3.14159.fixed(2))
  // As printf's %.*f: the exact binary value rounded half to even, a
  // negative's sign kept when it rounds to 0.
  print(0.125.fixed(2), 2.675.fixed(2), 2.5.fixed(0), 3.5.fixed(0), (-0.0).fixed(2), (-0.001).fixed(2), (-1.5).fixed(0), 1e20.fixed(1), 0.1.fixed(20), (1.0 / 3.0).fixed(19), 1e300.fixed(0).byteCount(), (0.0 / 0.0).fixed(2), (-1.0 / 0.0).fixed(1))
}

test "concatenation and comparison" {
  var s = "a"
  s += "b"
  s = s + "c"
  print(s)
  expect(s == "abc")
  expect("apple" < "banana")
  expect("b" > "a")
  expect("a" <= "a")
}

test "trimming, splitting, finding" {
  print("v1.2".trimPrefix("v") + "|" + "v1.2".trimPrefix("x"))
  print("a.md".trimSuffix(".md") + "|" + "a.md".trimSuffix(".txt"))
  print("[" + "  x  ".trimStart() + "][" + "  x  ".trimEnd() + "]")
  print("a-b-c-d".replace("-", "+", count: 2))
  print("a-b-c-d".replace("-", "", count: 0))
  print("a-b-c-d".replace("-", "/"))
  print("k=v=w".split("=", count: 2))
  print("a,b,c".split(",", count: 1))
  print("a,b,c".split(",", count: 0))
  print("héllo".split("", count: 3))
  print("  the quick\tbrown\n fox ".fields())
  print("one\r\ntwo\n\nthree\n".lines())
  print("a/b/c".findLast("/") ?? -1)
  print("a/b/c".findLast("x") ?? -1)
  print("héllo, wörld".findAny("öw,") ?? -1)
  print("abc".findAny("xyz") ?? -1)
  let s = "héllo wörld"
  if let at = s.find(" ") {
    print(s.byteSlice(0, at) + "|" + s.byteSlice(at + 1, s.byteCount()) + "|" + s.byteSlice(at + 1))
    print("abcdef".bytes().slice(4).string())
  }
  print("7".padStart(3, with: "0") + " " + "7".padEnd(3) + "|")
  print("héllo".padStart(8, with: "ab") + " " + "toolong".padStart(3))
}

