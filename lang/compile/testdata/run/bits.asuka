// Bitwise operators on ints, int literals in other bases, and reading
// binary data from bytes.

test "operators" {
  let a = 0b1100
  let b = 0b1010
  print(a & b)
  print(a | b)
  print(a ^ b)
  print(~a)
  print(1 << 4)
  print(256 >> 4)
  print(-256 >> 4)
  print(0xff_ff & 0o17)
  expect(0x7fff_ffff_ffff_ffff == 9223372036854775807)
  expect(0xffff_ffff_ffff_ffff == -1)
}

test "precedence" {
  // Shifts bind tighter than *, & as tightly as *, | and ^ as +.
  print(1 + 2 << 3)
  print(2 * 1 << 3)
  print(6 & 3 + 1)
  print(1 | 2 * 3)
  print(1 | 6 & 3)
  print(-1 >> 1)
  expect((0xf0 | 0x0f) == 0xff && 3 ^ 1 == 2)
}

test "compound assignments" {
  var flags = 0
  flags |= 1 << 2
  flags |= 1
  flags &= ~1
  flags ^= 0b11
  flags <<= 4
  flags >>= 2
  print(flags)
  var xs = [1, 2, 3]
  xs[1] <<= 3
  print(xs)
}

test "wide shifts" {
  let n = 64
  print(1 << n)
  print(1 << 63)
  print(5 >> n)
  print(-5 >> 100)
  print((1 << 62) >> 62)
}

test "a negative shift throws" {
  let n = -1
  print(1 << n)
}

struct Reading {
  flags: int
  value: int
  temp: int
}

// A BLE characteristic: a flags byte, a little-endian uint16 and a
// signed int16.
fn parse(b: bytes) -> Reading {
  let raw = b[3] | b[4] << 8
  let temp = if raw & 0x8000 != 0 { raw - 0x10000 } else { raw }
  return Reading(flags: b[0], value: b[1] | b[2] << 8, temp: temp)
}

fn encode(r: Reading) -> bytes = bytes([r.flags, r.value & 0xff, r.value >> 8, r.temp & 0xff, r.temp >> 8 & 0xff])

test "bytes" {
  let data = bytes([0x05, 0x34, 0x12, 0xfe, 0xff])
  let r = parse(data)
  print("{r.flags} {r.value} {r.temp}")
  expect(r.value == 0x1234 && r.temp == -2)
  expect(encode(r) == data)
  print(encode(r).hex(" "))
  var sum = 0
  for i in 0..<data.count() {
    sum += data[i]
  }
  print(sum)
}

test "a byte out of range throws" {
  let b = bytes([1, 2])
  print(b[2])
}

// Output:
// 8
// 14
// 6
// -13
// 16
// 16
// -16
// 15
// ok operators
// 17
// 16
// 3
// 7
// 3
// -1
// ok precedence
// 28
// [1, 16, 3]
// ok compound assignments
// 0
// -9223372036854775808
// 0
// -1
// 1
// ok wide shifts
// FAIL a negative shift throws: negative shift amount
// 5 4660 -2
// 05 34 12 fe ff
// 584
// ok bytes
// FAIL a byte out of range throws: index 2 out of range (length 2)
