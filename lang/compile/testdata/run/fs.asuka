// std/fs: paths, the user's directories, and files in a directory of
// the test's own.

import std/fs
import std/os

test "paths" {
  print(fs.join(["a", "b", "c.md"]))
  print(fs.join(["/a/", "", "./b/", "../c"]))
  print(fs.join([]))
  print(fs.clean("a//b/./c/.."))
  print(fs.clean("../../a/../b"))
  print(fs.clean("/../a"))
  print(fs.clean(""))
  print(fs.dir("/a/b/c.md"))
  print(fs.dir("c.md"))
  print(fs.dir("/c.md"))
  print(fs.base("/a/b/c.md"))
  print(fs.base("/a/b/"))
  print(fs.base("/"))
  print(fs.base(""))
  print(fs.ext("c.tar.gz"))
  print(fs.ext("/a.b/c"))
  print(fs.ext(".profile"))
}

test "files" {
  let root = fs.join([fs.appDir(), "fs-test"])
  try fs.removeAll(root)
  print(fs.exists(root))
  try fs.mkdirAll(fs.join([root, "x", "y"]))
  try fs.mkdirAll(fs.join([root, "x", "y"]))
  let p = fs.join([root, "x", "note.txt"])
  try fs.writeText(p, text: "héllo")
  try fs.appendText(p, text: " world")
  print(try fs.readText(p))
  print((try fs.read(p)).count())
  try fs.copy(from: p, to: fs.join([root, "copy.txt"]))
  try fs.rename(from: fs.join([root, "copy.txt"]), to: fs.join([root, "moved.txt"]))
  for e in try fs.readDir(root) {
    print("{e.name} {e.isDir} {e.size}")
  }
  let info = try fs.stat(p)
  print("{info.name} {info.size} {info.modified.year() >= 2024}")
  // Off the main thread.
  let text = try await spawn { try fs.readText(p) }
  print(text)
  // Bytes that aren't UTF-8 read as U+FFFD, a byte each, as string() has them.
  let raw = fs.join([root, "raw.bin"])
  try fs.write(raw, data: bytes([0x61, 0xff, 0xc3, 0xa9, 0xe2, 0x82, 0x62, 0xed, 0xa0, 0x80]))
  print(try fs.readText(raw) == (try fs.read(raw)).string())
  print((try fs.readText(raw)).count())
  try fs.remove(raw)
  try fs.remove(fs.join([root, "moved.txt"]))
  print(fs.exists(fs.join([root, "moved.txt"])))
  try fs.removeAll(root)
  print(fs.exists(root))
}

test "failures" {
  let root = fs.join([fs.appDir(), "fs-fail"])
  try fs.removeAll(root)
  do {
    let t = try fs.readText(fs.join([root, "nope.txt"]))
    print(t)
  } catch fs.FsError.notFound(p) {
    print("not found: {fs.base(p)}")
  }
  try fs.mkdirAll(fs.join([root, "d"]))
  try fs.writeText(fs.join([root, "d", "f"]), text: "x")
  do {
    try fs.remove(fs.join([root, "d"]))
  } catch e {
    print(e.message.hasSuffix("directory not empty"))
  }
  do {
    let b = try fs.read(fs.join([root, "d"]))
    print(b.count())
  } catch fs.FsError.isDirectory(_) {
    print("is a directory")
  }
  do {
    try fs.mkdirAll(fs.join([root, "d", "f", "g"]))
  } catch e {
    print(e.message.hasPrefix(root))
  }
  print(fs.exists(fs.join([root, "nope", "x"])))
  try fs.removeAll(root)
}

test "the user's directories" {
  let _ = os.fake(env: ["HOME": "/home/ann/", "TMPDIR": "/var/tmp/x/"])
  print(fs.home())
  print(fs.tempDir())
  let _ = os.fake(env: ["HOME": "/home/ann"])
  print(fs.tempDir())
  print(try fs.abs("/a/./b/../c/"))
  print(try fs.abs("notes/../a.md") == fs.join([os.cwd(), "a.md"]))
  print(try fs.abs("") == fs.clean(os.cwd()))
}

test "the app's directories" {
  // A test's are its own, in its app directory, and each apart.
  let dirs = [fs.configDir(), fs.cacheDir(), fs.logDir()]
  print(dirs.map((d) => d.hasPrefix(fs.appDir())))
  print(dirs.map((d) => fs.base(d)))
  for d in dirs {
    try fs.mkdirAll(d)
    try fs.write(fs.join([d, "x.txt"]), "x".bytes())
  }
  print(dirs.map((d) => fs.exists(fs.join([d, "x.txt"]))))
}

test "walk" {
  let root = fs.join([fs.appDir(), "walk"])
  try fs.mkdirAll(fs.join([root, "b", "d"]))
  try fs.mkdirAll(fs.join([root, ".git"]))
  try fs.writeText(fs.join([root, "a.txt"]), text: "aa")
  try fs.writeText(fs.join([root, "b", "c.txt"]), text: "c")
  try fs.writeText(fs.join([root, "b", "d", "e.txt"]), text: "eee")
  try fs.writeText(fs.join([root, ".git", "HEAD"]), text: "ref")
  for e in try fs.walk(root) {
    print("{e.path.trimPrefix(root + "/")} {e.name} {e.isDir} {e.size}")
  }
  let shallow = try fs.walk(root, skip: [".git", "d"])
  print(shallow.map(e => e.path.trimPrefix(root + "/")))
  // Off the main thread.
  let all = try await spawn { try fs.walk(root, skip: [".git"]) }
  let texts = all.filter(e => fs.ext(e.name) == ".txt").map(e => e.name)
  print(texts)
  print((try fs.readDir(root)).map(e => e.path == fs.join([root, e.name])))
  print((try fs.stat(fs.join([root, "a.txt"]))).path.hasSuffix("walk/a.txt"))
  do {
    let _ = try fs.walk(fs.join([root, "nope"]))
  } catch fs.FsError.notFound(p) {
    print("not found: {fs.base(p)}")
  }
  do {
    let _ = try fs.walk(fs.join([root, "a.txt"]))
  } catch fs.FsError.notDirectory(p) {
    print("not a directory: {fs.base(p)}")
  }
  try fs.mkdirAll(fs.join([root, "empty"]))
  print((try fs.walk(fs.join([root, "empty"]))).isEmpty())
  try fs.removeAll(root)
}

