// Operators a struct's or an enum's methods do: + its add, - its sub
// or minus (the one whose parameter takes the right side), * its mul or
// times, / its div or quo, % its rem, -x its neg, <, <=, > and >= its
// compare; the operand's type may differ from the value's, and x *= y,
// /=, %= use them as += uses add.

import std/time

struct Money {
  cents: int

  fn add(m: Money) -> Money = Money(cents: cents + m.cents)
  fn sub(m: Money) -> Money = Money(cents: cents - m.cents)
  fn compare(m: Money) -> int = if cents < m.cents { -1 } else if cents > m.cents { 1 } else { 0 }
}

test "a struct's operators" {
  let a = Money(cents: 150)
  let b = Money(cents: 99)
  print("{(a + b).cents} {(a - b).cents} {a > b} {a <= b} {b < a} {a >= a}")
}

test "time's" {
  let a = time.unix(0, zone: .utc)
  let b = a + 90min
  let c = b - 30min
  print("{b - a} {c.format("HH:mm")} {a < b} {c > b} {a <= a}")
}

test "durations and floats" {
  let d = 90s
  print("{d * 0.5} {2.0 * d} {d / 30s} {d / 4.0}")
}

struct Vec {
  x: int
  y: int

  fn add(o: Vec) -> Vec = Vec(x: x + o.x, y: y + o.y)
  // The dot product; a Vec scaled by an int.
  fn mul(o: Vec) -> int = x * o.x + y * o.y
  fn times(k: int) -> Vec = Vec(x: x * k, y: y * k)
  fn div(k: int) -> Vec = Vec(x: x / k, y: y / k)
  fn rem(k: int) -> Vec = Vec(x: x % k, y: y % k)
  fn neg() -> Vec = Vec(x: -x, y: -y)
}

enum Sign {
  plus
  minus

  fn neg() -> Sign = match self {
    .plus => .minus
    .minus => .plus
  }
  fn mul(o: Sign) -> Sign = if self == o { .plus } else { .minus }
}

struct Ratio {
  n: int
  d: int

  fn div(o: Ratio) -> Ratio = Ratio(n: n * o.d, d: d * o.n)
  fn quo(k: int) -> Ratio = Ratio(n: n, d: d * k)
}

struct Grid {
  at: Vec
  path: [Vec]
}

state pos = Vec(x: 6, y: 9)

test "binary and unary" {
  let a = Vec(x: 3, y: 4)
  print(a * a)
  print(a * 2)
  print(a / 2)
  print(a % 2)
  print(-a)
  print(-(a + a) * 3)
  print(-Sign.plus)
  print(Sign.minus * Sign.minus)
  print(Sign.minus * -Sign.minus)
  let r = Ratio(n: 1, d: 2) / Ratio(n: 3, d: 4)
  print("{r.n}/{r.d}")
  let h = r / 2
  print("{h.n}/{h.d}")
}

test "compound assignment" {
  var v = Vec(x: 5, y: 7)
  v *= 10
  print(v)
  v /= 3
  print(v)
  v %= 4
  print(v)
  var g = Grid(at: Vec(x: 1, y: 2), path: [Vec(x: 1, y: 1), Vec(x: 2, y: 3)])
  g.at *= 3
  g.path[1] /= 2
  print(g)
  pos %= 4
  print(pos)
  var r = Ratio(n: 1, d: 2)
  r /= 5
  print("{r.n}/{r.d}")
}

// Output:
// 249 51 true false true true
// ok a struct's operators
// 90min 01:00 true false true
// ok time's
// 45s 3min 3 22500ms
// ok durations and floats
// 25
// Vec(x: 6, y: 8)
// Vec(x: 1, y: 2)
// Vec(x: 1, y: 0)
// Vec(x: -3, y: -4)
// Vec(x: -18, y: -24)
// minus
// plus
// minus
// 4/6
// 4/12
// ok binary and unary
// Vec(x: 50, y: 70)
// Vec(x: 16, y: 23)
// Vec(x: 0, y: 3)
// Grid(at: Vec(x: 3, y: 6), path: [Vec(x: 1, y: 1), Vec(x: 1, y: 1)])
// Vec(x: 2, y: 1)
// 1/10
// ok compound assignment
