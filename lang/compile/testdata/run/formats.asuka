// An interpolation's format, "{x:>8.2f}": [[fill]align][sign][#][0]
// [width][,|_][.precision][type], a number by its digits, anything else
// by its text.

enum Unit { lines, words }

test "formats" {
  let pi = 3.14159265
  let n = 1234567
  print("[{pi:.2}] [{pi:.2f}] [{pi:8.3f}] [{pi:<8.1}] [{pi:^9.2}] [{pi:+.1f}] [{-pi:08.2f}]")
  print("[{n}] [{n:,}] [{n:_}] [{n:>12,}] [{n:012}] [{-n:012,}] [{n:+}] [{0:+}]")
  print("[{255:x}] [{255:#X}] [{255:#o}] [{5:#010b}] [{0xdeadbeef:_x}] [{-255:#x}]")
  print("[{0.256:.1%}] [{1234.5:,.2f}] [{1e-7:.3e}] [{n:.2e}] [{n:.1f}] [{2.5:}]")
  let name = "Ada"
  print("[{name:<8}] [{name:>8}] [{name:^7}] [{name:*^9}] [{name:.2}] [{name:-<6}] [{"héllo":<7}|]")
  print("[{true:>6}] [{Unit.words:<8}] [{1500ms:>8}] [{[1, 2]:>8}]")
  let x: int? = none
  print("[{x:>6}] [{1.0 / 0.0:>10}] [{0.0 / 0.0:08}] [{"日本":·>5}]")
  for (lang, count) in [("go", 3), ("rust", 12), ("asuka", 125)] {
    print("{lang:<8}{count:>5}{float(count) / 140.0:>8.1%}")
  }
}

// Output:
// [3.14] [3.14] [   3.142] [3.1     ] [  3.14   ] [+3.1] [-0003.14]
// [1234567] [1,234,567] [1_234_567] [   1,234,567] [000001234567] [-001,234,567] [+1234567] [+0]
// [ff] [0XFF] [0o377] [0b00000101] [dead_beef] [-0xff]
// [25.6%] [1,234.50] [1.000e-07] [1.23e+06] [1234567.0] [2.5]
// [Ada     ] [     Ada] [  Ada  ] [***Ada***] [Ad] [Ada---] [héllo  |]
// [  true] [words   ] [  1500ms] [  [1, 2]]
// [  none] [  Infinity] [     NaN] [···日本]
// go          3    2.1%
// rust       12    8.6%
// asuka     125   89.3%
// ok formats
