// std/decimal: exact decimal numbers on the VM and compiled to C. The
// rounding modes and the quotients agree with Python's decimal module;
// a coefficient past an int throws "integer overflow", as an int's
// operators do, and caught it's a value like any error.

import std/decimal.{Decimal, RoundingMode}

let modes: [RoundingMode] = [.down, .up, .ceiling, .floor, .halfUp, .halfDown, .halfEven]

fn d(s: string) -> Decimal = Decimal.parse(s)!

// text is f's result as text, or its error's message.
fn text(f: fn() -> Decimal) -> string = try f().string() catch e { e.message }

test "the RFC's example" {
  let price: Decimal = .parse("19.99")!
  let total = price * 3 + Decimal.parse("4.50")!
  print(total.string())
  let each = (total / 4).rounded(places: 2, mode: .halfEven)
  print(each.string())
  print(each.formatted(currency: "EUR"))
  var t = Decimal.zero
  for (p, qty) in [(d("0.10"), 3), (d("1.05"), 2)] {
    t = t + p * qty
  }
  print(t.string())
  print((0.1 + 0.2 == 0.3, d("0.1") + d("0.2") == d("0.3")))
}

test "parse and string" {
  for s in ["19.99", "-0.5", ".25", "+3", "1000", "1.50", "007.100", "-0", "0.000", "1e3", "1.5e-3", "-2.5E+2", "100000000000000000000000", "0.0000000000000000000001", "9223372036854775807", "-9223372036854775807"] {
    let (c, e) = d(s).parts()
    print("{s}: {d(s).string()} {c} {e}")
  }
  for s in ["", "-", ".", "1.", "1.2.3", "1e", "1e+", "12a", " 1", "1 ", "--1", "9223372036854775808", "99999999999999999999", "1e9223372036854775807"] {
    print("{s}: {Decimal.parse(s) == none}")
  }
  print(Decimal.of(1999, exponent: -2).string())
  print(Decimal.of(-1200).string())
  print(Decimal.of(1200) == d("1.2e3"))
}

test "rounding modes" {
  for x in ["2.5", "3.5", "-2.5", "2.45", "-2.45", "1.005", "2.4999", "-2.5001", "0.001", "123456.789"] {
    for p in [0, 2, -1] {
      print("{x} {p}: " + modes.map(m => d(x).rounded(places: p, mode: m).string()).joined(separator: " "))
    }
  }
  print(d("2.345").rounded(places: 2).string())
  print(d("2.345").rounded(places: 2, mode: .halfUp).string())
  print(d("17").rounded(places: 3).string())
}

test "division" {
  for (a, b) in [("1", "3"), ("2", "3"), ("64.47", "4"), ("22", "7"), ("-1", "3"), ("1", "-6"), ("9223372036854775807", "3"), ("1", "9223372036854775807"), ("0.001", "7"), ("1e20", "3"), ("-7.5", "0.3")] {
    print("{a} / {b}: {text(() => d(a) / d(b))}")
    for p in [2, -1, 25] {
      print("  {p}: " + modes.map(m => text(() => d(a).divided(by: d(b), places: p, mode: m))).joined(separator: " "))
    }
  }
  print((d("10") / 4).string())
  print(text(() => d("1") / Decimal.zero))
  print(text(() => d("1").divided(by: Decimal.zero, places: 2)))
  print(text(() => d("1") % Decimal.zero))
}

test "sums, products and remainders" {
  for (a, b) in [("0.1", "0.2"), ("1e30", "1"), ("1e19", "-9223372036854775807"), ("5000000000000000001", "4999999999999999999"), ("9223372036854775807", "1"), ("-9223372036854775807", "-1"), ("7450580596923828125", "1024"), ("1.5", "-1.5"), ("123.456", "0.0001"), ("-7.5", "2"), ("1e40", "1e-40"), ("1e-40", "3"), ("0", "-3.25")] {
    let x = d(a)
    let y = d(b)
    print("{a} {b}: {text(() => x + y)} {text(() => x - y)} {text(() => x * y)} {text(() => x % y)} {x.compare(y)}")
  }
  var c = d("100.00")
  c -= d("0.01")
  c *= d("1.5")
  c /= d("3")
  c %= d("7")
  print(c.string())
  var n = d("2.5")
  n *= 4
  n /= 3
  print(n.string())
  print((-d("2.5")).string())
}

test "order, equality and hashing" {
  let xs = ["10", "-1.5", "0.001", "9.99", "-1.50", "1e-3", "0", "1e2", "-100"].map(s => d(s))
  print(xs.sorted().map(x => x.string()).joined(separator: " "))
  print(Set(xs).count())
  let prices: [Decimal: string] = [d("1.50"): "a"]
  print(prices[d("1.5")] ?? "none")
  print((d("2") > d("1.99"), d("-2") < d("-1.99"), d("1e19") > d("9223372036854775807"), d("0.1") >= d("0.10")))
}

test "conversions and formats" {
  print((d("2.7").int(), d("-2.7").int(), d("1e3").int()))
  print(d("0.1").float())
  print(text(() => Decimal.of(d("1e19").int())))
  print((d("-3.2").abs().string(), d("-3.2").sign(), Decimal.zero.isZero()))
  print(d("1234567.891").formatted())
  print(d("1234.5").formatted(currency: "USD"))
  print(d("1234.5").formatted(currency: "JPY"))
  print(d("-0.125").formatted(currency: "CHF"))
  print(d("1.2345").formatted(currency: "kwd"))
}

