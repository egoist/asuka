// Allow: GET, POST, HEAD
// Content-Type: text/plain; charset=utf-8
// Content-Length: 18
//
// Method Not Allowed
// Not Found 404
// ok a JSON API
// GET /a%20b q=fish & chips all=["1", "2"] ua=test/1 body= local=true
// PUT /up q=- all=[] ua=- body=x y local=true
// HTTP/1.1 200 OK
// Content-Type: text/plain; charset=utf-8
// Content-Length: 39
// ok what a request says
// Internal Server Error 500
// ["/x: no database"]
// ok a handler that throws
// HTTP/1.1 200 OK
// Content-Type: text/plain
// Transfer-Encoding: chunked
//
// line 1
// line 2
// line 3
// HTTP/1.1 200 OK
// Content-Type: text/event-stream
// Cache-Control: no-cache
// X-Accel-Buffering: no
// Transfer-Encoding: chunked
//
// data: hello
//
// id: 7
// event: price
// retry: 1500
// data: 1
// data: 2
// HTTP/1.1 200 OK
// Content-Type: text/plain
// Connection: close
//
// line 1
// line 2
// line 3
// ok streams and events
// closed, and ran ["the feed's defer", "the slow handler's defer"]
// ["feed", "slow"] true true
// ok closing cancels what's running, its defers run
// true: the port is in use
// can't listen at 127.0.0.1:70000: a port is 0 to 65535
// ok a port that's taken
