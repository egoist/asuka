// Lazy sequences (Seq<T>): adapters compute nothing until something reads
// the sequence, a take or a find stops what's before it, and each read
// starts again; the sources (arrays, maps, sets, strings, ranges, the
// generators, a type's iter()), for over one, the consumers (closures
// that throw make them throw), and a copy's independence.

struct P {
  name: string
  age: int
}

struct Version {
  major: int
  minor: int

  fn compare(o: Version) -> int = if major != o.major { major - o.major } else { minor - o.minor }
}

// A type whose iter() gives a Seq: for goes over it, nones too.
struct Slots {
  items: [int?]

  fn iter() -> Seq<int?> = items.lazy()
}

fn parse(s: string) throws -> int = s.toInt() ?? throw Error("not a number: {s}")

test "laziness, counted" {
  var mapped = 0
  var tested = 0
  let s = (1..1000000)
    .lazy()
    .map(x => { mapped += 1; return x * x })
    .filter(x => { tested += 1; return x % 3 == 0 })
    .take(3)
  print("{mapped} {tested}")
  print(s.toArray())
  print("{mapped} {tested}")
  for x in s { print(x) }
  print("{mapped} {tested}")
  var seen = 0
  let firstBig = Seq(from: 1).onEach(x => { seen += 1 }).find(where: x => x * x > 50)
  print("{firstBig} {seen}")
  print(Seq(from: 0).map(x => x * 2).any(where: x => x > 10))
  print(Seq(from: 0).all(where: x => x < 5))
  var n = 0
  let skipped = [1, 2, 3, 4, 5].lazy().map(x => { n += 1; return x }).skip(3).first()
  print("{skipped} {n}")
}

test "sources" {
  print([3, 1, 2].lazy().toArray())
  print(["b": 2, "a": 1].lazy().toArray())
  let s: Set<string> = ["x", "y"]
  print(s.lazy().map(x => x.upper()).joined(separator: ","))
  print("añb".lazy().toArray())
  print((0..<5).lazy().toArray())
  print((3..5).lazy().toArray())
  print((5..<5).lazy().count())
  print((9223372036854775806..9223372036854775807).lazy().toArray())
  print(Seq(first: 1, next: x => x * 3).take(5).toArray())
  print(Seq(first: 100, next: x => if x > 1 { x / 2 } else { none }).toArray())
  print(Seq(state: (0, 1), next: s => (s.0, (s.1, s.0 + s.1))).take(10).toArray())
  print(Seq(state: 10, next: n => if n < 0 { none } else { ("{n}", n - 3) }).toArray())
  print(Seq(repeating: "ab", count: 3).joined())
  print(Seq(repeating: 7).take(2).toArray())
  print(Seq(from: 10, by: -4).take(4).toArray())
  let slots = Slots(items: [1, none, 3])
  for x in slots { print(x) }
  let opts: [int?] = [none, 2]
  for o in opts.lazy() { print(o) }
}

test "adapters" {
  let xs = [5, 3, 8, 1, 9, 2]
  print(xs.lazy().enumerated().filter(p => p.1 > 4).toArray())
  for (i, x) in xs.lazy().enumerated().skip(4) { print("{i}: {x}") }
  print(xs.lazy().zip(["a", "b"].lazy()).toArray())
  print(xs.lazy().chunked(4).toArray())
  print(xs.lazy().windows(3).map(w => w.sum()).toArray())
  print(xs.lazy().windows(9).toArray())
  print(xs.lazy().takeWhile(x => x != 1).toArray())
  print(xs.lazy().skipWhile(x => x != 1).toArray())
  print(["7", "x", "42"].lazy().compactMap(c => c.toInt()).toArray())
  print(["1", "x"].lazy().map(c => c.toInt()).toArray())
  print([1, 2, 1, 3, 2].lazy().unique().toArray())
  print([1, 2].lazy().concat([3].lazy()).flatMap(x => Seq(repeating: x, count: x)).toArray())
  print([[1, 2], [], [3]].lazy().flatMap(x => x.lazy()).toArray())
}

test "consumers" {
  let xs = [5, 3, 8, 1, 9, 2]
  print("{xs.lazy().count()} {xs.lazy().count(where: x => x > 4)}")
  print("{xs.lazy().first()} {xs.lazy().last()} {xs.lazy().filter(x => x > 100).first()}")
  print("{xs.lazy().sum()} {[0.5, 0.25].lazy().sum()} {xs.lazy().reduce("", (s, x) => s + "{x}")}")
  print("{xs.lazy().min()} {xs.lazy().max()} {xs.lazy().contains(8)} {xs.lazy().contains(4)}")
  let ps = [P(name: "a", age: 30), P(name: "b", age: 20), P(name: "c", age: 20)]
  print("{ps.lazy().min(key: p => p.age)!.name} {ps.lazy().max(key: p => p.age)!.name}")
  print("{ps.lazy().min(by: (a, b) => a.name > b.name)!.name}")
  let vs = [Version(major: 1, minor: 2), Version(major: 1, minor: 0)]
  print(vs.lazy().min()!.minor)
  print(ps.lazy().map(p => (p.name, p.age)).toMap())
  print(ps.lazy().map(p => p.age).toSet())
  print(ps.lazy().map(p => p.name).joined(separator: "+"))
  let empty: [int] = []
  print("{empty.lazy().min()} {empty.lazy().last()} {empty.lazy().sum()}")
}

test "closures that throw" {
  let ok = try ["1", "2"].lazy().reduce(0, (s, x) => s + try parse(x))
  print(ok)
  let r = try ["1", "x"].lazy().any(where: x => try parse(x) > 5) catch e { print(e.message); false }
  print(r)
  let c = try ["3", "1"].lazy().count(where: x => try parse(x) > 1)
  print(c)
}

test "value semantics" {
  var xs = [1, 2, 3]
  let s = xs.lazy().map(x => x * 10)
  xs.push(4)
  xs[0] = 100
  print("{s.toArray()} {xs}")
  let t = s
  print(t.concat(s).toArray())
  var counter = 0
  let gen = Seq(state: 0, next: n => { counter += 1; return (n, n + 1) })
  print("{gen.take(3).toArray()} {gen.take(3).toArray()} {counter}")
}

test "big and endless" {
  let n = (0..<100000).lazy().map(x => x % 7).filter(x => x == 0).count()
  print(n)
  let total = Seq(from: 1).take(100000).sum()
  print(total)
  print(Seq(from: 1).map(x => x * x).skipWhile(x => x < 1000000).first())
}

test "an endless count past int" {
  print(Seq(from: 9223372036854775806).take(3).toArray())
}

