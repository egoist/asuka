// print and eprint: several values, as interpolation shows them, with a
// separator and a terminator of their own.
import std/os

enum Light {
  red
  green
}

struct P {
  x: int
  y: int
}

test "several values" {
  let missing: int? = none
  print("a", 1, 2.5, true, Light.green, P(x: 1, y: 2), [1, 2], missing)
  print()
  print("x", "y", separator: ", ")
  print("no line", terminator: "")
  print(" then the rest")
  print(1, 2, 3, separator: "-", terminator: "!\n")
  let sep = " | "
  print("a", "b", separator: sep)
  print(5ms, Light.red)
}

fn main() {
  eprint("oops", 42)
  eprint("a", "b", separator: "+", terminator: ";")
  print("out")
}

test "eprint goes to stderr" {
  let o = os.fake()
  let code = await o.run(main)
  print(code)
  print(o.stdout().trim())
  print(o.stderr())
}

// Output:
// a 1 2.5 true green P(x: 1, y: 2) [1, 2] none
//
// x, y
// no line then the rest
// 1-2-3!
// a | b
// 5ms red
// ok several values
// 0
// out
// oops 42
// a+b;
// ok eprint goes to stderr
