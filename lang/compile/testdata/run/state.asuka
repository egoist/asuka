// State outside the UI: a file's state, its memos, a store, effects.

state count = 0
let doubled = count * 2

struct Item {
  name: string
  done: bool = false
}

store Cart {
  state items: [Item] = []
  state total = 0
  let left = items.count(i => !i.done)

  // It follows the length (rfcs/0013): finishing an item doesn't run it.
  effect {
    print("cart has {items.count()}")
  }

  fn add(name: string) {
    items.push(Item(name: name))
    total += 1
  }

  fn finish(i: int) {
    items[i].done = true
  }
}

test "file state and memos" {
  print(doubled)
  count = 5
  print(doubled)
  count += 1
  print(count)
  print(doubled)
}

test "a store" {
  let cart = Cart()
  cart.add("milk")
  cart.add("eggs")
  print(cart.left)
  cart.finish(0)
  print(cart.left)
  print(cart.items[0].done)
  print(cart.total)
  cart.items.push(Item(name: "tea"))
  print(cart.left)
}

// A store's state that starts from its memo: the memo runs as the store
// is made, before the store is whole.
store Doubler(start: int) {
  let doubled = start * 2
  state count = doubled + 1
  fn bump() { count += 1 }
}

test "a store's state from its memo" {
  let d = Doubler(start: 3)
  print("{d.count} {d.doubled}")
  d.bump()
  print(d.count)
}

state nums: [int] = [5, 1, 4, 2, 3]

struct Shelf {
  items: [int]
}
state shelf = Shelf(items: [3, 1, 2])

test "a closure reads state the builtin it's passed to changes" {
  // It sees the value as it was: the change is put back after.
  nums.removeWhere(x => x > nums.count() - 2)
  print(nums)
  nums.removeWhere(x => x == nums[0])
  print(nums)
  shelf.items.removeWhere(i => i == shelf.items[0])
  print(shelf.items)
  nums.sort(by: (a, b) => nums.count() > 1 && a > b)
  print(nums)
}

// Output:
// 0
// 10
// 6
// 12
// ok file state and memos
// cart has 0
// cart has 1
// cart has 2
// 2
// 1
// true
// 2
// cart has 3
// 2
// ok a store
// 7 6
// 8
// ok a store's state from its memo
// [1, 2, 3]
// [2, 3]
// [1, 2]
// [3, 2]
// ok a closure reads state the builtin it's passed to changes
