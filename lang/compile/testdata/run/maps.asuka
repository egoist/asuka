// Maps, kept in insertion order.

test "maps" {
  var ages = ["ann": 30, "bob": 25]
  ages["cy"] = 41
  ages["ann"] = 31
  print(ages.count())
  print(ages["ann"]!)
  print(ages["zed"] ?? 0)
  expect(ages.has("bob") && !ages.has("zed"))
  print(ages.keys())
  print(ages.values())
  expect(ages.remove("bob"))
  expect(!ages.remove("bob"))
  for (name, age) in ages { print("{name}={age}") }
  var counts: [string: int] = [:]
  for w in "a b a c a".split(" ") {
    counts[w] = (counts[w] ?? 0) + 1
  }
  print(counts)
  var ids: [int: string] = [1: "one"]
  ids[2] = "two"
  print(ids.get(2)!)
  expect(!ids.isEmpty())
  let m2 = ["a": [1, 2]]
  print(m2["a"]!.count())
}

enum Shade { light, dark }

state defaults = 0

fn fallback(n: int) -> int {
  defaults += 1
  return n
}

test "a read with a default" {
  // m[k] ?? d reads the value as it is, and evaluates d only when k
  // is missing.
  var counts: [string: int] = [:]
  for w in ["a", "b", "a"] {
    counts[w] = (counts[w] ?? 0) + 1
  }
  let names = [1: "one"]
  let shades = ["x": Shade.dark]
  let fs = [1: 1.5]
  let opt: [string: int?] = ["a": none, "b": 2]
  print("{counts} {names[1] ?? "?"} {names[3] ?? "?"} {shades["x"] ?? .light} {shades["y"] ?? .light} {fs[1] ?? 0.0}")
  print("{opt["a"] ?? 9} {opt["b"] ?? 9} {opt["c"] ?? 9}")
  print("{counts["a"] ?? fallback(1)} {counts["z"] ?? fallback(2)} {defaults}")
}

test "if let of a read" {
  let m = ["a": 1, "b": 2]
  if let v = m["a"] { print("a {v}") }
  if let v = m["z"] { print("z {v}") } else { print("no z") }
  let s = [1: "x"]
  if let v = s[1], v == "x" { print("x!") }
  var total = 0
  var keys = ["a", "b", "q", "a"]
  while let k = keys.pop() {
    if let v = m[k] {
      let f = () => v * 10
      total += v + f()
    }
  }
  var box = ["k": [1, 2]]
  if let xs = box["k"] {
    box["k"] = []
    print("{total} {xs} {box}")
  }
}

// Output:
// 3
// 31
// 0
// ["ann", "bob", "cy"]
// [31, 25, 41]
// ann=31
// cy=41
// ["a": 3, "b": 1, "c": 1]
// two
// 2
// ok maps
// ["a": 2, "b": 1] one ? dark light 1.5
// 9 2 9
// 2 2 1
// ok a read with a default
// a 1
// no z
// x!
// 44 [1, 2] ["k": []]
// ok if let of a read
