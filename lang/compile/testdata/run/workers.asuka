// Workers: a value on a thread of its own. Its pub fns, called from
// outside, are async: the arguments go over as values, the calls run in
// the order they were made, and their results come back as values.

worker SearchIndex {
  var words: [string: [int]] = [:]
  var adds = 0

  pub fn add(id: int, text: string) {
    for w in text.split(" ") {
      let k = w.lower()
      var ids = words[k] ?? []
      ids.push(id)
      words[k] = ids
    }
    adds += 1
  }

  pub fn find(q: string) -> [int] = words[q.lower()] ?? []

  pub fn stats() -> Stats = Stats(words: words.count(), adds: adds)
}

struct Stats {
  words: int
  adds: int
}

enum Shape {
  circle(radius: float)
  square(side: float)
}

worker Counter(start: int, step: int = 1) {
  let label = "counter from {start}"
  var n = start
  var seen: [int] = []

  pub fn next() -> int {
    n = bump(n)
    seen.push(n)
    return n
  }
  fn bump(x: int) -> int = x + step
  pub fn history() -> (string, [int]) = (label, seen)
  pub fn area(s: Shape) -> float = match s {
    .circle(r) => 3.0 * r * r
    .square(side) => side * side
  }
}

enum Lookup: Error {
  missing(key: string)
}

worker Strict {
  var keys: Set<string> = Set()

  pub fn put(k: string) { keys.insert(k) }
  pub fn get(k: string) throws -> string {
    if !keys.contains(k) { throw Lookup.missing(key: k) }
    return k.upper()
  }
  pub fn divide(a: int, b: int) -> int = a / b
}

test "calls run in order, values in and out" {
  let index = SearchIndex()
  await index.add(1, "Hello world")
  await index.add(2, "hello again")
  print(await index.find("HELLO"))
  print(await index.find("nothing"))
  let s = await index.stats()
  print("{s.words} words, {s.adds} adds")
}

test "parameters, lets and private fns" {
  let c = Counter(start: 10, step: 5)
  let (a, b) = await all(c.next(), c.next())
  print("{a} {b}")
  let (label, seen) = await c.history()
  print("{label}: {seen}")
  print(await c.area(.square(side: 3.0)))
  let d = Counter(start: 1)
  print(await d.next())
}

test "errors cross back" {
  let s = Strict()
  await s.put("a")
  print(try await s.get("a"))
  do {
    print(try await s.get("b"))
  } catch Lookup.missing(key) {
    print("missing {key}")
  }
  do {
    print(await s.divide(1, 0))
  } catch e {
    print("caught: {e.message}")
  }
  print(await s.divide(6, 3))
}

store Notes {
  let index = SearchIndex()
  state results: [int] = []

  pub async fn add(id: int, text: string) { await index.add(id, text) }
  pub async fn search(q: string) { results = await index.find(q) }
}

test "a store's worker" {
  let notes = Notes()
  await notes.add(7, "buy milk")
  await notes.search("milk")
  print(notes.results)
}

// Output:
// [1, 2]
// []
// 3 words, 2 adds
// ok calls run in order, values in and out
// 15 20
// counter from 10: [15, 20]
// 9
// 2
// ok parameters, lets and private fns
// A
// missing b
// caught: division by zero
// 2
// ok errors cross back
// [7]
// ok a store's worker
