// std/os in tests: a fake process (arguments, environment, stdin),
// what's written kept, main run as the program would run it.

import std/os

fn greet() {
  let name = os.args().first() ?? "world"
  print("Hello, {name}!")
  if let v = os.env("VERBOSE") {
    eprint("verbose: {v}")
  }
}

async fn echo() throws {
  for await line in os.lines() {
    print(line.upper())
  }
}

enum Bad: Error { nope(why: string) }

fn fails() throws {
  throw Bad.nope(why: "no")
}

fn exits() {
  defer { print("defer runs") }
  print("exiting")
  os.exit(4)
}

test "a test's process has no arguments, no stdin" {
  print(os.args().count())
  print(os.readLine() ?? "none")
  print(os.terminal(.stdout))
}

test "args and env" {
  let o = os.fake(args: ["Ann"], env: ["VERBOSE": "1"])
  expect(await o.run(greet) == 0)
  print(o.stdout())
  print(o.stderr())
  print(os.environ().count())
  print(o.exitCode() ?? -1)
}

test "stdin" {
  let o = os.fake(stdin: "a\nb\r\nc")
  expect(await o.run(echo) == 0)
  print(o.stdout())
}

test "an error main throws: 1, and its message on stderr" {
  let o = os.fake()
  print(await o.run(fails))
  print(o.stderr())
}

test "exit's code; the task ends there" {
  let o = os.fake()
  print(await o.run(exits))
  print(o.stdout())
  print(o.exitCode() ?? -1)
}

async fn serve() {
  defer { print("serve stopped") }
  await sleep(1h)
}

async fn handles() throws {
  for await s in os.signals([.interrupt, .hangup]) {
    print("got {s}")
    if s == .interrupt { break }
  }
  print("handled")
}

async fn interrupt(o: os.FakeOS, s: os.Signal) {
  await sleep(10ms)
  o.signal(s)
}

test "a signal ends main: its defers run, 128 and its number" {
  let o = os.fake()
  let (code, _) = await all(o.run(serve), interrupt(o, .interrupt))
  print(code)
  print(o.stdout())
  let t = os.fake()
  let (term, _) = await all(t.run(serve), interrupt(t, .term))
  print(term)
}

test "a stream that reads signals gets them" {
  let o = os.fake()
  let (code, _, _) = await all(o.run(handles), interrupt(o, .hangup), sendLater(o))
  print(code)
  print(o.stdout())
}

async fn sendLater(o: os.FakeOS) {
  await sleep(20ms)
  o.signal(.interrupt)
}

fn buffered() {
  let out = os.writer(.stdout)
  out.write("a ")
  out.write("b\n")
  print("print writes what's held first")
  let copy = out
  copy.writeBytes("a copy's\n".bytes())
  out.write("held as main ends\n")
  let err = os.writer(.stderr, size: 4)
  err.write("longer than its buffer\n")
}

test "a writer: in order with print, what it holds written as main ends" {
  let o = os.fake()
  expect(await o.run(buffered) == 0)
  print(o.stdout())
  print(o.stderr())
}

// Output:
// 0
// none
// false
// ok a test's process has no arguments, no stdin
// Hello, Ann!
//
// verbose: 1
//
// 1
// -1
// ok args and env
// A
// B
// C
//
// ok stdin
// 1
// error: Bad.nope(why: "no")
//
// ok an error main throws: 1, and its message on stderr
// 4
// exiting
// defer runs
//
// 4
// ok exit's code; the task ends there
// 130
// serve stopped
//
// 143
// ok a signal ends main: its defers run, 128 and its number
// 0
// got hangup
// got interrupt
// handled
//
// ok a stream that reads signals gets them
// a b
// print writes what's held first
// a copy's
// held as main ends
//
// longer than its buffer
//
// ok a writer: in order with print, what it holds written as main ends
