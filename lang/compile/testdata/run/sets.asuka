// Set<T>: distinct Hashable values, in insertion order.

import std/json

enum Day { mon, tue, wed }

struct Profile {
  name: string
  tags: Set<string>
}

fn tagged(xs: Set<string>, tag: string) -> bool = xs.contains(tag)

state picked: Set<int> = []

test "literals and methods" {
  var tags: Set<string> = ["swift", "go", "swift", "c"]
  print(tags.count())
  print(tags.contains("go"))
  print(tags.contains("rust"))
  print(tags.insert("rust"))
  print(tags.insert("go"))
  print(tags.remove("swift"))
  print(tags.remove("swift"))
  print(tags.isEmpty())
  print(tags)
  let empty: Set<int> = []
  print(empty.isEmpty())
  print(tagged(["a", "b"], "b"))
}

test "iteration is in insertion order" {
  var s: Set<int> = [3, 1, 2]
  s.insert(0)
  s.remove(1)
  s.insert(1)
  var out: [int] = []
  for x in s {
    out.push(x)
  }
  print(out)
  // The loop goes over the set as it was: a change in it copies.
  for x in s {
    s.insert(x + 10)
  }
  print(s.count())
}

test "algebra" {
  let a: Set<int> = [1, 2, 3, 4]
  let b: Set<int> = [3, 4, 5]
  print(a.union(b))
  print(a.intersection(b))
  print(a.subtracting(b))
  let small: Set<int> = [2, 3]
  print(small.isSubset(of: a))
  print(a.isSubset(of: small))
  print(a.isSuperset(of: small))
  print(a.isSuperset(of: b))
}

test "equality and values" {
  let a: Set<string> = ["x", "y"]
  let b: Set<string> = ["y", "x"]
  print(a == b)
  var c = a
  c.insert("z")
  print(a == c)
  print(a.count())
  let days: Set<Day> = [.mon, .wed]
  print(days.contains(.tue))
  print(days)
  let flags: Set<bool> = [true, true]
  print(flags.count())
}

test "Set() of an array" {
  let s = Set([5, 5, 6])
  print(s)
  let e = Set<string>()
  print(e.count())
}

test "state" {
  picked.insert(4)
  picked.insert(2)
  picked.insert(4)
  print(picked)
  picked = picked.union([9])
  print(picked.count())
}

test "json" {
  let p = Profile(name: "ada", tags: ["math", "code"])
  let text = json.encode(p)
  print(text)
  let q: Profile = try json.decode(text)
  print(q.tags.contains("code"))
  let s: Set<int> = try json.decode("[3, 1, 3]")
  print(s)
}

test "spawn" {
  let s: Set<int> = [1, 2, 3]
  let n = await spawn { s.union([4]).count() }
  print(n)
  let back = await spawn {
    var t: Set<string> = []
    t.insert("w")
    return t
  }
  print(back.contains("w"))
}

// Output:
// 3
// true
// false
// true
// false
// true
// false
// false
// Set(["go", "c", "rust"])
// true
// true
// ok literals and methods
// [3, 2, 0, 1]
// 8
// ok iteration is in insertion order
// Set([1, 2, 3, 4, 5])
// Set([3, 4])
// Set([1, 2])
// true
// false
// true
// false
// ok algebra
// true
// false
// 2
// false
// Set([.mon, .wed])
// 1
// ok equality and values
// Set([5, 6])
// 0
// ok Set() of an array
// Set([4, 2])
// 3
// ok state
// {"name":"ada","tags":["math","code"]}
// true
// Set([3, 1])
// ok json
// 4
// true
// ok spawn
