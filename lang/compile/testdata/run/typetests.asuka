// Type tests on interface values: struct patterns, typed names and
// enums' cases written with their type, in match, if let and let … else;
// against a type parameter, decided per instantiation.

interface Shape {
  fn area() -> float
}

struct Circle {
  radius: float
  fn area() -> float = 3.0 * radius * radius
}

struct Square {
  side: float
  fn area() -> float = side * side
}

enum Unit: Shape {
  small
  big(float)
  fn area() -> float = match self {
    .small => 1.0
    .big(n) => n
  }
}

enum Light: Shape {
  red
  green
  fn area() -> float = 0.0
}

struct Box<T> {
  value: T
  fn area() -> float = 0.5
}

struct ParseError: Error {
  line: int
}

enum MailError: Error {
  offline
  server(status: int)
}

fn describe(s: Shape) -> string = match s {
  Circle(radius: 0) => "a point"
  Circle(radius) => "a circle of {radius}"
  sq: Square => "a square of {sq.side}"
  Unit.big(n) => "a big unit of {n}"
  Unit.small => "a small unit"
  Light.green => "green"
  b: Box<int> => "a box of {b.value}"
  _ => "a shape of {s.area()}"
}

fn radius(s: Shape?) -> float {
  if let c: Circle = s {
    return c.radius
  }
  return -1
}

fn side(s: Shape) -> float {
  let sq: Square = s else { return -1 }
  return sq.side
}

fn bigs(shapes: [Shape]) -> [float] {
  var out: [float] = []
  for s in shapes {
    if let Unit.big(n) = s, n > 2 {
      out.push(n)
    }
  }
  return out
}

fn kind<T: Shape>(x: T) -> string = match x {
  c: Circle => "circle {c.radius}"
  Square(side) => "square {side}"
  Unit.small => "small"
  _ => "other {x.area()}"
}

fn circleOf<T>(x: T) -> float {
  if let c: Circle = x {
    return c.radius
  }
  return 0
}

fn errorLine(e: Error) -> string = match e {
  ParseError(line: 0) => "at the start"
  p: ParseError => "line {p.line}"
  MailError.server(status) => "server {status}"
  _ => e.message
}

fn pairs(p: (Shape, Shape)) -> string = match p {
  (c: Circle, Square(side)) => "circle {c.radius} and square {side}"
  (_, c: Circle) => "then a circle {c.radius}"
  _ => "other"
}

test "match" {
  let shapes: [Shape] = [Circle(radius: 0), Circle(radius: 2), Square(side: 3), Unit.big(5), Unit.small, Light.green, Light.red, Box(value: 7), Box(value: "x")]
  for s in shapes { print(describe(s)) }
}

test "if let and let else" {
  print(radius(Circle(radius: 4)))
  print(radius(Square(side: 1)))
  print(radius(none))
  print(side(Square(side: 6)))
  print(side(Circle(radius: 6)))
  print(bigs([Unit.big(1), Circle(radius: 1), Unit.big(3), Unit.small, Unit.big(9)]))
}

test "type parameters" {
  print(kind(Circle(radius: 1)))
  print(kind(Square(side: 2)))
  print(kind(Unit.small))
  print(kind(Unit.big(4)))
  print(kind(Light.red))
  let s: Shape = Square(side: 5)
  print(kind(s))
  print(circleOf(Circle(radius: 8)))
  print(circleOf(3))
  let maybe: Circle? = Circle(radius: 2)
  print(circleOf(maybe))
}

test "errors" {
  print(errorLine(ParseError(line: 0)))
  print(errorLine(ParseError(line: 12)))
  print(errorLine(MailError.server(status: 503)))
  print(errorLine(MailError.offline))
  do {
    throw ParseError(line: 3)
  } catch e: ParseError {
    print("caught line {e.line}")
  }
}

test "nested" {
  print(pairs((Circle(radius: 1), Square(side: 2))))
  print(pairs((Square(side: 1), Circle(radius: 3))))
  print(pairs((Square(side: 1), Square(side: 3))))
}

// Output:
// a point
// a circle of 2
// a square of 3
// a big unit of 5
// a small unit
// green
// a shape of 0
// a box of 7
// a shape of 0.5
// ok match
// 4
// -1
// -1
// 6
// -1
// [3.0, 9.0]
// ok if let and let else
// circle 1
// square 2
// small
// other 4
// other 0
// square 5
// 8
// 0
// 2
// ok type parameters
// at the start
// line 12
// server 503
// MailError.offline
// caught line 3
// ok errors
// circle 1 and square 2
// then a circle 3
// other
// ok nested
