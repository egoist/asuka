{
  "name": "asuka",
  "displayName": "Asuka",
  "description": "The Asuka language: diagnostics, completion, hover, go to definition, references, rename and formatting, from asuka lsp; and the debugger of the apps asuka dev runs.",
  "version": "0.1.0",
  "publisher": "asuka",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/egoist/asuka",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Debuggers"
  ],
  "keywords": [
    "asuka",
    "ui",
    "lsp",
    "debug"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:asuka",
    "workspaceContains:**/asuka.toml",
    "onDebugResolve:asuka",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "asuka",
        "aliases": [
          "Asuka",
          "asuka"
        ],
        "extensions": [
          ".asuka"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asuka",
        "scopeName": "source.asuka",
        "path": "./syntaxes/asuka.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "asuka"
      }
    ],
    "debuggers": [
      {
        "type": "asuka",
        "label": "Asuka",
        "languages": [
          "asuka"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "app": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "The app's directory (its asuka.toml's)."
              },
              "platform": {
                "type": "string",
                "enum": [
                  "mac",
                  "windows",
                  "linux",
                  "ios",
                  "android",
                  "ios,android"
                ],
                "description": "Where asuka dev runs the app (asuka dev --platform): this computer by default. Not the web, which has no debugger."
              },
              "device": {
                "type": "string",
                "description": "asuka dev --device: a simulator's or an iPhone's name, an adb serial or an AVD's name."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "More arguments for asuka dev, such as [\"--lang\", \"de\"]."
              },
              "port": {
                "type": "number",
                "description": "The port the debugger listens on (asuka dev --debug-port): by default a free one."
              }
            }
          },
          "attach": {
            "properties": {
              "port": {
                "type": "number",
                "default": 8791,
                "description": "The port asuka dev's debugger listens on, as asuka dev prints it: 8791 unless another asuka dev had it, or --debug-port said."
              },
              "host": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "The computer asuka dev runs on: this one."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "asuka",
            "request": "launch",
            "name": "Asuka: Run and Debug",
            "app": "${workspaceFolder}"
          },
          {
            "type": "asuka",
            "request": "attach",
            "name": "Asuka: Attach to asuka dev",
            "port": 8791
          }
        ],
        "configurationSnippets": [
          {
            "label": "Asuka: Run and Debug",
            "description": "Run the app with asuka dev and debug it",
            "body": {
              "type": "asuka",
              "request": "launch",
              "name": "Asuka: Run and Debug",
              "app": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Asuka: Run and Debug on iOS",
            "description": "Run the app on the iOS simulator and debug it",
            "body": {
              "type": "asuka",
              "request": "launch",
              "name": "Asuka: Run and Debug (iOS)",
              "app": "^\"\\${workspaceFolder}\"",
              "platform": "ios"
            }
          },
          {
            "label": "Asuka: Attach to asuka dev",
            "description": "Debug the app an asuka dev already runs",
            "body": {
              "type": "asuka",
              "request": "attach",
              "name": "Asuka: Attach to asuka dev",
              "port": 8791
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Asuka",
      "properties": {
        "asuka.server.path": {
          "type": "string",
          "default": "asuka",
          "markdownDescription": "The `asuka` command the language server runs as (`asuka lsp`): a name looked up on `PATH`, or a path (a relative one is from the workspace's first folder)."
        },
        "asuka.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "More arguments for `asuka lsp`, such as `--verbose` to log to the Asuka output channel."
        },
        "asuka.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages between VS Code and the language server, in the Asuka output channel."
        }
      }
    },
    "commands": [
      {
        "command": "asuka.restartServer",
        "title": "Restart Language Server",
        "category": "Asuka"
      },
      {
        "command": "asuka.showOutput",
        "title": "Show Language Server Output",
        "category": "Asuka"
      }
    ],
    "configurationDefaults": {
      "[asuka]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
