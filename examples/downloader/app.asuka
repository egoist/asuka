// Downloader saves videos from links: a link pasted or shared from
// another app (on share), downloaded as it comes (std/http's download)
// while the app is out of sight (platform/background, its progress and
// Cancel in a notification), on Wi-Fi only if asked (platform/network), into the
// gallery (platform/library). Its browser finds the videos a page plays,
// from a script that runs before the page's own (WebView's preload), and
// blocks ads; its icons are SVG (std/svg); platform/js runs a script off
// screen.
//
//   asuka dev --platform android --once examples/downloader

import std/fs
import std/http
import std/regex
import std/storage
import std/svg
import std/time
import platform/background
import platform/dock
import platform/js
import platform/library
import platform/network
import platform/webview

// Lucide's icons.
let iconDownload = svg.Icon(r"""<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>""")
let iconWifi = svg.Icon(r"""<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/></svg>""")
let iconGlobe = svg.Icon(r"""<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>""")

/// A short video to try with.
let sample = "https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/360/Big_Buck_Bunny_360_10s_1MB.mp4"

/// The link to download, and what happened: the app's, which the
/// browser and links shared from other apps set too.
state link = sample
state status = ""

/// Kept on the device, as the user left it.
let wifiOnly = storage.Value("wifiOnly", false)

app {
  // A link, or "A title https://...": the link in it.
  on share(items) {
    for it in items {
      if let u = linkRE.find(it.text) {
        link = u
        status = "Shared: {u}"
        break
      }
    }
  }
  Stack { Downloader() }
}

screen Downloader {
  let net = network.status()

  title: "Downloader"

  SafeArea {
    grow: 1
    padding: 16
    gap: 16
    TextField {
      bind text: link
      placeholder: "A link to a video"
      keyboard: .url
    }
    Row {
      gap: 12
      align: .center
      svg.View(iconWifi) {
        width: 22
        height: 22
        color: if net.connected && !net.metered { .green } else { .secondaryLabel }
      }
      Text(if !net.connected {
        "Offline"
      } else if net.metered {
        "{net.type}, metered"
      } else {
        "{net.type}"
      }) {
        grow: 1
        color: .secondaryLabel
      }
      Text("Wi-Fi only")
      Toggle {
        bind on: wifiOnly.value
        title: "Wi-Fi only"
      }
    }
    Button("Download") {
      variant: .filled
      on press {
        if wifiOnly.value && net.metered {
          status = "Waiting for Wi-Fi: this connection is metered"
          return
        }
        await download(link, report: s => { status = s })
      }
    }
    Row {
      gap: 12
      Button("Browse") {
        variant: .gray
        on press { push(Browser()) }
      }
      Button("Run JS") {
        variant: .gray
        on press {
          let script = r"""const xs = [1, 2, 3].map(x => x * 2); Promise.resolve(xs.join("+") + "=" + xs.reduce((a, b) => a + b))"""
          do {
            status = "JS: {try await js.eval(script)}"
          } catch e {
            status = "JS: {e.message}"
          }
        }
      }
    }
    Row {
      gap: 8
      align: .center
      svg.View(iconDownload) {
        width: 18
        height: 18
      }
      Text(status) {
        grow: 1
        color: .secondaryLabel
        font: .footnote
      }
    }
  }
}

/// Fetches url in a background task, its progress in the task's
/// notification, then saves it to the gallery's videos.
async fn download(url: string, report: fn(string)) {
  var name = url.split("?")[0].split("/").last() ?? ""
  if name.isEmpty() || name == "." { name = "video.mp4" }
  var cancelled = false
  let task = background.start(title: "Downloading {name}", progress: -1, actions: [background.Action(id: "cancel", title: "Cancel")], onAction: a => {
    if a == "cancel" { cancelled = true }
  })
  defer { task.end() }
  report("Downloading {name}")
  let file = fs.join([fs.appDir(), "downloads", name])
  do {
    try await fetch(url, file, cancelled: () => cancelled, progress: (done, total) => {
      var p = -1.0
      var text = "{(done.float() / 1e6).fixed(1)} MB"
      if total > 0 {
        p = done.float() / total.float()
        text = "{(p * 100).fixed(0)}% of {(total.float() / 1e6).fixed(1)} MB"
      }
      task.update(title: "Downloading {name}", text: text, progress: p, actions: [background.Action(id: "cancel", title: "Cancel")])
      dock.setProgress(dock.Progress(value: p, state: if p < 0 { .indeterminate } else { .normal })) // on the Dock or the taskbar, on a desktop
    })
  } catch e {
    dock.setProgress(dock.Progress())
    report("Couldn't: {e.message}")
    return
  }
  task.update(title: "Saving {name}", progress: -1, actions: [])
  dock.setProgress(dock.Progress(state: .indeterminate))
  defer {
    // Done: the progress off the app's icon, and the user, in another app
    // meanwhile, asked to come back.
    dock.setProgress(dock.Progress())
    dock.requestAttention(.informational)
  }
  do {
    let where = try await library.save(file, collection: .movies, folder: "Downloader", move: true)
    report("Saved: {where}")
  } catch e {
    report("Couldn't save: {e.message}")
  }
}

/// Downloads url into file as it comes (std/http's download), its
/// progress reported; cancelled stops it, leaving no file.
async fn fetch(url: string, file: string, cancelled: fn() -> bool, progress: fn(int, int)) throws {
  try fs.mkdirAll(fs.dir(file))
  let res = try await race(http.download(url, file, progress: progress), whenCancelled(cancelled))
  if !res.ok() {
    try? fs.remove(file)
    throw DownloadError.status(res.status)
  }
}

/// Throws DownloadError.cancelled once cancelled says so: the other side
/// of fetch's race, which cancels the download.
async fn whenCancelled(cancelled: fn() -> bool) throws -> http.Response {
  while !cancelled() { await sleep(200ms) }
  throw DownloadError.cancelled
}

enum DownloadError: Error {
  cancelled
  status(int)

  fn message() -> string = match self {
    .cancelled => "cancelled"
    .status(s) => "the server answered {s}"
  }
}

let linkRE = regex.must(r"https?://\S+")
let quotedLinkRE = regex.must("\"(https?://[^\"]+)\"")
let videoRE = regex.must(r"\.(m3u8|mpd|mp4|webm)(\?|$)")

/// Runs before each page's own scripts: it notes the media the page
/// fetches or plays, for take().
let preload = r"""
  (() => {
    const seen = new Set(), found = [];
    const add = (u) => { try { u = new URL(u, location.href).href } catch { return }
      if (/\.(m3u8|mpd|mp4|webm|m4a|mp3)(\?|$)/i.test(u) && !seen.has(u)) { seen.add(u); found.push(u) } };
    const f = window.fetch;
    window.fetch = function (input, init) { add(input instanceof Request ? input.url : String(input)); return f.apply(this, arguments) };
    const open = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function (m, u) { add(u); return open.apply(this, arguments) };
    document.addEventListener("play", (e) => { if (e.target.currentSrc) add(e.target.currentSrc) }, true);
    window.__found = { take: () => found.splice(0) };
  })()
  """

/// A web view with an address bar, finding the media its pages load
/// (from the preload's hooks, and on Android each request too).
screen Browser {
  state web = WebState()
  state media: [string] = []

  let view = Ref()

  title: "Browser"

  fn addMedia(u: string) {
    if !media.contains(u) { media.push(u) }
  }

  SafeArea {
    grow: 1
    Row {
      gap: 8
      padding: [8, 12]
      align: .center
      Button("") {
        icon: "chevron.backward"
        label: "Back"
        variant: .gray
        disabled: !web.canGoBack
        on press { view.goBack() }
      }
      svg.View(iconGlobe) {
        width: 18
        height: 18
      }
      Text(if web.loading {
        "{(web.progress * 100).fixed(0)}% · {web.url}"
      } else if !web.title.isEmpty() {
        web.title
      } else {
        web.url
      }) {
        grow: 1
        lines: 1
        font: .footnote
      }
      Button("") {
        icon: "arrow.clockwise"
        label: "Reload"
        variant: .gray
        on press { view.reload() }
      }
    }
    WebView("https://test-videos.co.uk/bigbuckbunny/mp4-h264") {
      ref: view
      preload: preload
      block: ["doubleclick.net", "googlesyndication.com", "google-analytics.com"]
      grow: 1
      on state(s) { web = s }
      on loaded(_) {
        let found = (try? await view.eval("window.__found ? window.__found.take() : []")) ?? ""
        for m in quotedLinkRE.findAllSubmatches(found) { addMedia(m[1]) }
      }
      on request(u) {
        if videoRE.matches(u) { addMedia(u) }
      }
      on download(d) { addMedia(d.url) }
    }
    Column {
      padding: 12
      gap: 8
      Text("Videos found: {media.count()}") { font: .headline }
      for u in media.suffix(3) key u {
        Button(u.split("/").last() ?? u) {
          variant: .bordered
          on press {
            link = u
            let cookies = (try? await webview.cookies(u)) ?? ""
            status = "Picked from the browser ({cookies.split("=").count() - 1} cookies)"
            pop()
          }
        }
      }
    }
  }
}

test "a shared link, and the browser" {
  expect(linkRE.find("A video https://example.com/v.mp4 to see") == "https://example.com/v.mp4")
  expect(videoRE.matches("https://cdn.example.com/a/b.m3u8?x=1") && !videoRE.matches("https://example.com/page"))
  let app = mount(Stack { Downloader() })
  app.expect("Downloader", "Download", "Wi-Fi only")
  app.tap("Browse")
  app.expect("Videos found: 0")
  app.back()
  app.expect("Download")
}
