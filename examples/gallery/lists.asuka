struct Message {
  id: int
  from: string
  subject: string
}

fn messages(from: int, n: int) -> [Message] {
  let names = ["Ada", "Grace", "Linus", "Ken", "Rob", "Barbara"]
  return (from..<from + n).map(i => Message(id: i, from: names[i % names.count()], subject: "Message {i + 1}"))
}

/// The inbox's messages, kept as other destinations are chosen, and
/// counted by its badge.
state inboxItems = messages(0, 30)

/// The inbox's List, which the bar's button scrolls.
let inboxList = Ref()

/// A List: swipe a row to archive or delete it; more load at the end; the
/// bar's button scrolls back to the top.
component Inbox {
  /// Removes a message, offering to undo it.
  fn remove(id: int, said: string) {
    if let i = inboxItems.index(m => m.id == id) {
      let gone = inboxItems.removeAt(i)
      snackbar(said, action: .button(title: "Undo", run: () => {
        inboxItems.insert(gone, at: min(i, inboxItems.count()))
      }))
    }
  }

  List {
    ref: inboxList
    on endReached {
      if inboxItems.count() < 120 { inboxItems += messages(inboxItems.count(), 30) }
    }
    for m in inboxItems key m.id {
      Row {
        padding: [12, 20]
        gap: 12
        align: .center
        swipeActions: [
          .button(title: "Delete", icon: "trash", role: .destructive, run: () => remove(m.id, "Message deleted")),
          .button(title: "Archive", icon: "archivebox", run: () => remove(m.id, "Message archived")),
        ]
        // What swiping does, for a screen reader's user.
        actions: [
          A11yAction(name: "Archive", run: () => remove(m.id, "Message archived")),
          A11yAction(name: "Delete", run: () => remove(m.id, "Message deleted")),
        ]
        Symbol("person.fill") {
          color: .secondaryLabel
          font: .title2
        }
        Column {
          grow: 1
          gap: 2
          Text(m.from) { font: .headline }
          Text(m.subject) { color: .secondaryLabel }
        }
      }
    }
  }
}

/// A row of the settings: an icon, a title, and a switch if it has one.
struct Setting {
  icon: string
  title: string
  on: bool? = none
}

/// An inset grouped List: UIKit's inset grouped list on iOS, Material 3
/// Expressive's segmented list on Android. Swipe a row to remove it.
component SettingsList {
  state items = [
    Setting(icon: "bell", title: "Notifications", on: true),
    Setting(icon: "lock", title: "Privacy"),
    Setting(icon: "location", title: "Location", on: false),
    Setting(icon: "speaker.wave.2", title: "Sounds"),
    Setting(icon: "eye", title: "Display"),
    Setting(icon: "info.circle", title: "About"),
  ]

  List {
    appearance: .insetGrouped
    for (i, s) in items.enumerated() key s.title {
      Row {
        padding: [10, 16]
        minHeight: 52
        gap: 16
        align: .center
        swipeActions: [.button(title: "Remove", role: .destructive, run: () => items.removeWhere(x => x.title == s.title))]
        Symbol(s.icon) { color: .accent }
        Text(s.title) { grow: 1 }
        if let on = s.on {
          Toggle {
            on: on
            title: s.title
            on change(v) { items[i].on = v }
          }
        } else {
          Symbol("chevron.forward") { color: .tertiaryLabel }
        }
      }
    }
  }
}

/// A grid of photos over the network: a List with columns, each cell
/// square, the images kept on disk once fetched.
component Photos {
  List {
    columns: 3
    gap: 2
    for id in 10..<100 key id {
      // Each photo has a key its screen shares: it zooms out of it.
      View {
        label: "Photo"
        aspectRatio: 1
        shared: "photo-{id}"
        on press { push(Photo(id)) }
        Image("https://picsum.photos/id/{id}/300/300") {
          placeholder: "placeholder.png"
          mode: .fill
          grow: 1
        }
      }
    }
  }
}

/// One photo, large: its screen zooms out of the grid's.
screen Photo(id: int) {
  title: "Photo"
  zoomFrom: "photo-{id}"

  Column {
    grow: 1
    background: #000000
    justify: .center
    Image("https://picsum.photos/id/{id}/1200/1200") {
      placeholder: "placeholder.png"
      mode: .fit
      aspectRatio: 1
    }
  }
}

/// Asks before going back with unsaved text.
screen Editor {
  state text = ""
  state saved = ""
  state discarding = false
  state focused = false

  title: "Editor"
  onBack {
    if text == saved { return false }
    discarding = true
    return true
  }

  Alert("Discard your changes?") {
    bind open: discarding
    Button("Keep editing") { role: .cancel }
    Button("Discard") {
      role: .destructive
      on press {
        saved = text
        pop()
      }
    }
  }

  SafeArea {
    padding: 20
    gap: 12
    TextField {
      bind text: text
      bind focused: focused
      placeholder: "Type, then go back"
      multiline: true
      // A bar on the keyboard: a count, and Done.
      accessory {
        Row {
          padding: [6, 16]
          align: .center
          material: .bar
          Text("{text.count()} characters") {
            grow: 1
            style: caption
          }
          Button("Done") {
            on press { focused = false }
          }
        }
      }
    }
    Button("Save") {
      variant: .filled
      on press { saved = text }
    }
  }
}

/// The web page's, which the bar's button runs script in.
let webView = Ref()

/// The web page's markup: its button posts a message to Asuka
/// (window.asuka.postMessage).
let webMarkup = """
  <!doctype html><meta name="viewport" content="width=device-width, initial-scale=1">
  <style>:root \{ color-scheme: light dark; font: -apple-system-body; font-family: system-ui; } body \{ padding: 20px; }
  button \{ font: inherit; padding: 10px 16px; border-radius: 10px; border: 0; background: #0a84ff; color: white; }</style>
  <h2>A web page</h2>
  <p>Its button talks to Asuka; the bar's button runs script here.</p>
  <button onclick="asuka.postMessage('Hello from the page')">Post a message</button>
  <p id="out"></p>
  """

/// A web page from markup; the bar's buttons run script in it and print
/// it.
component WebPage {
  SafeArea {
    grow: 1
    WebView {
      ref: webView
      html: webMarkup
      grow: 1
      on message(m) { alert("The page says", message: m) }
    }
  }
}

test "the inbox loads more, and a removed message comes back with Undo" {
  let app = mount(Inbox())
  app.expect("Message 1")
  app.swipe("Message 1", action: "Delete")
  app.expectNo("Message 1")
  app.tap("Undo")
  app.expect("Message 1")
}
