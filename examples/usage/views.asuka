// Claude's colors: its terracotta mark on its cream, as its app's icon,
// the same in light and dark.
let claude = #d97757
let claudeCream = #f4f3ee

/// A service's mark: on iOS on a rounded square, as an app's icon; on
/// Android on Material 3's scalloped "cookie".
component Badge(service: string, size: float) {
  View {
    a11yHidden: true
    width: size
    height: size
    align: .center
    justify: .center
    Shape((w, h) => if ios { Path().roundedRect(0, 0, w, h, radius: size * 0.225) } else { cookie(w, h) }) {
      fill: claudeCream
      style: fill
    }
    svg.View(iconClaude) {
      color: claude
      width: size * 0.56
      height: size * 0.56
    }
  }
}

/// A view's whole box, for views stacked over each other.
style fill {
  absolute: true
  left: 0
  top: 0
  width: 100%
  height: 100%
}

/// A disc with nine soft scallops.
fn cookie(w: float, h: float) -> Path {
  var p = Path()
  let r = min(w, h) / 2
  for i in 0..180 {
    let a = 2 * math.pi * i.float() / 180
    let d = r * (0.93 + 0.07 * math.cos(9 * a))
    let x = r + d * math.cos(a)
    let y = r + d * math.sin(a)
    p = if i == 0 { p.move(x, y) } else { p.line(x, y) }
  }
  return p.close()
}

/// A forecast's color: semantic, so it follows dark mode.
fn paceColor(p: Pace) -> Color = match p {
  .ok => .green
  .tight => .orange
  .over | .usedUp => .red
  .unknown => .secondaryLabel
}

fn paceIcon(p: Pace) -> svg.Icon = match p {
  .ok => iconCheck
  .tight => iconTrendUp
  .over | .usedUp => iconAlert
  .unknown => iconHourglass
}

/// A quota's bar, as Material 3's progress indicator draws one: what's
/// left (or, showing use, what's used) filled; the part the forecast says
/// will go before the reset in the forecast's color; the rest the track;
/// a stop dot at its end. The parts are apart by a gap.
component Meter(w: Window) {
  let pace = w.forecast(clock).pace
  let used = min(w.used, 100)
  let next = if pace == .unknown { used } else { min(w.forecast(clock).atReset, 100) }
  let filled = if showUsed.value { used } else { 100 - next }
  let burn = next - used
  let track = if showUsed.value { 100 - next } else { used }

  if ios {
    // A capsule, as UIProgressView: what's filled over the forecast's part
    // over the track.
    View {
      label: "Meter"
      height: 6
      radius: 3
      clip: true
      background: Color.gray.opacity(0.2)
      View {
        absolute: true
        left: 0
        top: 0
        height: 100%
        width: (filled + burn) * 1%
        radius: 3
        background: paceColor(pace).opacity(0.4)
      }
      View {
        absolute: true
        left: 0
        top: 0
        height: 100%
        width: filled * 1%
        radius: 3
        background: .accent
      }
    }
  } else {
    Row {
      label: "Meter"
      gap: 4
      height: 4
      MeterPart(filled, Color.accent)
      MeterPart(burn, paceColor(pace).opacity(0.45))
      MeterPart(track, Color.accent.opacity(0.2))
      View {
        absolute: true
        right: 0
        top: 0
        width: 4
        height: 4
        radius: 2
        background: .accent
      }
    }
  }
}

component MeterPart(size: float, color: Color) {
  if size >= 0.5 {
    View {
      grow: size
      basis: 0
      height: 4
      radius: 2
      background: color
    }
  }
}

let pad = 8.0

/// Where a time and a percent used are drawn on a window's chart.
fn at(w: Window, t: time.Time, used: float, width: float, height: float) -> (float, float) {
  let start = (w.resets ?? t) - w.period()
  let x = (t - start).seconds() / w.period().seconds()
  return (pad + min(max(x, 0), 1) * (width - 2 * pad), height - pad - min(used, 100) / 100 * (height - 2 * pad))
}

/// The use so far: the window's start, its samples, now.
fn points(w: Window, now: time.Time, width: float, height: float) -> [(float, float)] {
  let start = (w.resets ?? now) - w.period()
  return [at(w, start, 0, width, height)] + w.history.map(s => at(w, s.at, s.used, width, height)) + [at(w, now, w.used, width, height)]
}

/// Where the forecast ends.
fn forecastEnd(w: Window, now: time.Time, width: float, height: float) -> (float, float) {
  let f = w.forecast(now)
  return match f.pace {
    .over => at(w, f.out!, 100, width, height)
    .usedUp => at(w, now, 100, width, height) // nothing more to forecast
    _ => at(w, w.resets ?? now, f.atReset, width, height)
  }
}

fn polyline(pts: [(float, float)]) -> Path {
  var p = Path()
  for (i, (x, y)) in pts.enumerated() {
    p = if i == 0 { p.move(x, y) } else { p.line(x, y) }
  }
  return p
}

fn dot(at: (float, float), r: float) -> Path {
  let (x, y) = at
  return Path().ellipse(x - r, y - r, 2 * r, 2 * r)
}

/// A window's use from its start to now, a line, and the forecast's from
/// now to its reset (or to when it runs out), dashed.
component UsageChart(w: Window) {
  state size = Frame()

  let pace = w.forecast(clock).pace
  let label = (t: time.Time) => if w.period() < 24h { t.format("HH:mm") } else { t.format("MMM d") }
  let start = (w.resets ?? clock) - w.period()
  let now = points(w, clock, max(size.width, 1), max(size.height, 1)).last()!

  Column {
    gap: 8
    View {
      label: "Use so far, and the forecast to the reset"
      height: 150
      on layout(f) { size = f }
      // The limit, and nothing used.
      Shape((width, _) => Path().move(pad, pad).line(width - pad, pad)) {
        style: fill
        stroke: Color.secondaryLabel.opacity(0.5)
        dash: [2, 4]
      }
      Shape((width, height) => Path().move(pad, height - pad).line(width - pad, height - pad)) {
        style: fill
        stroke: .separator
      }
      Shape((width, height) => {
        let pts = points(w, clock, width, height)
        let (lastX, _) = pts.last()!
        let (firstX, _) = pts[0]
        return polyline(pts).line(lastX, height - pad).line(firstX, height - pad).close()
      }) {
        style: fill
        fill: Color.accent.opacity(0.15)
      }
      Shape((width, height) => polyline(points(w, clock, width, height))) {
        style: fill
        stroke: .accent
        lineWidth: 3
        lineCap: .round
        lineJoin: .round
      }
      // The forecast, in its pace's color.
      if pace != .unknown {
        Shape((width, height) => {
          let (x0, y0) = points(w, clock, width, height).last()!
          let (x1, y1) = forecastEnd(w, clock, width, height)
          return Path().move(x0, y0).line(x1, y1)
        }) {
          style: fill
          stroke: paceColor(pace)
          lineWidth: 3
          lineCap: .round
          dash: [7, 7]
        }
        Shape((width, height) => dot(forecastEnd(w, clock, width, height), 5)) {
          style: fill
          fill: paceColor(pace)
        }
      }
      Shape((width, height) => dot(points(w, clock, width, height).last()!, 8)) {
        style: fill
        fill: .accent
        stroke: .secondaryGroupedBackground
        lineWidth: 3
      }
      // Centered over the dot, inside the chart.
      Text("Now") {
        absolute: true
        left: min(max(xOf(now) - 30, 0), size.width - 60)
        top: max(yOf(now) - 36, 0)
        width: 60
        textAlign: .center
        font: .footnote
        color: .secondaryLabel
      }
    }
    Row {
      justify: .spaceBetween
      Text(label(start)) {
        font: .footnote
        color: .secondaryLabel
      }
      Text(label(w.resets ?? clock)) {
        font: .footnote
        color: .secondaryLabel
      }
    }
  }
}

/// A percent used, as the setting shows it: left or used.
fn quota(used: float) -> string = if showUsed.value { "{used.fixed(0)}% used" } else { "{max(100 - used, 0).fixed(0)}% left" }

/// What a forecast says, for its pace.
fn outlook(f: Forecast, now: time.Time) -> string = match f.pace {
  .usedUp => "Used up"
  .over => "Runs out {when(f.out!, now)}"
  _ if showUsed.value => "~{min(f.atReset, 100).fixed(0)}% used at reset"
  _ => "~{max(100 - f.atReset, 0).fixed(0)}% left at reset"
}

/// A time to come: its hour today, else its day too.
fn when(t: time.Time, now: time.Time) -> string {
  if t.sameDay(now) { return t.format("HH:mm") }
  if t.sameDay(now + 24h) { return "tomorrow {t.format("HH:mm")}" }
  return t.format("MMM d, HH:mm")
}

/// How long ago t was.
fn ago(t: time.Time, now: time.Time) -> string {
  let d = now - t
  if d < 1min { return "just now" }
  if d < 1h { return "{(d / 1min).int()} min ago" }
  if d < 24h { return plural((d / 1h).int(), "hour") }
  return plural((d / 24h).int(), "day")
}

fn plural(n: int, unit: string) -> string = if n == 1 { "1 {unit} ago" } else { "{n} {unit}s ago" }

fn xOf(p: (float, float)) -> float {
  let (x, _) = p
  return x
}

fn yOf(p: (float, float)) -> float {
  let (_, y) = p
  return y
}
