// Package std/http makes HTTP requests through each platform's own
// client: URLSession on iOS and macOS, HttpURLConnection on Android,
// fetch on the web, WinHTTP on Windows and libsoup on Linux. So proxies,
// certificates the user trusts, and the system's caches and cookies
// work as they do for the platform's own apps.
//
//   let r = try await http.get("https://example.com/inbox.json")
//   let inbox = try r.json<[Message]>()
//
// A large answer goes into a file as it comes, its progress reported:
//
//   try await http.download(url, path, progress: (got, total) => { done = got })
//
// And a large body goes from a file (or a form with files, or a Stream's
// pieces) as it's read, its progress reported too:
//
//   let form = try http.multipart([.field("title", "Holiday"), .file("video", path, type: "video/mp4")])
//   try await http.upload("https://example.com/videos", form, progress: (sent, total) => { done = sent })
//
// A body that comes over time (a reply a language model writes, a log)
// is read as it's sent, in pieces, lines, or server-sent events:
//
//   let r = try await http.stream(url, method: "POST", body: prompt)
//   for await line in r.lines() { reply = reply + line }
//
//   for await e in http.events("https://example.com/updates") {
//     if e.event == "price" { price = e.data }
//   }
//
// A server whose certificate a private authority signed, or one that
// asks for the client's (mutual TLS), is reached with tls:
//
//   let tls = http.TLS(ca: try fs.readText("ca.pem"))
//   let r = try await http.get("https://api.internal/health", tls: tls)
//
// And it serves HTTP/1.1, the same C on every system that can listen (a
// program, a desktop app, a phone's app; not the web), each request's
// handler a task on the main thread:
//
//   let api = http.Router()
//     .get("/notes/:id", req => .json(try await notes.find(req.param("id"))))
//     .post("/notes", req => .json(try await notes.add(try req.json<Note>()), status: 201))
//   let server = try await http.serve(8080, api.handler())
//   await server.wait()

import std/fs
import std/json as codec
import std/random

/// What a request answered.
pub struct Response {
  /// The status code: 200, 404...
  status: int
  /// The URL it answered from, after redirects.
  url: string
  /// The headers, by lower-case name.
  headers: [string: string]
  body: bytes

  /// The body as UTF-8 text.
  fn text() -> string = body.string()

  /// The body as JSON, decoded into T.
  fn json<T>() throws -> T = try codec.decode<T>(text())

  /// Whether the status is a success (200 to 299).
  fn ok() -> bool = status >= 200 && status < 300
}

/// The platform's HTTP client.
native interface Transport {
  /// Sends a request and waits for its answer: a network failure throws,
  /// an answer of any status returns.
  async fn send(method: string, url: string, headers: [string: string], body: bytes, timeout: Duration) -> Response
  /// Sends a request and writes its answer's body into the file at path
  /// as it comes (a file beside it, renamed to path once it's all in),
  /// calling progress with the bytes written and the whole's (-1 when
  /// the answer doesn't say). timeout is the longest wait for more. Its
  /// Response's body is empty. Where the platform can't write the app's
  /// files from its client, it answers with the body for the caller to
  /// write.
  async fn download(method: string, url: string, headers: [string: string], body: bytes, timeout: Duration, path: string, progress: fn(int, int)) -> Response
  /// Sends a request and answers as soon as its response's head (status,
  /// URL, headers) is in, with its body to read as it comes. timeout is
  /// the longest wait for the head, and for each piece after it. A
  /// network failure throws; an answer of any status returns.
  async fn open(method: string, url: string, headers: [string: string], body: bytes, timeout: Duration) -> Body
  /// Sends a request whose body is parts, in order (length bytes in all,
  /// -1 when it isn't known), each file read from disk as it's sent,
  /// calling progress with the bytes sent and length, a few times a
  /// second and once all is sent. timeout is the longest wait for the
  /// network to take more, then for the answer. With background, the
  /// system's transfer that goes on while the app is out of sight (iOS
  /// and macOS: a background URLSession; Android: WorkManager), id its
  /// name in finished; where there's none, as without it.
  async fn upload(method: string, url: string, headers: [string: string], parts: [Part], length: int, timeout: Duration, progress: fn(int, int), background: bool, id: string) -> Response
  /// Starts a request whose body is written as it's made (Sender.write):
  /// length bytes (-1 when it isn't known: sent chunked), progress as
  /// upload's.
  async fn begin(method: string, url: string, headers: [string: string], length: int, timeout: Duration, progress: fn(int, int)) -> Sender
  /// The background uploads that ended while no call waited for them,
  /// each given once.
  async fn finished() -> [FinishedUpload]
  /// The client whose connections are made as tls says (one tls has its
  /// fields' defaults changed): the same settings, the same client, its
  /// connections reused, kept apart from the others'. It throws for what
  /// it can't read, and where the platform can't (a browser).
  async fn secured(tls: TLS) -> Transport
}

/// A response's body, read as it comes. Let go (or closed), it stops the
/// request.
native interface Body {
  /// The response's head: its status, URL (after redirects) and headers
  /// by lower-case name; its body empty.
  fn head() -> Response
  /// The next piece of the body, as soon as some is in (whatever the
  /// network delivered, never empty): empty at the body's end. A network
  /// failure, or no piece within the timeout, throws.
  async fn read() -> bytes
  /// Stops the request.
  fn close()
}

// Made once; none where the platform has no client (making one again
// says why).
let transport = try? Transport()

/// How a client's HTTPS connections (and std/websocket's wss: ones) are
/// made: whom they trust, and the certificate they show. By default (no
/// tls) the system's client decides, as for the platform's own apps.
///
/// ca (PEM certificates) is trusted instead of the authorities the
/// system trusts: a private authority's, a self-signed server's, a test
/// server's. With trustSystem, the system's authorities are trusted too,
/// ca's added to them. The server's name is checked either way.
/// certificate and key (PEM) are the client's own, for a server that
/// asks for one (mutual TLS): the certificate, then the authorities'
/// that signed it, up to (not with) the root; its key PKCS#8's PRIVATE
/// KEY, RSA PRIVATE KEY or EC PRIVATE KEY, not encrypted.
/// insecureSkipVerify checks no certificate at all: anyone can pretend
/// to be the server and read what's sent, so it's for a test against a
/// server of your own, never for a release.
///
///   let tls = http.TLS(ca: try fs.readText("ca.pem"), certificate: try fs.readText("client.pem"), key: try fs.readText("client.key"))
///   let r = try await http.get("https://api.internal/orders", tls: tls)
///
/// A web page can't: its browser decides whom it trusts and which
/// certificate it shows, so a request with tls throws there.
pub struct TLS {
  /// PEM certificates of the authorities (or servers) to trust.
  ca: string = ""
  /// Whether the authorities the system trusts still are, ca's added to
  /// them; by default ca's alone are.
  trustSystem: bool = false
  /// The client's certificate chain, PEM, for mutual TLS.
  certificate: string = ""
  /// The certificate's private key, PEM, not encrypted.
  key: string = ""
  /// Checks no certificate: for local tests only.
  insecureSkipVerify: bool = false
}

// tlsGiven is whether t changes anything: its defaults are the system's.
fn tlsGiven(t: TLS) -> bool = !t.ca.isEmpty() || !t.certificate.isEmpty() || !t.key.isEmpty() || t.insecureSkipVerify

/// What's wrong with tls's PEM, before the platform reads it: none when
/// it looks right. std/websocket checks with it too.
pub fn tlsProblem(tls: TLS) -> string? {
  let cert = "-----BEGIN CERTIFICATE-----"
  if !tls.ca.isEmpty() && !tls.ca.contains(cert) {
    return "ca has no PEM certificate (\"{cert}\")"
  }
  if !tls.certificate.isEmpty() && !tls.certificate.contains(cert) {
    return "certificate has no PEM certificate (\"{cert}\")"
  }
  if !tls.certificate.isEmpty() && tls.key.isEmpty() {
    return "a client certificate needs its key (key:)"
  }
  if !tls.key.isEmpty() && tls.certificate.isEmpty() {
    return "a key needs its certificate (certificate:)"
  }
  if tls.key.contains("ENCRYPTED") {
    return "the key is encrypted: give it decrypted (PKCS#8, RSA or EC, PEM)"
  }
  if !tls.key.isEmpty() && !tls.key.contains("PRIVATE KEY-----") {
    return "key has no PEM private key (PRIVATE KEY, RSA PRIVATE KEY or EC PRIVATE KEY)"
  }
  return none
}

// client is the transport for tls: the system's for none (or the
// defaults), else the one secured as it says.
async fn client(tls: TLS?) throws -> Transport {
  if let c = tls {
    if tlsGiven(c) {
      if let p = tlsProblem(c) {
        throw HTTPError.tls(reason: p)
      }
      return try await (transport ?? try Transport()).secured(c)
    }
  }
  return transport ?? try Transport()
}

/// Sends a request: method (GET, POST...), url, headers, body, and how
/// long to wait for the answer; tls, for a server the system doesn't
/// trust or one that asks for a certificate (TLS).
pub async fn request(method: string, url: string, headers: [string: string] = [:], body: bytes = bytes(), timeout: Duration = 60s, tls: TLS? = none) throws -> Response {
  return try await (try await client(tls)).send(method, url, headers, body, timeout)
}

/// Sends a GET request to url, waiting up to 60 s for the answer: a
/// network failure throws, an answer of any status returns (check ok()).
pub async fn get(url: string, headers: [string: string] = [:], tls: TLS? = none) throws -> Response {
  return try await request("GET", url, headers: headers, tls: tls)
}

/// Sends a POST request with body to url, waiting up to 60 s, as get
/// does. Say what body is with a content-type header.
pub async fn post(url: string, body: bytes, headers: [string: string] = [:], tls: TLS? = none) throws -> Response {
  return try await request("POST", url, headers: headers, body: body, tls: tls)
}

/// Posts value as JSON.
pub async fn postJSON<T>(url: string, value: T, headers: [string: string] = [:], tls: TLS? = none) throws -> Response {
  var h = headers
  h["content-type"] = "application/json"
  return try await request("POST", url, headers: h, body: codec.encode(value).bytes(), tls: tls)
}

/// Downloads url into the file at path as the answer comes, made (or
/// replaced) once it's all in: a video, an archive, what's too large to
/// hold. progress, if given, is called as it goes with the bytes written
/// and the whole's (-1 when the server doesn't say), at most a few times
/// a second. timeout is the longest wait for more bytes, not for the
/// whole. It answers with the Response, its body empty; a status that
/// isn't a success is the caller's to check (the file then holds what
/// the server said). Cancelling the task stops it, leaving no file. tls
/// is request's.
pub async fn download(url: string, path: string, headers: [string: string] = [:], method: string = "GET", body: bytes = bytes(), timeout: Duration = 60s, progress: (fn(int, int))? = none, tls: TLS? = none) throws -> Response {
  let report = (got: int, total: int) => {
    if let p = progress { p(got, total) }
  }
  let t = try await client(tls)
  var r = try await t.download(method, url, headers, body, timeout, path, report)
  if !r.body.isEmpty() {
    // The web's client hands the body over: the app's files are the
    // core's.
    try fs.write(path, r.body)
    report(r.body.count(), r.body.count())
    r.body = bytes()
  }
  return r
}

// ---- Bodies sent as they're read: files, streams, forms ----

/// A piece of a request's body: bytes, or the file at path, read from
/// disk as it's sent.
struct Part {
  data: bytes = bytes()
  path: string = ""
}

/// A request's body that's sent as it's read, never held whole: a file's
/// bytes from disk (Upload.file), the pieces a Stream makes
/// (Upload.stream), a form's fields and files (multipart), or bytes in
/// memory, for their progress (Upload.data). upload sends it.
pub struct Upload {
  private parts: [Part] = []
  private pieces: Stream<bytes>? = none
  /// Its length in bytes, sent as Content-Length: -1 when it isn't known
  /// (a Stream's, unless it was said), the body then sent chunked.
  length: int = -1
  /// Its Content-Type, sent unless the headers say one.
  type: string = "application/octet-stream"

  /// The file at path, read from disk as it's sent (a video, a backup):
  /// its length is the file's. It throws when there's no file there.
  static fn file(path: string, type: string = "application/octet-stream") throws -> Upload = Upload(parts: [Part(path: path)], length: (try fs.stat(path)).size, type: type)

  /// The pieces stream makes, each sent as it comes, the network taking
  /// one before the next is asked for: a recording as it's made, a file
  /// compressed as it's read. length is the whole's in bytes, -1 when it
  /// isn't known (sent chunked).
  static fn stream(pieces: Stream<bytes>, length: int = -1, type: string = "application/octet-stream") -> Upload = Upload(pieces: pieces, length: length, type: type)

  /// Bytes already in memory, sent with upload's progress.
  static fn data(data: bytes, type: string = "application/octet-stream") -> Upload = Upload(parts: [Part(data: data)], length: data.count(), type: type)
}

/// A part of a multipart form (multipart): a field's text, or a file's
/// bytes with its file name and type, read from disk as they're sent or
/// held in memory.
pub struct FormPart {
  /// The form's name for it.
  name: string
  private value: bytes = bytes()
  private path: string = ""
  private file: bool = false
  private filename: string = ""
  private type: string = ""

  /// A field: its name and text.
  static fn field(name: string, value: string) -> FormPart = FormPart(name: name, value: value.bytes())

  /// The file at path, read from disk as it's sent: filename is the name
  /// the server's told (path's last one by default), type its
  /// Content-Type.
  static fn file(name: string, path: string, filename: string = "", type: string = "application/octet-stream") -> FormPart = FormPart(name: name, path: path, file: true, filename: if filename.isEmpty() { fs.base(path) } else { filename }, type: type)

  /// A file's bytes, in memory: a photo just taken, a text made.
  static fn data(name: string, data: bytes, filename: string, type: string = "application/octet-stream") -> FormPart = FormPart(name: name, value: data, file: true, filename: filename, type: type)
}

/// A multipart/form-data body (RFC 7578), as a browser sends a form:
/// parts in order, fields' text and files' bytes, each file read from
/// disk as it's sent. Its length is known (the files' sizes and the
/// parts' heads), so its progress has a total. boundary is the line
/// between parts, a random one by default. It throws when a file isn't
/// there.
///
///   let form = try http.multipart([.field("title", "Holiday"), .file("video", path, type: "video/mp4")])
///   let r = try await http.upload("https://example.com/videos", form, progress: (sent, total) => { done = sent })
pub fn multipart(parts: [FormPart], boundary: string = "") throws -> Upload {
  let b = if boundary.isEmpty() { randomBoundary() } else { boundary }
  var out: [Part] = []
  var pending = bytes()
  var length = 0
  for p in parts {
    var head = "--{b}\r\nContent-Disposition: form-data; name=\"{formEscape(p.name)}\""
    if p.file {
      head = head + "; filename=\"{formEscape(p.filename)}\"\r\nContent-Type: {p.type}"
    }
    pending = pending.concat("{head}\r\n\r\n".bytes())
    if p.path.isEmpty() {
      pending = pending.concat(p.value)
    } else {
      length = length + pending.count() + (try fs.stat(p.path)).size
      out.push(Part(data: pending))
      out.push(Part(path: p.path))
      pending = bytes()
    }
    pending = pending.concat("\r\n".bytes())
  }
  pending = pending.concat("--{b}--\r\n".bytes())
  length = length + pending.count()
  out.push(Part(data: pending))
  return Upload(parts: out, length: length, type: "multipart/form-data; boundary={b}")
}

// formEscape is a form's name or file name as a browser writes it in a
// part's head: its quotes and line breaks percent-encoded.
fn formEscape(s: string) -> string = s.replace("\"", "%22").replace("\r", "%0D").replace("\n", "%0A")

// randomBoundary is a line between a form's parts no file is likely to
// hold: 24 random letters and digits after "asuka-".
fn randomBoundary() -> string {
  let alphabet = "0123456789abcdefghijklmnopqrstuvwxyz".chars()
  var b = "----asuka-"
  for _ in 0..<24 {
    b = b + alphabet[random.int(0, 35)]
  }
  return b
}

/// What a request's body is written to as it's made (a Stream's
/// pieces): the request goes as it's written.
native interface Sender {
  /// Sends the next piece of the body, waiting while the network hasn't
  /// taken what came before (it holds little): false when the request
  /// has ended, the server having answered (or the network failed), and
  /// finish says how.
  async fn write(piece: bytes) -> bool
  /// Ends the body and waits for the answer: a network failure throws,
  /// an answer of any status returns.
  async fn finish() -> Response
  /// Stops the request.
  fn close()
}

/// What makes an upload a background one (upload's background): its id,
/// which names it in finishedUploads.
pub struct Background {
  /// The upload's name, in finishedUploads: "" for none.
  id: string = ""
}

/// A background upload that ended while no call waited for it (the
/// system ended the app, then started it again to finish): its id
/// (its Background's), and what the server answered or what went wrong.
pub struct FinishedUpload {
  /// The id its Background was given.
  id: string
  /// The answer's status: 200, 404...; 0 when it failed.
  status: int = 0
  /// The URL it answered from, after redirects.
  url: string = ""
  /// The answer's headers, by lower-case name (its body isn't kept).
  headers: [string: string] = [:]
  /// What went wrong: "" when the server answered.
  error: string = ""
}

/// Sends body to url as it's read (a file from disk, a Stream's pieces,
/// a form with files: Upload), never holding it whole, and waits for the
/// answer: a video, a backup, photos in a form. progress, if given, is
/// called as it goes with the bytes sent and the whole's (-1 when it
/// isn't known), at most a few times a second, and once all is sent.
/// timeout is the longest wait for the network to take more, and then
/// for the answer. A network failure throws; an answer of any status
/// returns (check ok()). Cancelling the task stops it. The body's type
/// is its Content-Type unless headers say one. tls is request's.
///
///   let r = try await http.upload("https://example.com/videos", try .file(path, type: "video/mp4"), progress: (sent, total) => { done = sent })
///
/// With background, a large upload goes on while the app is out of
/// sight: on iOS and macOS a background URLSession sends it, which goes
/// on while the app is suspended, and after the system ends it (it
/// starts the app again in the background as it ends); on Android
/// WorkManager does, its progress in a notification, again after the
/// system ends the app (an app that uses Background has Android's
/// permissions for that foreground work). One that ends while no call
/// waits for it is in finishedUploads, by its id. A Stream's pieces are
/// written into a file first (the system sends files only). Elsewhere
/// (a desktop, the web) an upload goes on while the app is out of sight
/// anyway: background changes nothing there.
///
///   try await http.upload(url, form, background: http.Background(id: "holiday"))
pub async fn upload(url: string, body: Upload, method: string = "POST", headers: [string: string] = [:], timeout: Duration = 60s, progress: (fn(int, int))? = none, background: Background? = none, tls: TLS? = none) throws -> Response {
  var h = headers
  if !has(h, "content-type") {
    h["content-type"] = body.type
  }
  let report = (sent: int, total: int) => {
    if let p = progress { p(sent, total) }
  }
  let t = try await client(tls)
  let id = if let b = background { b.id } else { "" }
  if let pieces = body.pieces {
    if background.isNone() {
      return try await sendPieces(t, method, url, h, pieces, body.length, timeout, report)
    }
    // The system's background transfers send files: the pieces go into
    // one first, which goes once it's sent.
    let file = fs.join([fs.tempDir(), "asuka-upload-{randomBoundary().trimPrefix("----")}"])
    defer { try? fs.remove(file) }
    let f = try await fs.open(file, mode: .write)
    do {
      for await piece in pieces {
        try await f.write(piece)
      }
    } catch e {
      try? await f.close()
      throw e
    }
    try await f.close()
    let size = (try fs.stat(file)).size
    return try await t.upload(method, url, h, [Part(path: file)], size, timeout, report, true, id)
  }
  return try await t.upload(method, url, h, body.parts, body.length, timeout, report, !background.isNone(), id)
}

// sendPieces sends a request whose body is pieces, each written as it
// comes (Sender), and gives its answer; the server answering before
// they're all sent stops them. A length said is checked.
async fn sendPieces(t: Transport, method: string, url: string, headers: [string: string], pieces: Stream<bytes>, length: int, timeout: Duration, report: fn(int, int)) throws -> Response {
  let s = try await t.begin(method, url, headers, length, timeout, report)
  defer { try? s.close() }
  var sent = 0
  var answered = false
  for await piece in pieces {
    if piece.isEmpty() {
      continue
    }
    sent = sent + piece.count()
    if length >= 0 && sent > length {
      throw Error("upload: the stream made more than its length, {length} bytes")
    }
    if !(try await s.write(piece)) {
      answered = true
      break
    }
  }
  if !answered && length >= 0 && sent < length {
    throw Error("upload: the stream made {sent} bytes, not its length, {length}")
  }
  return try await s.finish()
}

/// The background uploads (upload's Background) that ended while no
/// call waited for them, since the last time it was asked: each is
/// given once. Ask as the app starts. None where there are no
/// background uploads (a desktop, the web).
pub async fn finishedUploads() throws -> [FinishedUpload] = try await (transport ?? try Transport()).finished()

// ---- Bodies as they come: streams, lines, server-sent events ----

/// What a request answered, its body to read as it's sent.
pub struct StreamedResponse {
  /// The status code: 200, 404...
  status: int
  /// The URL it answered from, after redirects.
  url: string
  /// The headers, by lower-case name.
  headers: [string: string]
  /// The body's pieces as the network delivers them, read once: for
  /// await piece in r.body { … }. It ends with the body; leaving its
  /// loop (or the task going) stops the request.
  body: Stream<bytes>

  /// Whether the status is a success (200 to 299).
  fn ok() -> bool = status >= 200 && status < 300

  /// The body as lines of UTF-8 text, as each one is in: split at \n,
  /// \r\n or \r, without them. A last line without one comes at the end.
  fn lines() -> Stream<string> = linesOf(body)

  /// The body as server-sent events (text/event-stream, as a browser's
  /// EventSource reads it), as each one is in.
  fn events() -> Stream<Event> = eventsOf(linesOf(body))

  /// The whole body, read to its end.
  async fn readAll() throws -> bytes {
    var all = bytes()
    for await b in body {
      all = all.concat(b)
    }
    return all
  }

  /// The whole body as UTF-8 text, read to its end.
  async fn text() throws -> string = (try await readAll()).string()
}

/// A server-sent event (the HTML standard's text/event-stream).
pub struct Event {
  /// Its type: what the server said in event:, else "message".
  event: string = "message"
  /// Its data: the data: lines, joined by \n.
  data: string
  /// The last ID the server gave (id:, in this event or one before), ""
  /// for none: what a reconnection sends back as Last-Event-ID.
  id: string = ""
  /// How long the server asked a client to wait before reconnecting
  /// (retry:, in this event or one before), 0 for what it hasn't said.
  retry: Duration = 0s
}

/// What a request can say went wrong (besides the network's failures).
pub enum HTTPError: Error {
  /// The server answered with a status that isn't a success (events').
  status(code: int)
  /// A request's tls can't be used: what's wrong with it.
  tls(reason: string)

  /// The error's text.
  fn message() -> string {
    match self {
      .status(code) => return "the server answered with status {code}"
      .tls(reason) => return "tls: {reason}"
    }
  }
}

/// Sends a request and answers as soon as the response's head is in,
/// its body to read as it's sent (r.body, r.lines(), r.events()):
/// a reply a language model writes, a log, a feed. timeout is the
/// longest wait for the head, and then for each piece. A network failure
/// throws; an answer of any status returns (check ok()). Cancelling the
/// task, or leaving the body's loop, stops it. On iOS and macOS the head
/// comes with the body's first bytes (URLSession gives it no sooner): a
/// server that answers and then waits is waited for. tls is request's.
pub async fn stream(url: string, method: string = "GET", headers: [string: string] = [:], body: bytes = bytes(), timeout: Duration = 60s, tls: TLS? = none) throws -> StreamedResponse {
  let t = try await client(tls)
  let b = try await t.open(method, url, headers, body, timeout)
  let head = try b.head()
  let pieces = Stream<bytes>(send => {
    defer { try? b.close() }
    while true {
      let piece = try await b.read()
      if piece.isEmpty() {
        return
      }
      send(piece)
    }
  })
  return StreamedResponse(status: head.status, url: head.url, headers: head.headers, body: pieces)
}

/// The server-sent events at url (text/event-stream), as each one is in:
/// a GET with Accept: text/event-stream, or the request method and body
/// say (a language model's API that streams its reply to a POST). A
/// status that isn't a success throws HTTPError.status. With reconnect,
/// a connection that ends or fails is made again after the server's
/// retry (3 s if it said none), sending the last event's ID as
/// Last-Event-ID, as a browser's EventSource does; without it, the
/// stream ends with the body. timeout is the longest wait for the head,
/// and then for each piece; tls is request's.
pub fn events(url: string, method: string = "GET", headers: [string: string] = [:], body: bytes = bytes(), reconnect: bool = false, timeout: Duration = 60s, tls: TLS? = none) -> Stream<Event> = Stream(send => {
  var h = headers
  if h["accept"] == none && h["Accept"] == none {
    h["accept"] = "text/event-stream"
  }
  var lastID = ""
  var wait = 3s
  while true {
    do {
      let r = try await stream(url, method: method, headers: h, body: body, timeout: timeout, tls: tls)
      if !r.ok() {
        throw HTTPError.status(code: r.status)
      }
      for await e in r.events() {
        lastID = e.id
        if e.retry > 0s {
          wait = e.retry
        }
        send(e)
      }
    } catch HTTPError.status(code) {
      throw HTTPError.status(code: code)
    } catch HTTPError.tls(reason) {
      throw HTTPError.tls(reason: reason)
    } catch e {
      if !reconnect {
        throw e
      }
    }
    if !reconnect {
      return
    }
    await sleep(wait)
    if !lastID.isEmpty() {
      h["last-event-id"] = lastID
    }
  }
})

/// Splits bytes into lines of text as they come: at \n, \r\n or \r
/// (one \r\n split across two pieces is one break), without them.
fn linesOf(pieces: Stream<bytes>) -> Stream<string> = Stream(send => {
  var pending = bytes()
  // A \r ended the last piece: a \n starting the next is its pair.
  var afterCR = false
  for await piece in pieces {
    var start = 0
    var i = 0
    if afterCR && piece.count() > 0 && piece[0] == 10 {
      start = 1
      i = 1
    }
    afterCR = false
    while i < piece.count() {
      let c = piece[i]
      if c == 10 || c == 13 {
        send(pending.concat(piece.slice(start, i)).string())
        pending = bytes()
        if c == 13 {
          if i + 1 < piece.count() {
            if piece[i + 1] == 10 {
              i = i + 1
            }
          } else {
            afterCR = true
          }
        }
        start = i + 1
      }
      i = i + 1
    }
    pending = pending.concat(piece.slice(start, piece.count()))
  }
  if !pending.isEmpty() {
    send(pending.string())
  }
})

/// Reads server-sent events from lines, as the HTML standard's event
/// stream interpretation says: field: value lines, an empty line ending
/// an event; a line starting : a comment; data: lines joined by \n; an
/// event without data not dispatched.
fn eventsOf(lines: Stream<string>) -> Stream<Event> = Stream(send => {
  var first = true
  var data = ""
  var hasData = false
  var event = ""
  var id = ""
  var retry = 0s
  for await raw in lines {
    // A byte order mark at the stream's start.
    let line = if first { raw.trimPrefix("\u{FEFF}") } else { raw }
    first = false
    if line.isEmpty() {
      if hasData {
        send(Event(event: if event.isEmpty() { "message" } else { event }, data: data, id: id, retry: retry))
      }
      data = ""
      hasData = false
      event = ""
      continue
    }
    if line.hasPrefix(":") {
      continue
    }
    var field = line
    var value = ""
    if let at = line.find(":") {
      field = line.byteSlice(0, at)
      value = line.byteSlice(at + 1, line.byteCount())
      if value.hasPrefix(" ") {
        value = value.byteSlice(1, value.byteCount())
      }
    }
    if field == "data" {
      data = if hasData { data + "\n" + value } else { value }
      hasData = true
    } else if field == "event" {
      event = value
    } else if field == "id" {
      if !value.contains("\u{0}") {
        id = value
      }
    } else if field == "retry" {
      if !value.isEmpty() && value.chars().all(c => c >= '0' && c <= '9') {
        if let ms = value.toInt() {
          retry = 1ms * ms
        }
      }
    }
  }
})

// ---- A server on the loopback, for a sign-in's redirect ----

/// The platform's server on the loopback interface (127.0.0.1).
native interface LocalServer {
  /// Listens at a port the system picks, for requests to path: the port.
  async fn listen(path: string, page: string) -> int
  /// Waits for the next request to the port's path, answers it with its
  /// page, and gives the URL asked for (with its query).
  async fn next(port: int) -> string
  /// Stops listening at port.
  fn close(port: int)
}

let localServer = try? LocalServer()

/// A server of the app's on the loopback interface, for an OAuth sign-in
/// that redirects to http://127.0.0.1:port/path (RFC 8252, a desktop
/// app's way): url is the redirect URI to give; next() waits for the
/// browser to come back to it, answers with the page (what the browser
/// shows: "You can close this window"), and gives the URL it came to,
/// its query the code. close() stops it; it stops as the app quits too.
pub struct Loopback {
  url: string
  port: int

  /// The next request's URL: the redirect, with its query.
  async fn next() throws -> string = try await (localServer ?? try LocalServer()).next(port)

  /// Stops listening.
  fn close() {
    if let s = localServer { try? s.close(port) }
  }
}

/// Starts a server on the loopback interface, at a port the system picks,
/// answering requests to path with page. Phones can (Android, iOS while
/// the app runs); a browser can't listen: it throws there.
pub async fn loopback(path: string = "/callback", page: string = "<!doctype html><title>Signed in</title><p>You can close this window and go back to the app.</p>") throws -> Loopback {
  let s = localServer ?? try LocalServer()
  let p = if path.hasPrefix("/") { path } else { "/{path}" }
  let port = try await s.listen(p, page)
  return Loopback(url: "http://127.0.0.1:{port}{p}", port: port)
}
