// Package std/lottie plays Lottie animations (Bodymovin's JSON, and
// dotLottie files) with each platform's own player: lottie-ios on iOS and
// macOS, lottie-android, lottie-web; Windows and Linux draw them on a
// Canvas. Its source is an asset of the app's,
// a file's path, or an http(s) URL.
//
//   state playing = true
//   state progress = 0.0
//
//   lottie.View("success.json") {
//     bind playing: playing        // false once it played through (not looping)
//     bind progress: progress      // where it is, 0 to 1; set, it moves there
//     marker: "draw"
//     overrides: [lottie.colors("Ring", light: #0a84ff, dark: #64d2ff)]
//     width: 200
//     on complete { done = true }
//   }
//
// Windows and Linux have no Lottie player of their own: there the
// animation is drawn on a Canvas (its shapes, gradients, trim paths,
// precompositions; not its masks, mattes, images or text).

/// A range of an animation's frames.
pub struct Segment {
  from: float = 0
  to: float = 0
}

/// A named range of frames.
pub struct Marker {
  name: string
  start: float = 0
  duration: float = 0
}

/// An animation that loaded.
pub struct Info {
  /// Its size, one point per unit.
  width: float = 0
  height: float = 0
  /// Its frames: the first, and the one after its last.
  start: float = 0
  end: float = 0
  frameRate: float = 0
  markers: [Marker] = []
}

/// What an override changes.
pub enum OverrideKind {
  /// The fills' and strokes' color, under the keypath.
  color
  /// What the keypath names' opacity, from 0 to 1.
  opacity
  /// The strokes' width, under the keypath.
  strokeWidth
}

/// A change to what a keypath names: a layer's name ("Ring"), or a path
/// of names with * and ** ("Ring.**.Fill 1").
pub struct Override {
  keypath: string
  kind: OverrideKind = .color
  /// The color in light mode, and in dark mode.
  light: Color = #000000
  dark: Color = #000000
  /// An opacity's, a stroke width's.
  value: float = 0
}

/// Colors the fills and strokes under keypath.
pub fn color(keypath: string, c: Color) -> Override = Override(keypath: keypath, light: c, dark: c)

/// Colors them light in light mode and dark in dark mode.
pub fn colors(keypath: string, light: Color, dark: Color) -> Override = Override(keypath: keypath, light: light, dark: dark)

/// Sets the opacity of what keypath names, from 0 to 1.
pub fn opacity(keypath: string, v: float) -> Override = Override(keypath: keypath, kind: .opacity, value: v)

/// Sets the width of the strokes under keypath.
pub fn strokeWidth(keypath: string, w: float) -> Override = Override(keypath: keypath, kind: .strokeWidth, value: w)

/// How the animation fills the view.
pub enum Fit {
  /// All of it, its aspect kept.
  contain
  /// Filling the view, its aspect kept, cut at the edges.
  cover
  /// Filling the view, stretched.
  stretch
  /// At its own size, centered.
  center
}

/// A Lottie animation. Without a size of its style, it takes its own.
pub component View(source: string) {
  /// The animation's bytes, when there's no source.
  prop data: bytes = bytes()
  /// A dotLottie's animation, by its id ("": its first).
  prop animation: string = ""
  prop fit: Fit = .contain
  /// It plays (from where it is; from the range's start once it's at its
  /// end); false pauses it there. It becomes false once it plays through
  /// (not looping): bind it to follow.
  prop playing: bool = true
  /// It plays the range again and again.
  prop loop: bool = false
  /// Its frame rate's scale; negative plays it backwards.
  prop speed: float = 1
  /// Where it is, from 0 to 1 of the whole animation: set, it moves there
  /// (playing goes on from there); bound, it follows it as it plays. Below
  /// 0: none (it doesn't move).
  prop progress: float = -1
  /// The range it plays (to <= from: the whole animation).
  prop segment: Segment = Segment()
  /// A marker's range it plays, by name; it wins over segment.
  prop marker: string = ""
  prop overrides: [Override] = []
  event playingChange(playing: bool)
  event progressChange(progress: float)
  /// It reached the range's end, not looping.
  event complete
  event loaded(info: Info)
  /// It can't load the animation.
  event error(message: string)

  // Windows and Linux have no Lottie player: there it's drawn on a
  // Canvas (canvas.asuka).
  if @platform == .windows || @platform == .linux {
    CanvasPlayer(source) {
      data: data
      animation: animation
      fit: fit
      bind playing: playing
      loop: loop
      speed: speed
      bind progress: progress
      segment: segment
      marker: marker
      overrides: overrides
      on complete { emit complete }
      on loaded(info) { emit loaded(info) }
      on error(message) { emit error(message) }
    }
  } else {
    Player(source) {
      data: data
      animation: animation
      fit: fit
      bind playing: playing
      loop: loop
      speed: speed
      bind progress: progress
      segment: segment
      marker: marker
      overrides: overrides
      on complete { emit complete }
      on loaded(info) { emit loaded(info) }
      on error(message) { emit error(message) }
    }
  }
}

/// The platform's Lottie player (lottie-ios, lottie-android, lottie-web),
/// which View shows where there's one.
native component Player(source: string) {
  /// The animation's bytes, when there's no source.
  prop data: bytes = bytes()
  /// A dotLottie's animation, by its id ("": its first).
  prop animation: string = ""
  prop fit: Fit = .contain
  /// It plays (from where it is; from the range's start once it's at its
  /// end); false pauses it there. It becomes false once it plays through
  /// (not looping): bind it to follow.
  prop playing: bool = true
  /// It plays the range again and again.
  prop loop: bool = false
  /// Its frame rate's scale; negative plays it backwards.
  prop speed: float = 1
  /// Where it is, from 0 to 1 of the whole animation: set, it moves there
  /// (playing goes on from there); bound, it follows it as it plays. Below
  /// 0: none (it doesn't move).
  prop progress: float = -1
  /// The range it plays (to <= from: the whole animation).
  prop segment: Segment = Segment()
  /// A marker's range it plays, by name; it wins over segment.
  prop marker: string = ""
  prop overrides: [Override] = []
  event playingChange(playing: bool)
  event progressChange(progress: float)
  /// It reached the range's end, not looping.
  event complete
  event loaded(info: Info)
  /// It can't load the animation.
  event error(message: string)
}
