// Package std/fs has paths, the directories files go in (the app's
// own, the user's home, the temporary one), and the calls that read and
// write files. The calls block while the system works, so call them in
// spawn { }, which runs them on another thread:
//
//   let notes = fs.join([fs.appDir(), "notes", "today.md"])
//   let text = try await spawn { try fs.readText(notes) }
//   try await spawn { try fs.writeText(notes, text: draft) }
//   let sources = try await spawn { try fs.walk("src", skip: [".git"]) }
//
// Paths use the system's separator (\ on Windows, which takes / too).
// On the web the app's directory is the page's, kept in the browser's
// storage, and spawn's workers each have a copy (docs/web.md).

import std/time

/// Why a call failed.
pub enum FsError: Error {
  /// Nothing is at the path.
  notFound(path: string)
  /// Something is at the path already.
  exists(path: string)
  /// The app may not do that there.
  denied(path: string)
  /// A name in the path isn't a directory.
  notDirectory(path: string)
  /// The path is a directory, where a file was expected.
  isDirectory(path: string)
  /// The directory has something in it.
  notEmpty(path: string)
  /// Another failure, as the system says it.
  failed(path: string, reason: string)

  /// The error's text, as Unix tools say it: the path, then what's wrong
  /// ("notes.md: no such file or directory").
  fn message() -> string = match self {
    .notFound(p) => "{p}: no such file or directory"
    .exists(p) => "{p}: already exists"
    .denied(p) => "{p}: permission denied"
    .notDirectory(p) => "{p}: not a directory"
    .isDirectory(p) => "{p}: is a directory"
    .notEmpty(p) => "{p}: directory not empty"
    .failed(p, r) => "{p}: {r}"
  }
}

/// What's at a path.
pub struct Entry {
  /// Where it is: the directory's path joined with name (readDir,
  /// walk), or the path stat was given.
  path: string
  /// Its last name: "today.md".
  name: string
  isDir: bool
  /// In bytes (0 for a directory).
  size: int
  /// When its content last changed.
  modified: time.Time
}

/// The app's own directory, kept across launches (and in backups) and
/// not shown to the user: Application Support on iOS and macOS, the
/// app's files on Android, the user's data directory on Windows and
/// Linux. It may not exist yet: mkdirAll makes it.
pub native fn appDir() -> string

/// The user's home directory: HOME on macOS and Linux, USERPROFILE on
/// Windows (else the system's record of the user). An app on a phone or
/// the web has no user's home to see: there it's appDir. In a test,
/// os.fake's env: HOME (USERPROFILE) is the home.
pub native fn home() -> string

/// The directory for temporary files: TMPDIR on macOS and Linux (else
/// /tmp), GetTempPath's on Windows (TMP, TEMP), the app's own temporary
/// directory on a phone, the page's /tmp on the web. What's put there may
/// go when the system needs the room.
pub native fn tempDir() -> string

/// path made absolute, against the working directory, and cleaned:
/// abs("notes/../a.md") in /home/ann is "/home/ann/a.md". An absolute
/// path is only cleaned (on Windows, one without a drive takes the
/// working directory's). It throws only when the working directory is
/// gone.
pub fn abs(path: string) throws -> string {
  if let p = absolute(path) {
    return p
  }
  throw failure(path)
}

/// The parts joined by the separator, cleaned; empty parts are left
/// out: join([dir, "notes", "a.md"]).
pub native fn join(parts: [string]) -> string

/// path's shortest form: one separator between names, no "." names,
/// ".." folded into the name before it, "." for an empty path.
pub native fn clean(path: string) -> string

/// All but path's last name: dir("/a/b/c.md") is "/a/b".
pub native fn dir(path: string) -> string

/// path's last name: base("/a/b/c.md") is "c.md".
pub native fn base(path: string) -> string

/// The last name's extension, from its last ".": ext("c.tar.gz") is
/// ".gz"; "" when it has none.
pub native fn ext(path: string) -> string

/// Whether something is at path.
pub native fn exists(path: string) -> bool

/// What's in the directory at path, sorted by name.
pub fn readDir(path: string) throws -> [Entry] {
  if let names = listNames(path) {
    var out: [Entry] = []
    for name in names {
      let p = join([path, name])
      // One that went since the listing is left out.
      if let info = statInfo(p) {
        out.push(entry(p, name, info))
      }
    }
    return out
  }
  throw failure(path)
}

/// Everything under the directory at dir, at every depth: each entry,
/// then, for a directory, what's in it, in name order (dir itself isn't
/// in the list). Each Entry's path is dir joined with the names down to
/// it ("src/ui/list.asuka" for walk("src")).
///
/// skip names directories not to go into (".git", "node_modules"): one
/// is still in the list, without what's in it.
///
///   let all = try await spawn { try fs.walk(".", skip: [".git", "node_modules"]) }
///   let sources = all.filter(e => !e.isDir && fs.ext(e.name) == ".asuka")
///
/// A link is listed as what it links to, but a link to a directory isn't
/// gone into (so a link can't make it go round). What can't be read
/// throws its FsError (a directory it may not list: .denied(path)), as
/// readDir does; what goes while it walks is left out. It blocks until
/// it has it all: walk a large tree in spawn { }.
pub fn walk(dir: string, skip: [string] = []) throws -> [Entry] {
  var out: [Entry] = []
  // What's still to list, the next last.
  var todo = (try listed(dir, top: true)).reversed()
  while let e = todo.pop() {
    out.push(e.entry)
    if e.entry.isDir && !e.link && !skip.contains(e.entry.name) {
      for c in (try listed(e.entry.path, top: false)).reversed() {
        todo.push(c)
      }
    }
  }
  return out
}

struct Walked {
  entry: Entry
  link: bool
}

// listed is what's in the directory d, for walk: none of it when d went
// since its own listing (top: it's walk's dir, which must be there).
fn listed(d: string, top: bool) throws -> [Walked] {
  var out: [Walked] = []
  if let names = listNames(d) {
    for name in names {
      let p = join([d, name])
      // One that went since the listing is left out.
      if let info = walkInfo(p) {
        out.push(Walked(entry: entry(p, name, info), link: info[3] != 0))
      }
    }
  } else if top || failureKind() != 2 {
    throw failure(d)
  }
  return out
}

/// What's at path (a link: what it links to).
pub fn stat(path: string) throws -> Entry {
  if let info = statInfo(path) {
    return entry(path, base(path), info)
  }
  throw failure(path)
}

/// The file at path's bytes.
pub fn read(path: string) throws -> bytes {
  if let data = readFile(path) {
    return data
  }
  throw failure(path)
}

/// The file at path's text (UTF-8; what isn't becomes U+FFFD).
pub fn readText(path: string) throws -> string = (try read(path)).string()

/// Makes the file at path (or empties it) with data.
pub fn write(path: string, data: bytes) throws {
  if !writeFile(path, data, false) {
    throw failure(path)
  }
}

/// Makes the file at path (or empties it) with text, as UTF-8.
pub fn writeText(path: string, text: string) throws {
  try write(path, data: text.bytes())
}

/// Adds data at the end of the file at path, making it if it isn't
/// there.
pub fn append(path: string, data: bytes) throws {
  if !writeFile(path, data, true) {
    throw failure(path)
  }
}

/// Adds text, as UTF-8, at the end of the file at path, making it if it
/// isn't there.
pub fn appendText(path: string, text: string) throws {
  try append(path, data: text.bytes())
}

/// Copies the file at from to to (replacing what's there).
pub fn copy(from: string, to: string) throws {
  if !copyFile(from, to) {
    throw failure(from)
  }
}

/// Moves what's at from to to (replacing a file there).
pub fn rename(from: string, to: string) throws {
  if !moveFile(from, to) {
    throw failure(from)
  }
}

/// Makes the directory at path and those it's in, as needed.
pub fn mkdirAll(path: string) throws {
  if !makeDirs(path) {
    throw failure(path)
  }
}

/// Removes the file or the empty directory at path.
pub fn remove(path: string) throws {
  if !removeOne(path) {
    throw failure(path)
  }
}

/// Removes what's at path and everything in it; nothing there is fine.
pub fn removeAll(path: string) throws {
  if !removeTree(path) {
    throw failure(path)
  }
}

fn entry(path: string, name: string, info: [int]) -> Entry = Entry(path: path, name: name, isDir: info[0] != 0, size: info[1], modified: time.unixNano(info[2]))

// failure is the error of the last call that failed on this thread.
fn failure(path: string) -> FsError = match failureKind() {
  2 => .notFound(path)
  3 => .exists(path)
  4 => .denied(path)
  5 => .notDirectory(path)
  6 => .isDirectory(path)
  7 => .notEmpty(path)
  _ => .failed(path: path, reason: failureReason())
}

native fn listNames(path: string) -> [string]?
native fn statInfo(path: string) -> [int]?
native fn walkInfo(path: string) -> [int]?
native fn absolute(path: string) -> string?
native fn readFile(path: string) -> bytes?
native fn writeFile(path: string, data: bytes, append: bool) -> bool
native fn copyFile(from: string, to: string) -> bool
native fn moveFile(from: string, to: string) -> bool
native fn makeDirs(path: string) -> bool
native fn removeOne(path: string) -> bool
native fn removeTree(path: string) -> bool
native fn failureKind() -> int
native fn failureReason() -> string
