import std/json

struct Job {
  name: string
  due: int
}

// A random number generator of our own: the same numbers every run.
struct Rand {
  state: int

  mut fn next(below: int) -> int {
    state = state &* 6364136223846793005 &+ 1442695040888963407
    return ((state >> 33) & 0x7fffffff) % below
  }
}

test "a heap pops in its order" {
  var h = Heap<int>(by: (a, b) => a < b)
  for x in [5, 1, 4, 1, 9, 2] { h.push(x) }
  expect(h.count() == 6 && h.peek() == 1)
  var out: [int] = []
  while let x = h.pop() { out.push(x) }
  expect(out == [1, 1, 2, 4, 5, 9])
  expect(h.isEmpty() && h.pop() == none && h.peek() == none)

  var jobs = Heap<Job>(by: (a, b) => a.due > b.due)
  jobs.push(Job(name: "a", due: 3))
  jobs.push(Job(name: "b", due: 7))
  jobs.push(Job(name: "c", due: 5))
  expect(jobs.pop()!.name == "b" && jobs.sorted().map(j => j.name) == ["c", "a"])
}

test "a heap of many, and Heap.of" {
  var r = Rand(state: 1)
  var xs: [int] = []
  for _ in 0..<20000 { xs.push(r.next(1000000)) }
  var h = Heap<int>(by: (a, b) => a < b)
  for x in xs { h.push(x) }
  let built = Heap.of(xs, by: (a, b) => a < b)
  expect(built.count() == 20000)
  var out: [int] = []
  while let x = h.pop() { out.push(x) }
  expect(out == xs.sorted())
  expect(built.sorted() == out && built.lazy().toArray() == out)
  var b = built
  var again: [int] = []
  for x in b { again.push(x) }
  expect(again == out)
  expect(b.pop() == out[0] && built.count() == 20000)
}

test "pushPop keeps the k greatest" {
  var top = Heap<int>(by: (a, b) => a < b)
  for x in [4, 9, 1, 7, 3, 8, 2] {
    if top.count() < 3 { top.push(x) } else { let _ = top.pushPop(x) }
  }
  expect(top.sorted() == [7, 8, 9])
  expect(top.replace(1) == 7 && top.sorted() == [1, 8, 9])
}

test "a sorted map against a model" {
  var m = SortedMap<int, int>()
  var model: [int: int] = [:]
  var r = Rand(state: 7)
  for step in 0..<30000 {
    let k = r.next(3000)
    if r.next(3) == 0 {
      expect(m.remove(k) == model[k])
      let _ = model.remove(k)
    } else {
      m.set(k, step)
      model[k] = step
    }
  }
  let keys = model.keys().sorted()
  expect(m.count() == keys.count())
  expect(m.keys() == keys)
  expect(m.values() == keys.map(k => model[k]!))
  for k in 0..<3000 { expect(m.get(k) == model[k]) }
  expect(m.first()!.0 == keys[0] && m.last()!.0 == keys[keys.count() - 1])
}

test "nearest keys and ranges" {
  var m = SortedMap<int, string>()
  for k in [10, 20, 30, 40] { m.set(k, "{k}") }
  expect(m.floor(25)!.0 == 20 && m.floor(20)!.0 == 20 && m.floor(5) == none)
  expect(m.ceiling(25)!.0 == 30 && m.ceiling(30)!.0 == 30 && m.ceiling(45) == none)
  expect(m.lower(20)!.0 == 10 && m.higher(20)!.0 == 30 && m.higher(40) == none)
  expect(m.range(from: 15, to: 40).map(e => e.0).toArray() == [20, 30])
  expect(m.range(from: 30).map(e => e.1).toArray() == ["30", "40"])
  expect(m.range(to: 20).count() == 1)
  var seen: [int] = []
  for (k, _) in m { seen.push(k) }
  expect(seen == [10, 20, 30, 40])

  var big = SortedMap<int, int>()
  for k in 0..<100000 { big.set(k * 2, k) }
  expect(big.count() == 100000)
  expect(big.range(from: 1001, to: 1011).map(e => e.0).toArray() == [1002, 1004, 1006, 1008, 1010])
  expect(big.floor(77777)!.0 == 77776 && big.ceiling(77777)!.0 == 77778)
  var read = 0
  let firstOdd = big.range(from: 500).onEach(e => { read += 1 }).find(where: e => e.1 % 7 == 3)
  expect(firstOdd!.0 == 510 && read == 6)
  for k in 0..<50000 { let _ = big.remove(k * 4) }
  expect(big.count() == 50000 && big.first()!.0 == 2 && big.last()!.0 == 199998)
  expect(big.lazy().map(e => e.0).windows(2).all(where: w => w[0] < w[1]))
}

test "copies are values" {
  var a = SortedMap<string, int>()
  a.set("x", 1)
  var b = a
  b.set("y", 2)
  b.set("x", 9)
  expect(a.entries().count() == 1 && a.get("x") == 1)
  expect(b.get("x") == 9 && b.count() == 2)
  var big = SortedMap<int, int>()
  for k in 0..<1000 { big.set(k, k) }
  var copy = big
  for k in 0..<500 { let _ = copy.remove(k) }
  expect(big.count() == 1000 && big.get(10) == 10 && copy.count() == 500 && copy.get(10) == none)
  expect(a.popFirst()!.0 == "x" && a.isEmpty() && b.count() == 2)
}

test "a custom order" {
  var m = SortedMap<string, int>(by: (a, b) => a.lower() < b.lower())
  m.set("b", 1)
  m.set("A", 2)
  m.set("B", 3)
  expect(m.keys() == ["A", "b"] && m.get("a") == 2 && m.get("b") == 3)
  var desc = SortedSet<int>(by: (a, b) => a > b)
  for x in [3, 1, 2] { let _ = desc.insert(x) }
  expect(desc.toArray() == [3, 2, 1] && desc.first() == 3)
}

test "a sorted set" {
  var s = SortedSet<int>()
  expect(s.insert(5) && s.insert(1) && !s.insert(5) && s.insert(9))
  expect(s.toArray() == [1, 5, 9] && s.contains(5) && !s.contains(4))
  expect(s.floor(4) == 1 && s.ceiling(6) == 9 && s.lower(1) == none && s.higher(9) == none)
  expect(s.range(from: 2, to: 9).toArray() == [5])
  var t = SortedSet<int>()
  for x in [9, 10] { let _ = t.insert(x) }
  expect(s.union(t).toArray() == [1, 5, 9, 10])
  expect(s.intersection(t).toArray() == [9] && s.subtracting(t).toArray() == [1, 5])
  expect(s.remove(5) && !s.remove(5) && s.count() == 2)
  expect(s.popLast() == 9 && s.popFirst() == 1 && s.isEmpty())
  var r = Rand(state: 3)
  var many = SortedSet<int>()
  var model: Set<int> = []
  for _ in 0..<20000 {
    let x = r.next(5000)
    if r.next(2) == 0 {
      expect(many.insert(x) == model.insert(x))
    } else {
      expect(many.remove(x) == model.remove(x))
    }
  }
  var sorted: [int] = []
  for x in model { sorted.push(x) }
  expect(many.toArray() == sorted.sorted())
}

test "Heap.min and Heap.max" {
  var lo = Heap.min([5, 1, 4])
  var hi = Heap.max(["b", "c", "a"])
  let empty = Heap<float>.min()
  expect(lo.pop() == 1 && hi.pop() == "c" && empty.isEmpty())
  // A test file sees the package's insides.
  expect(lo.items.count() == 2)
}

test "compared, hashed, printed and written by their contents" {
  let a = Heap.of([3, 1, 2], by: (x, y) => x < y)
  let b = Heap.max([2, 3, 1])
  expect(a == b && Set([a, b]).count() == 1 && a != Heap.min([1, 2]))
  expect("{a}" == "[1, 2, 3]" && json.encode(b) == "[3,2,1]")
  let h: Heap<int> = try json.decode("[5, 1, 4]")
  expect(h.peek() == 1 && h.count() == 3)

  var m = SortedMap<string, int>()
  m.set("bo", 3)
  m.set("al", 7)
  var n = SortedMap<string, int>(by: (x, y) => x > y)
  n.set("al", 7)
  n.set("bo", 3)
  expect(m == n && [m: 1][n] == 1)
  expect(json.encode(m) == r#"{"al":7,"bo":3}"# && "{m}" == r#"["al": 7, "bo": 3]"#)
  let back: SortedMap<string, int> = try json.decode(r#"{"b": 2, "a": 1}"#)
  expect(back.first()! == ("a", 1))

  var byInt = SortedMap<int, string>()
  byInt.set(2, "b")
  byInt.set(1, "a")
  expect(json.encode(byInt) == r#"[{"key":1,"value":"a"},{"key":2,"value":"b"}]"#)
  let again = try json.decode<SortedMap<int, string>>(json.encode(byInt))
  expect(again == byInt)

  var s = SortedSet<int>()
  for x in [3, 1, 2] { let _ = s.insert(x) }
  let t = try json.decode<SortedSet<int>>("[2, 3, 1, 3]")
  expect(s == t && json.encode(t) == "[1,2,3]" && Set([s, t]).count() == 1)
}

// A version, ordered by its own compare: the B-tree calls it.
struct Version {
  major: int
  minor: int

  fn compare(other: Version) -> int = if major != other.major { major - other.major } else { minor - other.minor }
}

// A file's constant: frozen, read by every test, changed only in copies.
let primes: SortedSet<int> = (try? SortedSet.fromJSON([7, 2, 5, 3, 11])) ?? SortedSet<int>()

test "keys of every kind, against a model" {
  // Strings for keys, structs for values: the node's references are its
  // keys and its values.
  var m = SortedMap<string, Job>()
  var model: [string: Job] = [:]
  var r = Rand(state: 11)
  for step in 0..<20000 {
    let k = "k{r.next(2500)}"
    if r.next(3) == 0 {
      expect(m.remove(k)?.due == model[k]?.due)
      let _ = model.remove(k)
    } else {
      m.set(k, Job(name: k, due: step))
      model[k] = Job(name: k, due: step)
    }
  }
  let keys = model.keys().sorted()
  expect(m.keys() == keys && m.values().map(j => j.due) == keys.map(k => model[k]!.due))
  expect(m.range(from: "k1", to: "k2").map(e => e.0).toArray() == keys.filter(k => k >= "k1" && k < "k2"))

  // A type's own compare.
  var vs = SortedMap<Version, string>()
  for (a, b) in [(1, 2), (0, 9), (1, 0), (2, 1), (0, 10)] { vs.set(Version(major: a, minor: b), "{a}.{b}") }
  expect(vs.values() == ["0.9", "0.10", "1.0", "1.2", "2.1"])
  expect(vs.floor(Version(major: 1, minor: 1))!.1 == "1.0" && vs.get(Version(major: 0, minor: 10)) == "0.10")
  expect(vs.remove(Version(major: 1, minor: 0)) == "1.0" && vs.count() == 4)

  // u64s past int's largest order after it; floats as floats.
  var big = SortedSet<u64>()
  for x in [u64(1), 18446744073709551615, 9223372036854775808, 0] { let _ = big.insert(x) }
  expect(big.toArray() == [0, 1, 9223372036854775808, 18446744073709551615])
  var fs = SortedMap<float, int>()
  for x in [2.5, -1.0, 0.25, 100.0] { fs.set(x, int(x * 4.0)) }
  expect(fs.keys() == [-1.0, 0.25, 2.5, 100.0] && fs.ceiling(1.0)!.1 == 10)
  var cs = SortedSet<char>()
  for c in "hello".chars() { let _ = cs.insert(c) }
  expect(cs.toArray() == ['e', 'h', 'l', 'o'])
}

test "shared trees change only in copies" {
  var a = SortedMap<int, string>()
  for k in 0..<5000 { a.set(k, "{k}") }
  let snapshot = a
  let walk = a.lazy()
  // Removing all but a few merges the nodes a and snapshot share.
  for k in 0..<4990 { let _ = a.remove(k) }
  for k in 10000..<10100 { a.set(k, "{k}") }
  expect(a.count() == 110 && a.first()!.0 == 4990)
  expect(snapshot.count() == 5000 && snapshot.get(42) == "42" && snapshot.last()!.0 == 4999)
  expect(walk.count() == 5000 && walk.map(e => e.0).windows(2).all(where: w => w[0] + 1 == w[1]))
  // Nested: a map of sets, changed through its copy.
  var groups = SortedMap<int, SortedSet<string>>()
  for i in 0..<300 {
    var s = groups.get(i % 7) ?? SortedSet<string>()
    let _ = s.insert("x{i}")
    groups.set(i % 7, s)
  }
  let before = groups
  var g0 = groups.get(0)!
  let _ = g0.remove("x0")
  groups.set(0, g0)
  expect(before.get(0)!.contains("x0") && !groups.get(0)!.contains("x0") && groups.get(0)!.count() == 42)
  // A constant's copy.
  var more = primes
  let _ = more.insert(13)
  expect(primes.toArray() == [2, 3, 5, 7, 11] && more.count() == 6 && more.last() == 13)
}

test "an order that raises an error leaves the map whole" {
  // Past 10^7, the order's product overflows: an error, which the set
  // that compared raises, the map as it was.
  var m = SortedMap<int, string>(by: (a, b) => a * 1000000000000 < b * 1000000000000)
  for k in 0..<500 { m.set(k, "{k}") }
  var raised = 0
  try m.set(20000000, "big") catch { raised += 1 }
  expect(raised == 1 && m.count() == 500 && m.get(499) == "499" && m.keys() == (0..<500).lazy().toArray())
  let gone = try m.remove(30000000) catch { "?" }
  expect(gone == "?" && m.count() == 500)
  expect(m.remove(7) == "7" && m.count() == 499 && m.first()!.0 == 0 && m.last()!.0 == 499)
}

// Ordered by their own compare (high first), not their cases' order.
enum Level {
  low
  mid
  high

  fn compare(other: Level) -> int = levelRank(other) - levelRank(self)
}

fn levelRank(l: Level) -> int = match l {
  .low => 0
  .mid => 1
  .high => 2
}

// An enum without payloads kept as a reference (it's an Error): by its
// cases' order.
enum Fault: Error {
  minor
  major
}

test "enums for keys: their own compare, else their cases' order" {
  var m = SortedMap<Level, string>()
  for l in [Level.mid, Level.low, Level.high] { m.set(l, "{l}") }
  expect(m.values() == ["high", "mid", "low"] && m.first()!.0 == .high && m.floor(.mid)!.1 == "mid")
  var s = SortedSet<Fault>()
  let _ = s.insert(.major)
  let _ = s.insert(.minor)
  expect(s.first() == .minor && s.last() == .major && s.count() == 2)
}
