// Package std/qrcode makes QR codes: a link, a contact, a Wi-Fi network
// or a ticket shown on the screen for another phone's camera. It's
// written in Asuka (ISO/IEC 18004: the numeric, alphanumeric and byte
// modes, versions 1 to 40, four levels of error correction, the mask
// whose penalty is lowest), so a code is the same on every platform, and
// View draws it with the platform's own vector drawing.
//
//   qrcode.View("https://example.com/invite/42") {
//     width: 200
//     height: 200
//   }
//
// encode gives the modules themselves, for drawing them another way or
// saving them (svg()). Reading codes is platform/scan's and the camera's.

/// How much of a code can be lost (a scratch, a logo over it) and still
/// read: more takes more modules.
pub enum Correction {
  /// About 7%.
  low
  /// About 15%: what most codes use.
  medium
  /// About 25%.
  quartile
  /// About 30%.
  high
}

/// Why a text has no code.
pub enum QRError: Error {
  /// It's longer than the largest code holds at the level: 2,953 bytes
  /// of UTF-8 at .low, 1,273 at .high (more digits, or capitals).
  tooLong(bytes: int)

  /// The error's text.
  fn message() -> string = match self {
    .tooLong(n) => "{n} bytes are too many for a QR code at this level of error correction"
  }
}

/// A QR code: size modules a side (21 at version 1, 4 more a version, to
/// 177), row by row, without the quiet zone around it.
pub struct Code {
  size: int
  /// Its version, 1 to 40: the smallest that holds the text.
  version: int
  /// Its mask, 0 to 7.
  mask: int
  /// Whether each module is dark, row by row: modules[y * size + x].
  modules: [bool]

  /// Whether the module at x, y (from the top left) is dark.
  fn dark(x: int, y: int) -> bool = modules[y * size + x]

  /// The code as SVG markup: a module a unit, a quiet zone of quiet
  /// modules around it (the standard's 4: readers need some), dark
  /// modules in dark on a light background (#rrggbb; "": none).
  fn svg(quiet: int = 4, dark: string = "#000000", light: string = "#ffffff") -> string {
    let n = size + 2 * quiet
    var d: [string] = []
    for y in 0..<size {
      var x = 0
      while x < size {
        if !modules[y * size + x] {
          x += 1
          continue
        }
        // A run of dark modules: one rectangle.
        var end = x
        while end < size && modules[y * size + end] { end += 1 }
        d.push("M{x + quiet} {y + quiet}h{end - x}v1h-{end - x}z")
        x = end
      }
    }
    let back = if light.isEmpty() { "" } else { "<rect width=\"{n}\" height=\"{n}\" fill=\"{light}\"/>" }
    return "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {n} {n}\" shape-rendering=\"crispEdges\">{back}<path fill=\"{dark}\" d=\"{d.joined(separator: "")}\"/></svg>"
  }
}

/// text's QR code at the level of correction: the smallest version that
/// holds it, in the mode that takes the fewest modules (digits, then
/// capitals and " $%*+-./:", else its UTF-8 bytes).
pub fn encode(text: string, correction: Correction = .medium) throws -> Code {
  let l = levelIndex(correction)
  let seg = segment(text)
  for v in 1..40 {
    let capacity = dataCodewords(v, l) * 8
    if 4 + countBits(seg.mode, v) + seg.data.count() <= capacity {
      return build(v, l, seg, capacity)
    }
  }
  throw QRError.tooLong(bytes: text.byteCount())
}

/// A QR code of text, drawn to fit its box (square, centered), dark
/// modules on light whatever the theme, as cameras read them best. Its
/// style gives its size; screen readers say label (by default the text).
pub component View(text: string) {
  prop correction: Correction = .medium
  /// The dark modules' color.
  prop dark: Color = #000000
  /// The light modules' and the quiet zone's.
  prop light: Color = #ffffff
  /// The light border, in modules: the standard's 4.
  prop quiet: int = 4
  /// What screen readers say; "": the text.
  prop label: string = ""

  let code = try? encode(text, correction: correction)

  Canvas(g => {
    let side = min(g.width, g.height)
    let x0 = (g.width - side) / 2
    let y0 = (g.height - side) / 2
    g.fill(g.path().rect(x0, y0, side, side), light)
    let c = code else { return }
    let m = side / (c.size + 2 * quiet).float()
    let ox = x0 + m * quiet.float()
    let oy = y0 + m * quiet.float()
    let p = g.path()
    for y in 0..<c.size {
      var x = 0
      while x < c.size {
        if !c.modules[y * c.size + x] {
          x += 1
          continue
        }
        var end = x
        while end < c.size && c.modules[y * c.size + end] { end += 1 }
        p.rect(ox + m * x.float(), oy + m * y.float(), m * (end - x).float(), m)
        x = end
      }
    }
    g.fill(p, dark)
  }) {
    width: 200
    height: 200
    role: .image
    label: if label.isEmpty() { text } else { label }
  }
}

// ---- Encoding ----

/// The levels' order in the tables: L, M, Q, H.
fn levelIndex(c: Correction) -> int = match c {
  .low => 0
  .medium => 1
  .quartile => 2
  .high => 3
}

let modeNumeric = 1
let modeAlnum = 2
let modeBytes = 4

let alnum = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:"

/// A segment: its mode, its character count and its data's bits.
struct Segment {
  mode: int
  count: int
  data: [bool]
}

/// Appends v's low n bits, most significant first.
fn putBits(bits: [bool], v: int, n: int) -> [bool] {
  var b = bits
  var i = n - 1
  while i >= 0 {
    b.push((v >> i) & 1 == 1)
    i -= 1
  }
  return b
}

fn alnumIndex(c: int) -> int {
  let a = alnum.bytes()
  for i in 0..<a.count() {
    if a[i] == c { return i }
  }
  return -1
}

/// The mode that holds text in the fewest bits, and its data.
fn segment(text: string) -> Segment {
  let b = text.bytes()
  let n = b.count()
  var numeric = n > 0
  var alpha = n > 0
  for i in 0..<n {
    let c = b[i]
    if c < 48 || c > 57 { numeric = false }
    if alnumIndex(c) < 0 { alpha = false }
  }
  var bits: [bool] = []
  if numeric {
    var i = 0
    while i < n {
      let k = min(3, n - i)
      var v = 0
      for j in i..<(i + k) { v = v * 10 + b[j] - 48 }
      bits = putBits(bits, v, k * 3 + 1)
      i += 3
    }
    return Segment(mode: modeNumeric, count: n, data: bits)
  }
  if alpha {
    var i = 0
    while i + 1 < n {
      bits = putBits(bits, alnumIndex(b[i]) * 45 + alnumIndex(b[i + 1]), 11)
      i += 2
    }
    if n % 2 == 1 { bits = putBits(bits, alnumIndex(b[n - 1]), 6) }
    return Segment(mode: modeAlnum, count: n, data: bits)
  }
  for i in 0..<n { bits = putBits(bits, b[i], 8) }
  return Segment(mode: modeBytes, count: n, data: bits)
}

/// The width of a segment's character count.
fn countBits(mode: int, version: int) -> int {
  let i = if version >= 27 { 2 } else if version >= 10 { 1 } else { 0 }
  if mode == modeNumeric { return [10, 12, 14][i] }
  if mode == modeAlnum { return [9, 11, 13][i] }
  return [8, 16, 16][i]
}

/// The codewords of error correction in each block, and the blocks, by
/// level and version (index 0 unused).
let eccPerBlock: [[int]] = [
  [-1, 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28, 30, 28, 28, 28, 28, 30, 30, 26, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30],
  [-1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28, 26, 26, 26, 26, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28],
  [-1, 13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28, 28, 26, 30, 28, 30, 30, 30, 30, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30],
  [-1, 17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28, 28, 26, 28, 30, 24, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30],
]

let blockCounts: [[int]] = [
  [-1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9, 9, 10, 12, 12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21, 22, 24, 25],
  [-1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16, 17, 17, 18, 20, 21, 23, 25, 26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45, 47, 49],
  [-1, 1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20, 23, 23, 25, 27, 29, 34, 34, 35, 38, 40, 43, 45, 48, 51, 53, 56, 59, 62, 65, 68],
  [-1, 1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25, 25, 25, 34, 30, 32, 35, 37, 40, 42, 45, 48, 51, 54, 57, 60, 63, 66, 70, 74, 77, 81],
]

/// How many modules of a version hold data and error correction: all but
/// the function patterns and the format and version information.
fn rawModules(v: int) -> int {
  var n = (16 * v + 128) * v + 64
  if v >= 2 {
    let a = v / 7 + 2
    n -= (25 * a - 10) * a - 55
    if v >= 7 { n -= 36 }
  }
  return n
}

fn dataCodewords(v: int, l: int) -> int = rawModules(v) / 8 - eccPerBlock[l][v] * blockCounts[l][v]

/// The code of a version holding the segment.
fn build(v: int, l: int, seg: Segment, capacity: int) -> Code {
  var b = putBits([], seg.mode, 4)
  b = putBits(b, seg.count, countBits(seg.mode, v))
  b = b + seg.data
  // The terminator, up to four zeros; then to a byte; then the pad
  // bytes, in turn.
  b = putBits(b, 0, min(4, capacity - b.count()))
  b = putBits(b, 0, (8 - b.count() % 8) % 8)
  var pad = 0xec
  while b.count() < capacity {
    b = putBits(b, pad, 8)
    pad = pad ^ 0xec ^ 0x11
  }
  var words: [int] = []
  for i in 0..<(b.count() / 8) {
    var w = 0
    for j in 0..<8 { w = (w << 1) | (if b[i * 8 + j] { 1 } else { 0 }) }
    words.push(w)
  }
  let all = interleave(words, v, l)

  var g = Grid.of(v * 4 + 17)
  g.functionPatterns(v)
  g.place(all)
  // The mask whose penalty is lowest; the first of equals.
  var best = 0
  var bestPenalty = -1
  for m in 0..<8 {
    g.applyMask(m)
    g.format(l, m)
    let p = g.penalty()
    if bestPenalty < 0 || p < bestPenalty {
      best = m
      bestPenalty = p
    }
    g.applyMask(m) // undone: it's its own inverse
  }
  g.applyMask(best)
  g.format(l, best)
  return Code(size: g.size, version: v, mask: best, modules: g.dark)
}

/// The data split into the version's blocks, each with its error
/// correction, taken a column at a time.
fn interleave(data: [int], v: int, l: int) -> [int] {
  let nb = blockCounts[l][v]
  let ecc = eccPerBlock[l][v]
  let raw = rawModules(v) / 8
  let short = nb - raw % nb
  let shortLen = raw / nb
  let div = rsDivisor(ecc)
  var blocks: [[int]] = []
  var k = 0
  for i in 0..<nb {
    let n = shortLen - ecc + (if i < short { 0 } else { 1 })
    let d = data.slice(k, k + n)
    k += n
    // A short block has a gap where the long ones have their last data
    // codeword, so the columns line up.
    let gap: [int] = if i < short { [-1] } else { [] }
    blocks.push(d + gap + rsRemainder(d, div))
  }
  var out: [int] = []
  for i in 0..<blocks[0].count() {
    for block in blocks {
      if block[i] >= 0 { out.push(block[i]) }
    }
  }
  return out
}

/// x times y in GF(2^8), modulo x^8 + x^4 + x^3 + x^2 + 1.
fn gfMul(x: int, y: int) -> int {
  var z = 0
  var i = 7
  while i >= 0 {
    z = (z << 1) ^ ((z >> 7) * 0x11d)
    z = z ^ (((y >> i) & 1) * x)
    i -= 1
  }
  return z
}

/// The Reed-Solomon generator of degree n, its highest term left out.
fn rsDivisor(n: int) -> [int] {
  var r: [int] = []
  for _ in 0..<(n - 1) { r.push(0) }
  r.push(1)
  var root = 1
  for _ in 0..<n {
    for j in 0..<n {
      r[j] = gfMul(r[j], root)
      if j + 1 < n { r[j] = r[j] ^ r[j + 1] }
    }
    root = gfMul(root, 2)
  }
  return r
}

fn rsRemainder(data: [int], div: [int]) -> [int] {
  let n = div.count()
  var r: [int] = []
  for _ in 0..<n { r.push(0) }
  for b in data {
    let f = b ^ r[0]
    for i in 0..<(n - 1) { r[i] = r[i + 1] }
    r[n - 1] = 0
    for i in 0..<n { r[i] = r[i] ^ gfMul(div[i], f) }
  }
  return r
}

/// The alignment patterns' centers on each axis.
fn alignments(v: int) -> [int] {
  if v == 1 { return [] }
  let count = v / 7 + 2
  let step = (v * 8 + count * 3 + 5) / (count * 4 - 4) * 2
  var rest: [int] = []
  var p = v * 4 + 17 - 7
  while rest.count() < count - 1 {
    rest.pushFirst(p)
    p -= step
  }
  return [6] + rest
}

/// A code being laid out: its modules, and which are a function
/// pattern's (neither data nor masked).
struct Grid {
  size: int
  dark: [bool]
  fixed: [bool]

  static fn of(size: int) -> Grid {
    var cells: [bool] = []
    for _ in 0..<(size * size) { cells.push(false) }
    return Grid(size: size, dark: cells, fixed: cells)
  }

  mut fn set(x: int, y: int, on: bool) {
    dark[y * size + x] = on
    fixed[y * size + x] = true
  }

  mut fn functionPatterns(v: int) {
    for i in 0..<size {
      set(6, i, i % 2 == 0)
      set(i, 6, i % 2 == 0)
    }
    finder(3, 3)
    finder(size - 4, 3)
    finder(3, size - 4)
    let pos = alignments(v)
    let last = pos.count() - 1
    for i in 0..<pos.count() {
      for j in 0..<pos.count() {
        // The finders' corners.
        if i == 0 && j == 0 || i == 0 && j == last || i == last && j == 0 { continue }
        for dy in -2..2 {
          for dx in -2..2 {
            set(pos[i] + dx, pos[j] + dy, max(dx.abs(), dy.abs()) != 1)
          }
        }
      }
    }
    format(0, 0) // reserved; written for real once the mask is chosen
    if v >= 7 {
      var r = v
      for _ in 0..<12 { r = (r << 1) ^ ((r >> 11) * 0x1f25) }
      let bits = (v << 12) | r
      for i in 0..<18 {
        let on = (bits >> i) & 1 == 1
        let a = size - 11 + i % 3
        let b = i / 3
        set(a, b, on)
        set(b, a, on)
      }
    }
  }

  mut fn finder(cx: int, cy: int) {
    for dy in -4..4 {
      for dx in -4..4 {
        let x = cx + dx
        let y = cy + dy
        if x >= 0 && x < size && y >= 0 && y < size {
          let d = max(dx.abs(), dy.abs())
          set(x, y, d != 2 && d != 4)
        }
      }
    }
  }

  /// The level's and mask's format information, both copies, and the
  /// dark module.
  mut fn format(l: int, mask: int) {
    let data = ([1, 0, 3, 2][l] << 3) | mask
    var r = data
    for _ in 0..<10 { r = (r << 1) ^ ((r >> 9) * 0x537) }
    let b = ((data << 10) | r) ^ 0x5412
    for i in 0..5 { set(8, i, (b >> i) & 1 == 1) }
    set(8, 7, (b >> 6) & 1 == 1)
    set(8, 8, (b >> 7) & 1 == 1)
    set(7, 8, (b >> 8) & 1 == 1)
    for i in 9..<15 { set(14 - i, 8, (b >> i) & 1 == 1) }
    for i in 0..<8 { set(size - 1 - i, 8, (b >> i) & 1 == 1) }
    for i in 8..<15 { set(8, size - 15 + i, (b >> i) & 1 == 1) }
    set(8, size - 8, true)
  }

  /// The codewords in the zigzag, two columns at a time from the right,
  /// past the timing column and the function patterns.
  mut fn place(words: [int]) {
    let total = words.count() * 8
    var i = 0
    var right = size - 1
    while right >= 1 {
      if right == 6 { right = 5 }
      let up = ((right + 1) & 2) == 0
      for vert in 0..<size {
        for j in 0..<2 {
          let x = right - j
          let y = if up { size - 1 - vert } else { vert }
          if !fixed[y * size + x] && i < total {
            dark[y * size + x] = (words[i >> 3] >> (7 - (i & 7))) & 1 == 1
            i += 1
          }
        }
      }
      right -= 2
    }
  }

  mut fn applyMask(m: int) {
    for y in 0..<size {
      for x in 0..<size {
        if fixed[y * size + x] { continue }
        let flip = match m {
          0 => (x + y) % 2 == 0
          1 => y % 2 == 0
          2 => x % 3 == 0
          3 => (x + y) % 3 == 0
          4 => (x / 3 + y / 2) % 2 == 0
          5 => x * y % 2 + x * y % 3 == 0
          6 => (x * y % 2 + x * y % 3) % 2 == 0
          _ => ((x + y) % 2 + x * y % 3) % 2 == 0
        }
        if flip { dark[y * size + x] = !dark[y * size + x] }
      }
    }
  }

  /// The standard's penalty of a masked code: runs of five or more, 2×2
  /// blocks, finder-like patterns, and dark modules far from half.
  fn penalty() -> int {
    let n = size
    var p = 0
    for rows in [true, false] {
      for y in 0..<n {
        var line: [bool] = []
        var run = 0
        var last = false
        for x in 0..<n {
          let d = if rows { dark[y * n + x] } else { dark[x * n + y] }
          line.push(d)
          if x > 0 && d == last {
            run += 1
          } else {
            if run >= 5 { p += run - 2 }
            run = 1
            last = d
          }
        }
        if run >= 5 { p += run - 2 }
        p += 40 * finderLike(line)
      }
    }
    for y in 0..<(n - 1) {
      for x in 0..<(n - 1) {
        let d = dark[y * n + x]
        if d == dark[y * n + x + 1] && d == dark[(y + 1) * n + x] && d == dark[(y + 1) * n + x + 1] { p += 3 }
      }
    }
    let darkCount = dark.count(where: d => d)
    let total = n * n
    // The smallest k with the dark share within (45 + 5k)% to (55 + 5k)%.
    let k = ((darkCount * 20 - total * 10).abs() + total - 1) / total - 1
    return p + k * 10
  }
}

/// A line's 1:1:3:1:1 patterns with four light modules before or after
/// (outside the code: light).
fn finderLike(line: [bool]) -> int {
  let n = line.count()
  var count = 0
  for i in -4..(n - 7) {
    let core = at(line, i + 4) && !at(line, i + 5) && at(line, i + 6) && at(line, i + 7) && at(line, i + 8) && !at(line, i + 9) && at(line, i + 10)
    if !core { continue }
    let before = !at(line, i) && !at(line, i + 1) && !at(line, i + 2) && !at(line, i + 3)
    let after = !at(line, i + 11) && !at(line, i + 12) && !at(line, i + 13) && !at(line, i + 14)
    if before || after { count += 1 }
  }
  return count
}

fn at(line: [bool], i: int) -> bool = i >= 0 && i < line.count() && line[i]
