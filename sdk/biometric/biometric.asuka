// Package platform/biometric confirms it's the device's owner with Face ID,
// Touch ID or a fingerprint: to unlock the app, to confirm a payment,
// before showing a secret. iOS's and the Mac's LocalAuthentication,
// Android's BiometricPrompt, Windows Hello, and in a browser WebAuthn's
// platform authenticator. An app that imports it is given what it needs
// (iOS's NSFaceIDUsageDescription, which asuka.toml's ios.usage says
// better; Android's USE_BIOMETRIC).
//
//   do {
//     try await biometric.authenticate(reason: "Unlock your notes")
//     unlocked = true
//   } catch biometric.BiometricError.canceled {
//   }
//
// Linux has none: check answers .none and authenticate notAvailable.
// Apple Watch has no biometry: check answers .none with its passcode, and
// authenticate passes while the watch is unlocked on the wrist, else asks
// for the passcode (noPasscode: notAvailable).

/// The biometry a device has.
pub enum Kind {
  /// None, or none enrolled.
  none
  /// Touch ID, a fingerprint sensor.
  fingerprint
  /// Face ID, Android's face unlock (where it's strong), Windows Hello's
  /// camera.
  face
  /// Android's iris.
  iris
  /// Optic ID (Vision Pro).
  optic
}

/// What the device can do.
pub struct Status {
  /// Its biometry (on Android, the strongest kind it has, if it says).
  kind: Kind = .none
  /// The user has set a face or a finger up, so authenticate can use it.
  enrolled: bool = false
  /// The device has a passcode, PIN or pattern, which authenticate falls
  /// back to.
  passcode: bool = false
}

/// How authenticate ended, when it wasn't the owner.
pub enum BiometricError: Error {
  /// biometric: canceled
  canceled
  /// biometric: not available
  notAvailable
  /// biometric: not recognized
  failed
}

/// The platform's authenticator.
native interface Authenticator {
  async fn check() -> Status
  async fn authenticate(reason: string, cancel: string, noPasscode: bool)
}

// Made once; none where the platform has none.
let authenticator = try? Authenticator()

/// What the device can do: its biometry, whether it's set up, whether it
/// has a passcode.
pub async fn check() throws -> Status {
  if let a = authenticator {
    return try await a.check()
  }
  return Status()
}

/// Shows the system's prompt and returns if it was the owner; it throws
/// BiometricError.canceled (the user, the app or the system closed it),
/// notAvailable (no biometry and no passcode, none enrolled, locked out
/// after too many tries) or failed (it wasn't the owner). reason says
/// why, in the prompt (Android's title; iOS's subtitle, Touch ID's
/// message); cancel is the cancel button's title (default: the system's);
/// noPasscode leaves the passcode out: biometry only (on Android, a
/// strong one: Class 3).
pub async fn authenticate(reason: string, cancel: string = "", noPasscode: bool = false) throws {
  if let a = authenticator {
    try await a.authenticate(reason: reason, cancel: cancel, noPasscode: noPasscode)
    return
  }
  throw BiometricError.notAvailable
}
