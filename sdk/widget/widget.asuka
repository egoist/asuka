// Package platform/widget sets what the app's widgets show: iOS's WidgetKit
// widgets (an extension the CLI adds for asuka.toml's widgets, drawn from
// Entry), Apple Watch's complications (the widgets' circular,
// rectangular, inline and corner sizes, set by the watch app), Android's
// App Widgets. A kind is one of asuka.toml's widgets; its entries show in
// turn, each from its time. The desktops and the web have no widgets: set
// does nothing there.
//
//   widget.set("energy", widget.Entry(title: "Energy", value: "72%", progress: 0.72, showProgress: true))

import platform/host
import std/json
import std/time

/// What a widget shows.
pub struct Entry {
  title: string = ""
  /// The big value.
  value: string = ""
  body: string = ""
  /// A small line at the bottom.
  caption: string = ""
  /// An SF Symbol's name.
  symbol: string = ""
  /// From 0 to 1, shown with showProgress.
  progress: float = 0.0
  showProgress: bool = false
  /// A count down to this time (none: no count down).
  until: time.Time? = none
  /// "#rrggbb" or "#rrggbbaa".
  tint: string = ""
  /// What the app is opened with when the widget is tapped.
  url: string = ""
  /// When it shows (none: now).
  at: time.Time? = none
  /// The app's own layout, drawn in place of the template (whose fields
  /// above it doesn't show, but url's): at every size, but those sizes
  /// has its own for.
  layout: Layout? = none
  sizes: [Size: Layout] = [:]
}

/// A size a widget comes in (asuka.toml's widgets' sizes).
pub enum Size {
  small
  medium
  large
  /// iPad's.
  extraLarge
  /// The lock screen's (iOS), and Apple Watch's complications.
  circular
  rectangular
  inline
  /// A watch face's corner (Apple Watch).
  corner
}

struct Wire {
  title: string
  value: string
  body: string
  caption: string
  symbol: string
  progress: float
  showProgress: bool
  untilMs: int
  atMs: int
  tint: string
  url: string
  layout: Node?
  sizes: [string: Node]
}

struct Set {
  kind: string
  entries: [Wire]
}

fn sizesOf(m: [Size: Layout]) -> [string: Node] {
  var out: [string: Node] = [:]
  for (k, v) in m { out["{k}"] = nodeOf(v) }
  return out
}

/// Sets what the kind of widget shows: e now.
pub fn set(kind: string, e: Entry) = setAll(kind, [e])

/// Sets the kind's entries, each from its time.
pub fn setAll(kind: string, entries: [Entry]) = host.send("widget", "set", wire(kind, entries).bytes())

/// What set sends the host: the kind and its entries, in time order, as
/// JSON.
fn wire(kind: string, entries: [Entry]) -> string {
  let es = entries.sorted((a, b) => (a.at?.unixMilli() ?? 0) < (b.at?.unixMilli() ?? 0)).map(e => Wire(title: e.title, value: e.value, body: e.body, caption: e.caption,
    symbol: e.symbol, progress: e.progress, showProgress: e.showProgress, untilMs: e.until?.unixMilli() ?? 0, atMs: e.at?.unixMilli() ?? 0, tint: e.tint, url: e.url,
    layout: if let l = e.layout { nodeOf(l) } else { none }, sizes: sizesOf(e.sizes)))
  return json.encode(Set(kind: kind, entries: es))
}

/// Clears what the kind of widget shows.
pub fn clear(kind: string) = setAll(kind, [])
