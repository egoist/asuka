// Package platform/icloud is iCloud on iOS and macOS: whether there's an
// account, a key-value store of small values the user's devices share
// (Value), and the app's files in its iCloud containers, listed as they
// change, downloaded and uploaded by the system, with their conflicts.
// The app needs the iCloud capability (its containers' and key-value
// store's entitlements: docs/icloud.md).
//
//   let account = icloud.account()            // tracked
//   let files = icloud.files(.documents)      // tracked: as iCloud changes them
//   let size = icloud.Value("textSize", 17.0) // a store, kept in iCloud
//
// Elsewhere (Android, Windows, Linux, the web) there's no iCloud: the
// account isn't available, the lists are empty, a Value keeps its
// default, and the calls throw "icloud: not available".

import std/fs
import platform/host
import std/json
import std/time

/// The user's iCloud account, as the app sees it.
pub struct Account {
  /// Signed in, with iCloud Drive (or the key-value store) on for the app.
  available: bool = false
  /// The account's identity token, opaque: it changes when another
  /// account signs in.
  id: string = ""
}

/// Which of the app's files a list has.
pub enum Scope {
  /// In the containers' Documents: what iCloud Drive shows.
  documents
  /// The rest of the containers.
  data
}

/// Whether a file is on the device.
pub enum Status {
  /// Only in iCloud: readFile downloads it.
  notDownloaded
  /// On the device, an older version than iCloud's.
  downloaded
  current
}

/// One of the app's files in iCloud.
pub struct File {
  path: string = ""
  name: string = ""
  dir: bool = false
  size: int = 0
  created: time.Time = time.unix(0)
  modified: time.Time = time.unix(0)
  status: Status = .current
  downloading: bool = false
  /// From 0 to 1.
  downloadProgress: float = 0.0
  uploading: bool = false
  uploaded: bool = false
  uploadProgress: float = 0.0
  /// Other devices' versions wait to be settled (conflicts, resolve).
  conflicts: bool = false
  downloadError: string = ""
  uploadError: string = ""
}

/// A version of a file another device saved, in conflict with this
/// one's.
pub struct Version {
  id: string = ""
  path: string = ""
  name: string = ""
  modified: time.Time = time.unix(0)
  /// The device that saved it.
  device: string = ""
}

struct WireVersion {
  id: string = ""
  path: string = ""
  name: string = ""
  modified: int = 0
  device: string = ""
}

// What the hosts say (their methods and JSON).
struct WireFile {
  path: string = ""
  name: string = ""
  dir: bool = false
  size: int = 0
  created: int = 0
  modified: int = 0
  status: Status = .current
  downloading: bool = false
  downloadPercent: float = 0.0
  uploading: bool = false
  uploaded: bool = false
  uploadPercent: float = 0.0
  conflicts: bool = false
  downloadError: string = ""
  uploadError: string = ""
}

fn fileOf(w: WireFile) -> File = File(path: w.path, name: w.name, dir: w.dir, size: w.size, created: time.unixMilli(w.created), modified: time.unixMilli(w.modified), status: w.status, downloading: w.downloading, downloadProgress: w.downloadPercent / 100.0, uploading: w.uploading, uploaded: w.uploaded, uploadProgress: w.uploadPercent / 100.0, conflicts: w.conflicts, downloadError: w.downloadError, uploadError: w.uploadError)

struct Event {
  type: string = ""
  account: Account? = none
  reason: string = ""
  keys: [string] = []
  scope: string = ""
  files: [WireFile] = []
}

/// What iCloud says, as one value: the account, each scope's files, and
/// how many times each key changed on another device.
struct Seen {
  account: Account = Account()
  documents: [File] = []
  data: [File] = []
  changed: [string: int] = [:]
  all: int = 0
}

fn wireError(e: Error) -> Error {
  let m = e.message
  if host.unsupported(e) {
    return Error("icloud: not available")
  }
  if m.hasPrefix("icloud:") {
    return e
  }
  return Error("icloud: {m}")
}

async fn call(method: string, args: bytes) throws -> bytes {
  do {
    return try await host.call("icloud", method, args)
  } catch e {
    throw wireError(e)
  }
}

// The host's events, folded: one reader of its queue, while something
// reads what it knows (account, files, a Value).
fn follow() -> Stream<Seen> = Stream(give => {
  var seen = Seen()
  defer {
    host.send("icloud", "unwatch", json.encode(["scope": "documents"]).bytes())
    host.send("icloud", "unwatch", json.encode(["scope": "data"]).bytes())
  }
  let ab = (try? await call("account", bytes())) ?? bytes()
  let first: Account? = try? json.decode(ab.string())
  if let a = first {
    seen.account = a
    give(seen)
  }
  host.send("icloud", "watch", json.encode(["scope": "documents"]).bytes())
  host.send("icloud", "watch", json.encode(["scope": "data"]).bytes())
  for await b in host.next("icloud", "next") {
    let got: Event? = try? json.decode(b.string())
    if let e = got {
      match e.type {
        "account" => {
          if let a = e.account {
            seen.account = a
          }
        }
        "kv" => {
          if e.keys.isEmpty() {
            seen.all += 1
          }
          for k in e.keys {
            seen.changed[k] = (seen.changed[k] ?? 0) + 1
          }
        }
        "files" => {
          let fs = e.files.map(fileOf)
          if e.scope == "data" {
            seen.data = fs
          } else {
            seen.documents = fs
          }
        }
        _ => {}
      }
      give(seen)
    }
  }
})

let followed = live(Seen(), () => if let f = faked { followFake(f) } else { follow() })

/// The account, tracked: read in a binding, it follows sign-ins and
/// sign-outs while it's read.
pub fn account() -> Account = followed().account

/// The app's files in scope, tracked: as iCloud lists them, and again
/// as they change (here or on another device).
pub fn files(scope: Scope) -> [File] = match scope {
  .documents => followed().documents
  .data => followed().data
}

/// How many times key changed on another device (tracked).
fn changes(key: string) -> int {
  let s = followed()
  return (s.changed[key] ?? 0) + s.all
}

/// A value in iCloud's key-value store, shared by the user's devices: a
/// store whose value is def until iCloud's is read, then iCloud's, and
/// again as another device changes it; writing it keeps it in iCloud.
/// Small values only (a key is at most 64 bytes, all of an app's values
/// 1 MB). Without iCloud, it keeps def and what it's set to, here.
pub store Value<T>(key: string, def: T) {
  /// The value: def, then iCloud's once read, then another device's as it
  /// changes it. Setting it writes it to iCloud.
  pub state value: T = peek(def)
  state loaded = false

  let version = changes(key)

  task(version) {
    if let f = faked {
      if let text = f.values[key] {
        let v: T? = try? json.decode(text)
        if let x = v {
          value = x
        }
      }
      loaded = true
      return
    }
    do {
      let b = try await call("kvGet", key.bytes())
      if !b.isEmpty() {
        let v: T = try json.decode(b.string())
        value = v
      }
    } catch {}
    loaded = true
  }

  effect {
    let text = json.encode(value)
    if let f = faked {
      if loaded {
        f.kept(key, text)
      }
    } else if loaded {
      host.send("icloud", "kvSet", "\{\"key\":{json.encode(key)},\"value\":{text}}".bytes())
    }
  }
}

/// Takes key away from iCloud's key-value store.
pub async fn remove(key: string) throws {
  if let f = faked {
    f.values.remove(key)
    return
  }
  let _ = try await call("kvDelete", key.bytes())
}

/// The account now (not tracked).
pub async fn currentAccount() throws -> Account {
  if let f = faked {
    return f.account()
  }
  let b = try await call("account", bytes())
  return try json.decode(b.string())
}

/// The directory of the app's iCloud container id ("": its first),
/// set up if need be.
pub async fn container(id: string = "") throws -> string {
  if let f = faked {
    try f.need()
    try fs.mkdirAll(f.path("Documents"))
    return f.root
  }
  let b = try await call("container", id.bytes())
  return b.string()
}

/// The Documents directory of the app's first container: what iCloud
/// Drive shows of the app.
pub async fn documents() throws -> string {
  let c = try await container()
  return "{c}/Documents"
}

/// The files in scope now (not tracked).
pub async fn list(scope: Scope) throws -> [File] {
  if let f = faked {
    try f.need()
    return f.files(scope)
  }
  let b = try await call("files", json.encode(["scope": "{scope}"]).bytes())
  let ws: [WireFile] = try json.decode(b.string())
  return ws.map(fileOf)
}

/// Downloads path, if it's only in iCloud.
pub async fn download(path: string) throws {
  if let f = faked {
    try f.fetch(path)
    return
  }
  let _ = try await call("download", path.bytes())
}

/// Removes path's local copy, keeping it in iCloud.
pub async fn evict(path: string) throws {
  if let f = faked {
    try f.evict(path)
    return
  }
  let _ = try await call("evict", path.bytes())
}

/// path's bytes, downloaded first if it isn't here, read as iCloud
/// coordinates them with its own writes.
pub async fn readFile(path: string) throws -> bytes {
  if let f = faked {
    try f.fetch(path)
    return try fs.read(path)
  }
  return try await call("read", path.bytes())
}

/// Writes data to path (made with its directories), as iCloud
/// coordinates it; iCloud uploads it.
pub async fn writeFile(path: string, data: bytes) throws {
  if let f = faked {
    try f.need()
    try fs.mkdirAll(fs.dir(path))
    try fs.write(path, data)
    f.changed()
    return
  }
  let _ = try await call("write", host.str(path).concat(data))
}

/// Deletes path, here and in iCloud.
pub async fn delete(path: string) throws {
  if let f = faked {
    try? fs.remove(path)
    f.remote.remove(path)
    f.changed()
    return
  }
  let _ = try await call("delete", path.bytes())
}

/// Renames from to to, in iCloud.
pub async fn rename(from: string, to: string) throws {
  if let f = faked {
    try fs.rename(from, to)
    f.changed()
    return
  }
  let _ = try await call("move", json.encode(["from": from, "to": to]).bytes())
}

/// Moves the file of the device's at from (outside the containers) into
/// iCloud, at to (a path in a container): iCloud uploads it, and it's
/// gone from where it was.
pub async fn moveIn(from: string, to: string) throws {
  if let f = faked {
    try f.need()
    try fs.mkdirAll(fs.dir(to))
    try fs.rename(from, to)
    f.changed()
    return
  }
  let _ = try await call("moveIn", json.encode(["from": from, "to": to]).bytes())
}

/// Moves the file in iCloud at from out to the device, at to (outside
/// the containers): it's this device's alone, and gone from iCloud on
/// every device. A file only in iCloud is downloaded first.
pub async fn moveOut(from: string, to: string) throws {
  if let f = faked {
    try f.fetch(from)
    try fs.mkdirAll(fs.dir(to))
    try fs.rename(from, to)
    f.changed()
    return
  }
  let _ = try await call("moveOut", json.encode(["from": from, "to": to]).bytes())
}

/// A public link to a file in iCloud, which anyone who has it can
/// download a copy from, and when it stops working (none: as long as
/// the file is there).
pub struct Link {
  url: string
  expires: time.Time? = none
}

/// A public link to path's file in iCloud (uploaded first), to send to
/// someone: anyone with it downloads a copy (iCloud Drive's Copy Link).
pub async fn link(path: string) throws -> Link {
  if let f = faked {
    try f.need()
    if !fs.exists(path) && f.remote[path] == none {
      throw Error("icloud: no file at {path}")
    }
    return Link(url: "https://www.icloud.com/iclouddrive/test#{fs.base(path)}")
  }
  let b = try await call("link", path.bytes())
  let w: WireLink = try json.decode(b.string())
  return Link(url: w.url, expires: if w.expires > 0 { time.unixMilli(w.expires) } else { none })
}

struct WireLink {
  url: string = ""
  expires: int = 0
}

/// The versions other devices saved of path, in conflict with this one.
pub async fn conflicts(path: string) throws -> [Version] {
  if let f = faked {
    return f.versions.filter(v => v.path == path)
  }
  let b = try await call("versions", path.bytes())
  let ws: [WireVersion] = try json.decode(b.string())
  return ws.map(w => Version(id: w.id, path: w.path, name: w.name, modified: time.unixMilli(w.modified), device: w.device))
}

/// Settles path's conflict: keeping is the version to keep (another
/// device's), none to keep this device's; the others are removed.
pub async fn resolve(path: string, keeping: Version? = none) throws {
  if let f = faked {
    try f.settle(path, keeping?.id ?? "")
    return
  }
  let keep = keeping?.id ?? ""
  let _ = try await call("resolve", json.encode(["path": path, "keep": keep]).bytes())
}

// Testing

state faked: FakeICloud? = none

// followFake is what a fake iCloud says, again as it changes.
fn followFake(f: FakeICloud) -> Stream<Seen> = Stream(give => {
  let id = f.watch(() => give(f.seen()))
  defer { f.unwatch(id) }
  give(f.seen())
  await never()
})

/// iCloud a test drives: fake() installs one, signed in. Its container
/// is a directory of the app's (path("Documents/a.txt") is a file in it),
/// which the app's files are read from and written to. arrive() is
/// another device's new file, listed and not yet downloaded; change()
/// another device's key-value change; conflict() another device's
/// version of a file.
///
///   let ic = icloud.fake()
///   let app = mount(Journal())
///   ic.arrive("Documents/today.txt", "Rain all day.".bytes())
pub store FakeICloud {
  /// The user is signed in to iCloud (signOut, signIn change it): signed
  /// out, account() isn't available, files() lists nothing, and
  /// container, list, download, readFile and writeFile throw.
  pub state signedIn = true
  /// The signed-in account's identity token, as Account.id gives it.
  pub state id = "test"
  /// The container's directory.
  pub state root = fs.join([fs.appDir(), "icloud"])
  /// The key-value store's values, as JSON texts.
  pub state values: [string: string] = [:]
  /// Files only in iCloud, by their path, and their bytes.
  pub state remote: [string: bytes] = [:]
  /// The files downloaded (their paths).
  pub state downloads: [string] = []
  /// Other devices' versions, waiting to be settled, and their bytes.
  pub state versions: [Version] = []
  state versionData: [string: bytes] = [:]
  /// How many times another device changed each key.
  state kvChanges: [string: int] = [:]
  state watchers: [int: fn()] = [:]
  state nextID = 0

  /// The path of rel in the container.
  pub fn path(rel: string) -> string = fs.join([root, rel])

  /// The account as the app sees it: available while signed in, with id
  /// ("" when signed out).
  pub fn account() -> Account = Account(available: signedIn, id: if signedIn { id } else { "" })

  fn need() throws {
    if !signedIn {
      throw Error("icloud: not signed in")
    }
  }

  fn watch(f: fn()) -> int {
    nextID += 1
    watchers[nextID] = f
    return nextID
  }

  fn unwatch(i: int) {
    watchers.remove(i)
  }

  /// Tells what follows iCloud that it changed.
  fn changed() {
    for w in watchers.values() { w() }
  }

  fn seen() -> Seen = Seen(account: account(), documents: files(.documents), data: files(.data), changed: kvChanges)

  /// The files in scope: on the device (their status current), and those
  /// only in iCloud.
  fn files(scope: Scope) -> [File] {
    if !signedIn {
      return []
    }
    let dir = path("Documents")
    var out: [File] = []
    if scope == .documents {
      let entries = (try? fs.readDir(dir)) ?? []
      for e in entries {
        let p = fs.join([dir, e.name])
        out.push(File(path: p, name: e.name, dir: e.isDir, size: e.size, modified: e.modified, conflicts: versions.any(v => v.path == p)))
      }
    }
    for (p, data) in remote.keys().map(k => (k, remote[k] ?? bytes())) {
      let inDocs = fs.dir(p) == dir
      if inDocs == (scope == .documents) {
        out.push(File(path: p, name: fs.base(p), size: data.count(), status: .notDownloaded))
      }
    }
    return out
  }

  /// Another device's new file at rel: listed, not downloaded.
  pub fn arrive(rel: string, data: bytes) {
    remote[path(rel)] = data
    changed()
  }

  /// Whether the file at rel was downloaded.
  pub fn downloaded(rel: string) -> bool = downloads.contains(path(rel))

  fn fetch(p: string) throws {
    try need()
    if let data = remote[p] {
      try fs.mkdirAll(fs.dir(p))
      try fs.write(p, data)
      remote.remove(p)
      downloads.push(p)
      changed()
    }
  }

  fn evict(p: string) throws {
    let data = try fs.read(p)
    try fs.remove(p)
    remote[p] = data
    changed()
  }

  /// The value key keeps, as JSON ("" for none).
  pub fn value(key: string) -> string = values[key] ?? ""

  // The app's own change of key.
  fn kept(key: string, text: string) {
    values[key] = text
  }

  /// Another device changes key to value.
  pub fn change(key: string, value: float) {
    values[key] = json.encode(value)
    kvChanges[key] = (kvChanges[key] ?? 0) + 1
    changed()
  }

  /// Another device's version of the file at rel, in conflict with this
  /// one's.
  pub fn conflict(rel: string, data: bytes, device: string = "Another device") {
    nextID += 1
    let p = path(rel)
    let v = Version(id: "v{nextID}", path: p, name: fs.base(p), device: device)
    versions.push(v)
    versionData[v.id] = data
    changed()
  }

  fn settle(p: string, keep: string) throws {
    if !keep.isEmpty() {
      if let data = versionData[keep] {
        try fs.write(p, data)
      }
    }
    versions.removeWhere(v => v.path == p)
    changed()
  }

  /// The user signs out of iCloud.
  pub fn signOut() {
    signedIn = false
    changed()
  }

  /// The user signs in to iCloud as account (its identity token): a
  /// different one than before is another account.
  pub fn signIn(account: string) {
    id = account
    signedIn = true
    changed()
  }
}

/// Installs a fake iCloud, signed in, for the app's tests.
pub fn fake() -> FakeICloud {
  let f = FakeICloud()
  try? fs.removeAll(f.root)
  faked = f
  return f
}
