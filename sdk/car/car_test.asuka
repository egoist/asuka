// The car's screen on FakeCar: what the app's Screen shows, what
// choosing does, the car's back button.

let albums = ["Spring": ["Allegro", "Largo"], "Winter": ["Adagio"]]

component Library {
  state playing = ""
  state shown = true

  fn album(name: string) -> Template = .list(
    title: name,
    items: (albums[name] ?? []).map(t => Item(title: t, playing: t == playing, run: () => {
      playing = t
    })),
    actions: [.button(title: "Shuffle", run: () => { playing = "shuffled" })],
  )

  Column {
    Text("Playing: {playing}")
    if shown {
      Screen {
        root: .list(title: "Library", items: albums.keys().map(a => Item(title: a, browsable: true, run: () => push(() => album(a)))))
      }
    }
    Button("Hide") { on press { shown = false } }
    Text(if connected() { "In the car" } else { "Parked" })
  }
}

test "the root shows, and follows what it reads" {
  let c = fake()
  let app = mount(Library())
  await app.idle()
  expect(c.titles() == ["Library"])
  expect(c.texts() == ["Spring", "Winter"])
  app.expect("Parked")
  c.connect()
  await app.idle()
  app.expect("In the car")
}

test "choosing pushes, and the car's back button pops" {
  let c = fake()
  let app = mount(Library())
  await app.idle()
  try c.select("Spring")
  await app.idle()
  expect(c.titles() == ["Library", "Spring"])
  expect(depth() == 2)
  expect(c.texts() == ["Allegro", "Largo", "Shuffle"])
  try c.select("Largo")
  await app.idle()
  app.expect("Playing: Largo")
  // The pushed template follows the state it reads.
  expect(c.title() == "Spring")
  try c.select("Shuffle")
  await app.idle()
  app.expect("Playing: shuffled")
  c.back()
  await app.idle()
  expect(c.titles() == ["Library"])
  expect(depth() == 1)
}

test "nothing to choose throws" {
  let c = fake()
  let app = mount(Library())
  await app.idle()
  var failed = false
  do {
    try c.select("Summer")
  } catch e {
    failed = e.message.contains("Summer")
  }
  expect(failed)
}

test "pop, popToRoot, and a car that goes" {
  let c = fake()
  let app = mount(Library())
  await app.idle()
  try c.select("Spring")
  await app.idle()
  push(() => .message(title: "Done", text: "All played"))
  await app.idle()
  expect(c.titles() == ["Library", "Spring", "Done"])
  expect(c.texts() == ["All played"])
  pop()
  await app.idle()
  expect(c.titles() == ["Library", "Spring"])
  popToRoot()
  await app.idle()
  expect(c.titles() == ["Library"])
  c.connect()
  try c.select("Winter")
  await app.idle()
  c.disconnect()
  await app.idle()
  expect(c.titles() == ["Library"])
}

test "a Screen that goes leaves nothing" {
  let c = fake()
  let app = mount(Library())
  await app.idle()
  try c.select("Spring")
  await app.idle()
  app.tap("Hide")
  await app.idle()
  expect(c.titles() == [])
  expect(depth() == 1)
}

component Shop {
  Screen {
    root: .tabs([
      Tab(title: "Nearby", symbol: "mappin", content: .places(title: "Chargers", places: [
        Place(title: "Main St", detail: "2 free", latitude: 35.68, longitude: 139.76, run: () => push(() => .info(
          title: "Main St",
          fields: [Field(title: "Free", detail: "2 of 4"), Field(title: "Power", detail: "150 kW")],
          actions: [.button(title: "Reserve", run: () => pop()), .button(title: "Busy", disabled: true, run: () => pop())],
        ))),
      ])),
      Tab(title: "Favorites", symbol: "star", content: .grid(title: "Favorites", items: [Item(title: "Home", symbol: "house"), Item(title: "Work", symbol: "briefcase")])),
    ])
  }
}

test "tabs, places, info and their buttons" {
  let c = fake()
  let app = mount(Shop())
  await app.idle()
  expect(c.titles() == ["Nearby | Favorites"])
  expect(c.texts() == ["Main St"])
  try c.select("Main St")
  await app.idle()
  expect(c.title() == "Main St")
  expect(c.texts() == ["Free: 2 of 4", "Power: 150 kW", "Reserve", "Busy"])
  var disabled = false
  do {
    try c.select("Busy")
  } catch {
    disabled = true
  }
  expect(disabled)
  try c.select("Reserve")
  await app.idle()
  expect(c.titles() == ["Nearby | Favorites"])
}

test "nowPlaying" {
  let c = fake()
  let app = mount(Library())
  await app.idle()
  push(() => .nowPlaying)
  await app.idle()
  expect(c.title() == "Now Playing")
}

// A navigation app: routes to choose, then guidance over the map, the
// car's own end of the trip, alerts.
component Drive {
  state guiding = false
  state alerted = ""
  state closer: (fn())? = none

  let here = Coordinate(lat: 35.6812, lng: 139.7671)
  let office = Coordinate(lat: 35.6858, lng: 139.7745)

  fn preview() -> Preview? {
    if guiding {
      return none
    }
    return Preview(destination: "Office", at: office, routes: [
      Route(title: "Fastest", distance: 1200, time: 300s, path: [here, office], run: () => { guiding = true }),
      Route(title: "Quiet", detail: "No tolls", distance: 1500, time: 420s, path: [here, office], run: () => { guiding = true }),
    ])
  }

  fn trip() -> Trip? {
    if !guiding {
      return none
    }
    return Trip(destination: "Office", maneuvers: [
      Maneuver(instruction: "Turn right onto Main St", turn: .right, distance: 120),
      Maneuver(instruction: "Arrive at Office", turn: .arrive, distance: 900),
    ], distance: 1200, time: 300s, stop: () => { guiding = false })
  }

  Screen {
    root: .navigation(
      map: Map(position: here, route: if guiding { [here, office] } else { [] }, markers: [Marker(at: office, title: "Office")]),
      preview: preview(),
      trip: trip(),
      actions: if guiding { [.button(title: "End", run: () => { guiding = false })] } else { [] },
    )
  }

  Column {
    Text(if guiding { "Guiding" } else { "Choosing" })
    Text("Alert: {alerted}")
    Button("Warn") {
      on press {
        closer = alert(title: "Traffic ahead", detail: "10 min slower", actions: [.button(title: "Reroute", run: () => { alerted = "rerouted" })], onDismiss: () => { alerted = "dismissed" })
      }
    }
    Button("Close") {
      on press {
        if let f = closer {
          f()
        }
      }
    }
  }
}

test "a navigation map: routes to choose, then guidance" {
  let c = fake()
  let app = mount(Drive())
  await app.idle()
  expect(c.title() == "Office")
  expect(c.texts() == ["Fastest", "Quiet"])
  if let m = c.map() {
    expect(m.route.isEmpty())
    expect(m.markers.map(x => x.title) == ["Office"])
    expect(m.follow && m.zoom == 15)
  } else {
    expect(false)
  }
  try c.select("Quiet")
  await app.idle()
  app.expect("Guiding")
  expect(c.texts() == ["Turn right onto Main St", "Arrive at Office", "End"])
  expect((c.map()?.route.count() ?? 0) == 2)
  // The car ends the trip: its stop runs.
  try c.endTrip()
  await app.idle()
  app.expect("Choosing")
  var noTrip = false
  do {
    try c.endTrip()
  } catch {
    noTrip = true
  }
  expect(noTrip)
  // The app's own End.
  try c.select("Fastest")
  await app.idle()
  try c.select("End")
  await app.idle()
  app.expect("Choosing")
}

test "alerts over the map: a button, its time up, taken away" {
  let c = fake()
  let app = mount(Drive())
  await app.idle()
  expect(c.alert() == [])
  app.tap("Warn")
  await app.idle()
  expect(c.alert() == ["Traffic ahead", "10 min slower", "Reroute"])
  try c.select("Reroute")
  await app.idle()
  app.expect("Alert: rerouted")
  expect(c.alert() == [])
  app.tap("Warn")
  await app.idle()
  c.dismissAlert()
  await app.idle()
  app.expect("Alert: dismissed")
  // The function alert returns takes it away: its onDismiss runs.
  app.tap("Warn")
  await app.idle()
  expect(c.alert().count() == 3)
  app.tap("Close")
  await app.idle()
  expect(c.alert() == [])
  app.expect("Alert: dismissed")
}
