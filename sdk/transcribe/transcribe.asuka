// Package platform/transcribe turns a recording into text, on the device:
// nothing leaves it. The Speech framework on iOS and macOS, asked to
// stay on the device; Android's on-device recognizer (a file on Android
// 13 and later, listening on 12 and later); the browser's, where
// it has one on the device (Chrome 139 and later: the Web Speech API's
// processLocally); Windows' desktop speech
// recognizer (SAPI's dictation, English's with Windows, another
// language's with its language pack); on Linux, PocketSphinx where the
// distribution has it, in English. Where the device can't, it says so
// (TranscribeError.notAvailable) rather than sending the sound to a
// server. An app that imports it is given the
// permissions it needs: iOS's speech recognition, with its purpose
// string (asuka.toml's ios.usage.NSSpeechRecognitionUsageDescription says
// it better), and on Android the microphone's, which its recognizer asks
// for.
//
//   let r = try await transcribe.file(path)
//   text = r.text
//
//   for await h in transcribe.listen() {   // the microphone, as it's spoken
//     text = h.text
//   }

/// What transcribing fails with.
pub enum TranscribeError: Error {
  /// transcribe: not available on this device
  notAvailable
  /// transcribe: not allowed
  notAllowed
  /// transcribe: the language's model is downloading
  downloading
}

/// A word or a phrase, with where it is in the recording (seconds).
pub struct Segment {
  text: string
  start: float = 0
  duration: float = 0
}

/// What was said.
pub struct Result {
  text: string = ""
  /// The text's timing, where the platform gives it (iOS, macOS, Android
  /// 14 and later); empty elsewhere.
  segments: [Segment] = []
  /// The language it was recognized in.
  language: string = ""
}

/// What's been heard from the microphone so far (listen's).
pub struct Heard {
  /// Everything said since listening began, as the recognizer has it now:
  /// its last words may change as more comes.
  text: string = ""
  /// The last of them: the recognizer is done (finish was called, or it
  /// stopped hearing speech), and the text won't change.
  final: bool = false
}

/// What the device can do.
pub struct Availability {
  /// It can transcribe the language here.
  onDevice: bool = false
  /// The language asked for, or the device's.
  language: string = ""
}

/// The platform's recognizer. Its work is off the main thread.
native interface Recognizer {
  async fn check(language: string) -> Availability
  async fn file(path: string, language: string) -> Result
  /// Listens to the microphone, calling heard with what it's heard as it
  /// hears it, and returns once it's done (its last call's final); a
  /// cancelled task stops it.
  async fn listen(language: string, heard: fn(Heard))
  /// Stops listening to the microphone: what's been said is heard to its
  /// end, then listen returns.
  fn finish()
}

let recognizer = try? Recognizer()

fn rec() throws -> Recognizer {
  if let r = recognizer {
    return r
  }
  return try Recognizer()
}

/// Whether the device can transcribe a language (a BCP 47 tag; empty:
/// the device's), without asking the user anything.
pub async fn check(language: string = "") throws -> Availability {
  return try await rec().check(language)
}

/// Transcribes an audio file. It asks for what it needs the first time,
/// and takes a while: a long recording, some of its own length. A
/// recording with no speech in it is an empty Result. One at a time.
pub async fn file(path: string, language: string = "") throws -> Result {
  return try await rec().file(path, language)
}

/// Listens to the microphone and turns what the user says into text as
/// they say it, on the device: dictation. Each Heard has all the text so
/// far; the last is final, once finish is called or the recognizer stops
/// hearing speech. Stopping the task that reads it stops listening at
/// once. It asks for the microphone and speech recognition the first time.
///
///   for await h in transcribe.listen() {
///     draft = h.text
///   }
pub fn listen(language: string = "") -> Stream<Heard> = Stream(send => {
  try await rec().listen(language, heard: h => send(h))
})

/// Stops listening (listen's), keeping what's been said: its last Heard,
/// final, comes once the recognizer has it.
pub fn finish() {
  if let r = recognizer {
    try? r.finish()
  }
}
