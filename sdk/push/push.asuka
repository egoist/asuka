// Package platform/push is push notifications: register gives the token the
// app's server sends to (APNs' on iOS and macOS, FCM's on Android, the
// browser's push subscription on the web), and the pushes that come and
// are tapped come as streams. A push with an alert shows as a
// notification (platform/notify's categories, channels and present apply).
//
//   let r = try await push.register()
//   try await api.saveToken(r.token, r.service)
//   for await m in push.opened() { navigate(m.data["link"] ?? "/") }
//
// rewrite has the app change each push before it shows (decrypt it, set
// its title, make it a message): iOS's Notification Service Extension
// runs it, Android's Firebase service for data messages.
//
// Each platform's host does it as its apps do, through platform/host. On
// Apple TV a push shows no alert: it sets the badge, or reaches the app as
// data (received); none is opened.

import platform/host
import std/json
import platform/notify

/// Where the app's server sends to.
pub struct Registration {
  /// The device's token: APNs' (hex), FCM's, or the web's subscription
  /// (JSON).
  token: string = ""
  /// "apns", "fcm" or "webpush".
  service: string = ""
  /// The user allows the notifications pushes show.
  allowed: bool = false
}

/// A push: what it shows, and its data (the payload's keys).
pub struct Message {
  id: string = ""
  title: string = ""
  body: string = ""
  data: [string: string] = [:]
  subtitle: string = ""
  category: string = ""
  thread: string = ""
  channel: string = ""
  image: string = ""
  badge: int = 0
  summary: string = ""
  sender: notify.Person? = none
  conversation: notify.Conversation? = none

  /// Makes it a message: sender said its body in c (notify's from).
  fn from(sender: notify.Person, c: notify.Conversation) -> Message {
    var m = self
    m.sender = sender
    m.conversation = c
    return m
  }
}

/// Registers the device for pushes, asking the user to allow the
/// notifications they show (the first time), and answers where the
/// app's server sends to.
pub async fn register() throws -> Registration {
  let b = try await host.call("push", "register", bytes())
  return try json.decode(b.string())
}

/// The pushes the user taps (or acts on): the one that opened the app
/// too, which waits until this is read.
pub fn opened() -> Stream<Message> = messages("nextOpened")

/// The pushes that come while the app runs (and data messages that wake
/// it).
pub fn received() -> Stream<Message> = messages("nextReceived")

fn messages(method: string) -> Stream<Message> = Stream(give => {
  for await b in host.next("push", method) {
    let m: Message? = try? json.decode(b.string())
    if let x = m {
      give(x)
    }
  }
})

/// Has f change each push before it shows: decrypt an end-to-end
/// encrypted payload, set its title and body, attach an image (image, an
/// http(s) URL, downloaded), make it a message in a conversation (from),
/// set its thread and category. f answers the push to show; none, or a
/// thrown error, shows it as it came. Rewriting it again replaces f;
/// stopRewriting ends it.
///
/// iOS: a Notification Service Extension, which asuka build makes for an
/// app that uses rewrite, runs the app (its root without a screen, as a
/// background launch does: inExtension() is true there) for each push
/// with "mutable-content": 1 and an alert in its aps, within about 30
/// seconds; f runs once the app has called rewrite. What the app keeps is
/// the same there (the App Group the two share). A rewrite can't hide a
/// push on iOS.
///
/// Android: FCM's data messages are rewritten in the app's process
/// (started without a screen if it isn't running), within about ten
/// seconds, then shown; one whose rewrite leaves no title or body
/// doesn't show. A notification message that comes with the app in the
/// background is shown by Firebase, without a rewrite: send data
/// messages.
///
/// The pushes are rewritten one at a time, in the order they came.
pub fn rewrite(f: async fn(Message) throws -> Message?) {
  rewriter.set(f)
}

/// Stops rewriting: pushes show as they came.
pub fn stopRewriting() {
  rewriter.clear()
}

/// Whether the app runs in iOS's Notification Service Extension, only to
/// rewrite a push: its root shows nothing there, so an app may make it
/// one that only calls rewrite (if push.inExtension() { Rewrites() }
/// else { Root() }), not its screens.
pub fn inExtension() -> bool = host.process() == "notification"

// What rewrites, and its task: the host hands over each push
// ("nextRewrite": a token and the message), and waits for the answer
// ("rewritten": the token, ok, and the notification to show).
store Rewriter {
  state f: (async fn(Message) throws -> Message?)? = none
  state on = false

  fn set(g: async fn(Message) throws -> Message?) {
    f = g
    on = true
  }

  fn clear() {
    f = none
    on = false
  }

  task(on) {
    if !on {
      return
    }
    // A host with no push module: nothing comes.
    do {
      for await b in host.next("push", "nextRewrite") {
        let req: Request? = try? json.decode(b.string())
        if let r = req {
          if let out = await rewritten(r.message) {
            host.send("push", "rewritten", shown(r.token, out).bytes())
          } else {
            host.send("push", "rewritten", json.encode(NoAnswer(token: r.token, ok: false)).bytes())
          }
        }
      }
    } catch e {
      if !host.unsupported(e) { throw e }
    }
  }

  /// What f makes of m: none when there's no f, it gave none or threw.
  async fn rewritten(m: Message) -> Message? {
    if let g = f {
      do {
        return try await g(m)
      } catch e {
        return none
      }
    }
    return none
  }
}

let rewriter = Rewriter()

struct Request {
  token: string = ""
  message: Message = Message()
}

// The answers: the notification to show (platform/notify's spec), or the
// push as it came.
struct Answer<T> {
  token: string
  ok: bool
  spec: T
}

struct NoAnswer {
  token: string
  ok: bool
}

/// The answer that shows m (platform/notify's spec, as the hosts take it):
/// a message's ID is its conversation's (on Android, the conversation's
/// one notification).
fn shown(token: string, m: Message) -> string {
  let n = notify.Notification(id: if m.sender.isSome() { "" } else { m.id }, title: m.title, body: m.body, url: m.data["url"] ?? "", subtitle: m.subtitle, data: m.data, category: m.category, thread: m.thread, summary: m.summary, channel: m.channel, badge: m.badge, image: m.image)
  let c = if m.sender.isSome() { m.conversation ?? notify.Conversation() } else { none }
  return json.encode(Answer(token: token, ok: true, spec: notify.specOf(n, m.sender, c)))
}

/// A push that comes, for a test: what shows of m after the app's
/// rewrite (m itself when there's none, or it gave none or threw). On
/// the fake host nothing else hands the app a push.
pub async fn fakeRewrite(m: Message) -> Message = (await rewriter.rewritten(m)) ?? m
