// Package platform/secure keeps small secrets (tokens, passwords) encrypted
// by the platform: the Keychain on iOS and the Mac; on Android, values
// sealed with a key in the Android Keystore; Windows' Credential
// Manager; the user's keyring on Linux (libsecret: GNOME Keyring,
// KWallet); on the web, IndexedDB under a WebCrypto key the page can use
// but not read (a web app's best, not a keychain). For secrets, not data:
// std/store keeps the rest.
//
//   try await secure.write("token", token)
//   let token = try await secure.read("token") ?? ""
//   try await secure.remove("token")
//
// The names are std/store's (read, write, remove). A secret written
// protected is read only once the user proves it's them (Face ID, a
// fingerprint, Windows Hello, the device's passcode), as Expo's
// requireAuthentication:
//
//   try await secure.write("vault", key, protected: true)
//   let key = try await secure.read("vault", prompt: "Unlock your vault")

/// The platform's keychain.
native interface Keychain {
  /// key's value; none if there's none. A protected one asks the user
  /// first, saying prompt.
  async fn get(key: string, prompt: string) -> string?
  /// Keeps value as key's, replacing what was there; protected: read only
  /// once the user proves it's them.
  async fn set(key: string, value: string, protected: bool)
  /// Forgets key (nothing there is no error).
  async fn remove(key: string)
}

/// Why a protected secret wasn't read or written.
pub enum SecureError: Error {
  /// The user cancelled the question, or didn't prove it's them.
  cancelled
  /// The device can't ask: no passcode set, no Face ID, fingerprint or
  /// Windows Hello enrolled, or a platform without (Linux, the web).
  notAvailable

  /// The error's text.
  fn message() -> string = match self {
    .cancelled => "secure: the user didn't unlock it"
    .notAvailable => "secure: this device can't protect a secret with the user's face, fingerprint or passcode"
  }
}

// Made once; none where the platform has no code for it.
let keychain = try? Keychain()

fn made() throws -> Keychain {
  if let k = keychain {
    return k
  }
  throw Error("unsupported: no secure store here")
}

/// Keeps value as key's, encrypted by the platform, replacing what was
/// there. protected: reading it asks the user to prove it's them first
/// (Face ID or Touch ID, or the passcode, on iOS and the Mac; on Apple
/// Watch, the watch unlocked on the wrist, else its passcode; the
/// fingerprint, face or screen lock on Android; Windows Hello); where the
/// device can't ask (no passcode, nothing enrolled, Linux, the web), it
/// throws SecureError.notAvailable and keeps nothing.
pub async fn write(key: string, value: string, protected: bool = false) throws {
  try await made().set(key: key, value: value, protected: protected)
}

/// key's value; none if there's none. A protected one shows the system's
/// question first, saying prompt ("Unlock your notes"; empty: the
/// platform's own words), and throws SecureError.cancelled if the user
/// doesn't unlock it.
pub async fn read(key: string, prompt: string = "") throws -> string? {
  return try await made().get(key: key, prompt: prompt)
}

/// Forgets key; nothing there is no error.
pub async fn remove(key: string) throws {
  try await made().remove(key: key)
}
