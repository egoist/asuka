test "rich text's plain text, for the apps that paste text" {
  expect(plainOf("<p>Hello <b>there</b></p><p>Two &amp; three</p>") == "Hello there\nTwo & three")
  expect(plainOf("<ul><li>One</li><li>Two</li></ul>") == "One\nTwo")
  expect(plainOf("a<br>b<br/>c") == "a\nb\nc")
  expect(plainOf("<style>p \{ color: red }</style><p>Shown</p>") == "Shown")
  expect(plainOf("x &lt;y&gt; &quot;z&quot;&nbsp;") == "x <y> \"z\"")
  expect(plainOf("no tags") == "no tags")
}

test "no platform, no rich clipboard" {
  var said = ""
  do {
    let _ = try await clipboardHTML()
  } catch e {
    said = e.message
  }
  expect(said.contains("unsupported"))
}

test "no platform, no picker" {
  var said = ""
  do {
    let _ = try await pickMedia(kind: .videos)
  } catch e {
    said = e.message
  }
  expect(said.contains("unsupported"))
}

test "clipboard formats: their types as the platforms take them, each once" {
  let png = bytes([0x89, 0x50])
  let got = try checkedFormats([
    ClipboardFormat(type: " Application/X.Drawing+JSON ", data: "[1]".bytes()),
    ClipboardFormat(type: "com.example.Drawing", data: png),
    ClipboardFormat(type: "text/plain", data: "a drawing".bytes()),
  ])
  expect(got.map(f => f.type) == ["application/x.drawing+json", "com.example.Drawing", "text/plain"])
  expect(got[1].data == png)
  // HTML without text: its text with it, for the apps that paste text.
  let rich = try checkedFormats([ClipboardFormat(type: "text/html", data: "<p>Hi <b>there</b></p>".bytes())])
  expect(rich.map(f => f.type) == ["text/html", "text/plain"] && rich[1].data.string() == "Hi there")
  var said: [string] = []
  let bad: [[ClipboardFormat]] = [[], [ClipboardFormat(type: "  ", data: png)],
    [ClipboardFormat(type: "image/png", data: png), ClipboardFormat(type: "IMAGE/PNG", data: png)]]
  for formats in bad {
    do {
      let _ = try checkedFormats(formats)
    } catch e {
      said.push(e.message)
    }
  }
  expect(said == ["device: no formats to copy", "device: a clipboard format needs a type", "device: the clipboard format image/png is given twice"])
}

test "no platform, no files or formats on the clipboard" {
  var said: [string] = []
  do {
    let _ = try await clipboardFiles()
  } catch e {
    said.push(e.message)
  }
  do {
    try await copyData("application/x.drawing+json", "[1]".bytes(), text: "a drawing")
  } catch e {
    said.push(e.message)
  }
  do {
    try await copyFiles([])
  } catch e {
    said.push(e.message)
  }
  expect(said.count() == 3 && said[0].contains("unsupported") && said[1].contains("unsupported"))
  expect(said[2] == "device: no files to copy")
}

test "the fake picker: the kind asked, at most max, in the order picked" {
  let f = fakePicker()
  f.picked = [
    Media(path: "/c/a.heic", type: "image/heic", width: 4032, height: 3024),
    Media(path: "/c/b.mov", type: "video/quicktime", video: true, width: 1920, height: 1080, duration: 8s),
    Media(path: "/c/c.jpg", type: "image/jpeg"),
  ]
  expect((try await pickMedia()).map(m => m.path) == ["/c/a.heic"])
  expect((try await pickMedia(kind: .videos, max: 0)).map(m => m.duration) == [8s])
  expect((try await pickMedia(kind: .all, max: 2, ordered: true)).map(m => m.path) == ["/c/a.heic", "/c/b.mov"])
  expect((try await pickMedia(max: 0)).map(m => m.path) == ["/c/a.heic", "/c/c.jpg"])
  expect(try await pickPhotos(max: 0) == ["/c/a.heic"])
  let _ = try await pickMedia(max: 999, maxSize: -1, quality: 0.7)
  expect(f.asked == [
    PickRequest(kind: .images, max: 1, ordered: false, maxSize: 0, quality: 0),
    PickRequest(kind: .videos, max: 0, ordered: false, maxSize: 0, quality: 0),
    PickRequest(kind: .all, max: 2, ordered: true, maxSize: 0, quality: 0),
    PickRequest(kind: .images, max: 0, ordered: false, maxSize: 0, quality: 0),
    PickRequest(kind: .images, max: 1, ordered: false, maxSize: 0, quality: 0),
    PickRequest(kind: .images, max: 255, ordered: false, maxSize: 0, quality: 0.7),
  ])
  f.picked = []
  expect((try await pickMedia(kind: .all)).isEmpty())
}
