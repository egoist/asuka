// Package platform/device is what the platform offers apps beyond views:
// what device it is, links opened in other apps and in its in-app
// browser, the share sheet, haptic feedback, its photo and document
// pickers, the clipboard (text, images, rich text, files and an app's
// own formats), and keeping the screen on.
//
//   let info = try await device.info()          // "iPhone", "iOS", "26.0"
//   device.openURL("mailto:hi@example.com")     // in the app that takes it
//   try await device.browse("https://go.dev")   // in the app
//   device.share("https://go.dev")              // the share sheet
//   device.haptic(.success)
//   device.copy("Copied")
//   let photos = try await device.pickPhotos(max: 3)
//   if let text = try await device.clipboardText() { paste(text) }
//
// The pickers need no permission: PHPicker and the document picker on
// iOS, the Photo Picker and the storage picker on Android, the system's
// open dialog on desktops, the browser's file picker. What they give are
// copies in the app's caches, the app's to keep or move. Apple TV and
// Apple Watch have no browser, pickers or clipboard: browse and the
// pickers throw unsupported there, and the clipboard is empty.

import std/time

/// The device and the app.
pub struct Info {
  /// "iPhone", "Apple TV", "Apple Watch", "Pixel 9", "Mac", "PC".
  model: string = ""
  /// "iOS", "tvOS", "watchOS", "Android", "macOS", "Windows", "Linux".
  system: string = ""
  /// "26.0", "16".
  systemVersion: string = ""
  /// asuka.toml's version.
  appVersion: string = ""
  /// asuka.toml's build.
  build: string = ""
  /// Where the app came from: a store, TestFlight, a download, a
  /// developer's build.
  source: InstallSource = .unknown
  /// When it was installed on this device (iOS, Android, the desktops);
  /// none where the platform doesn't say (the web).
  installedAt: time.Time? = none
  /// When this version of it was installed: an update's time, else
  /// installedAt.
  updatedAt: time.Time? = none
}

/// Info as the platform's code makes it: its times as milliseconds since
/// 1970 (0: none), which Info's are made of.
struct NativeInfo {
  model: string = ""
  system: string = ""
  systemVersion: string = ""
  appVersion: string = ""
  build: string = ""
  source: InstallSource = .unknown
  installedMs: int = 0
  updatedMs: int = 0
}

/// Where an app came from, as its platform tells: to show a beta's
/// banner, to point a sideloaded copy at the store.
pub enum InstallSource {
  /// The platform doesn't say (the web).
  unknown
  /// The App Store, the Mac App Store.
  appStore
  /// TestFlight: a beta, from App Store Connect.
  testFlight
  /// Google Play.
  playStore
  /// Another store: an Android one (Galaxy Store, F-Droid), the Microsoft
  /// Store, Flathub.
  otherStore
  /// Not from a store: a download, an installer, a sideloaded APK.
  direct
  /// A developer's build: asuka dev's, the simulator's, a debug build.
  development
}

/// A file the user picked.
pub struct File {
  /// A copy in the app's caches: the app's to keep or move.
  path: string
  /// Its name where it was ("Invoice.pdf").
  name: string
  /// Its MIME type, if known ("application/pdf").
  type: string = ""
  /// Its size, in bytes.
  size: int = 0
}

/// What a media picker offers.
pub enum MediaKind {
  /// Photos and other images.
  images
  videos
  /// Images and videos.
  all
}

/// A photo or a video the user picked: a copy in the app's caches, the
/// app's to keep or move.
pub struct Media {
  path: string
  /// Its name where it was ("IMG_0042.HEIC"), where the platform says.
  name: string = ""
  /// Its MIME type ("image/jpeg", "video/quicktime"), if known.
  type: string = ""
  /// It's a video.
  video: bool = false
  /// Its size in pixels, upright (0: not known).
  width: int = 0
  height: int = 0
  /// A video's length (0s for an image, or not known).
  duration: Duration = 0s
  /// Its size, in bytes.
  size: int = 0
}

/// Media as the platform's code makes it: its duration in milliseconds.
struct NativeMedia {
  path: string = ""
  name: string = ""
  type: string = ""
  video: bool = false
  width: int = 0
  height: int = 0
  durationMs: int = 0
  size: int = 0
}

/// What the clipboard holds, said without reading it (iOS doesn't ask
/// the user for this): to show a Paste button only when there's
/// something to paste.
pub struct ClipboardKinds {
  text: bool = false
  image: bool = false
  url: bool = false
  /// Rich text: what a browser, a mail or a document copied, as HTML.
  html: bool = false
  /// Files: what a file manager copied (Finder, Explorer, Files, GNOME's
  /// Files), or copyFiles. On phones and the web an image counts too
  /// (clipboardFiles gives it as a file).
  files: bool = false
}

/// One format of what copyFormats puts on the clipboard together: an
/// app's own data, with others for the apps that don't know it.
pub struct ClipboardFormat {
  /// Its type: a MIME type ("application/x.drawing+json", "text/plain",
  /// "text/html", "image/png"), each platform's own for the ones it
  /// knows; one without a "/" is the platform's name as it is (a UTI on
  /// Apple platforms, a registered format's on Windows, an X11 target's
  /// on Linux).
  type: string
  /// Its data: text/plain's and text/html's as UTF-8.
  data: bytes
}

/// The platform's side.
native interface Platform {
  /// The device and the app.
  async fn info() -> NativeInfo
  /// Shows a web page in the app (or the browser, on desktops).
  async fn browse(url: string)
  /// The photo picker, for up to max (0: any number) of kind, in the
  /// order picked (ordered: the picker numbers them); images scaled to
  /// maxSize on their long side and written as JPEGs of quality when
  /// either isn't 0.
  async fn pickMedia(kind: MediaKind, max: int, ordered: bool, maxSize: int, quality: float) -> [NativeMedia]
  /// The document picker (types: MIME types, none: any file).
  async fn pickFiles(types: [string], multiple: bool) -> [File]
  /// The clipboard's text; none if it has none.
  async fn clipboardText() -> string?
  /// What the clipboard holds.
  async fn clipboardHas() -> ClipboardKinds
  /// The clipboard's image, as a file in the app's caches; none if it
  /// has none.
  async fn clipboardImage() -> string?
  /// Puts the image file at path on the clipboard.
  async fn copyImage(path: string)
  /// The clipboard's rich text as HTML; none if it has none.
  async fn clipboardHTML() -> string?
  /// Puts html on the clipboard, with text for the apps that paste
  /// plain text.
  async fn copyHTML(html: string, text: string)
  /// The files on the clipboard: their paths (the desktops'), or copies
  /// in the app's caches (phones, the web); none if it has none.
  async fn clipboardFiles() -> [string]
  /// Puts the files at paths on the clipboard.
  async fn copyFiles(paths: [string])
  /// The formats on the clipboard, as MIME types where known.
  async fn clipboardFormats() -> [string]
  /// The clipboard's data of type; none if it has none.
  async fn clipboardData(type: string) -> bytes?
  /// Puts formats on the clipboard together, in place of what it held.
  async fn copyFormats(formats: [ClipboardFormat])
  /// Calls changed with what the clipboard holds at each change, until
  /// the task is cancelled.
  async fn watchClipboard(changed: fn(ClipboardKinds))
  /// Keeps the screen on while on.
  /// @mainThread
  fn keepAwake(on: bool)
  /// Opens the app's page of the system's settings; false where there's
  /// none.
  /// @mainThread
  fn openSettings() -> bool
}

// Made once; none where the platform has no code for it.
let platform = try? Platform()

fn made() throws -> Platform {
  if let p = platform {
    return p
  }
  throw Error("unsupported: no device here")
}

/// The device and the app.
pub async fn info() throws -> Info {
  let n = try await made().info()
  let at = (ms: int) => if ms > 0 { time.unixMilli(ms) } else { none }
  return Info(model: n.model, system: n.system, systemVersion: n.systemVersion, appVersion: n.appVersion, build: n.build,
    source: n.source, installedAt: at(n.installedMs), updatedAt: at(n.updatedMs))
}

/// Asks the system to open url in the app that takes it: a web address in
/// the browser, another scheme (tel:, mailto:, another app's) in the app
/// that handles it. browse shows a web page in the app instead.
pub native fn openURL(url: string)

/// Opens the app's page of the system's settings, where the user turns
/// on what they once said no to (the camera, notifications, location):
/// the app's Settings page on iOS, its App info on Android; on a Mac and
/// Windows, which have no page for an app, Privacy & Security. Returns
/// false where there's nothing to open (Apple Watch, Linux, the web,
/// asuka test).
pub fn openSettings() -> bool {
  if let p = platform {
    return (try? p.openSettings()) ?? false
  }
  return false
}

/// Shows a web page in the app, over it: SFSafariViewController on iOS,
/// a Custom Tab on Android; desktops and the web open it in the user's
/// browser. (openURL leaves the app for the browser on phones too.)
pub async fn browse(url: string) throws {
  try await made().browse(url: url)
}

/// Shows the system's photo picker for up to max images (no permission
/// asked) and returns their files, which Image shows; none if the user
/// cancelled. pickMedia picks videos too, and scales images down.
pub async fn pickPhotos(max: int = 1) throws -> [string] {
  let picked = try await pickMedia(kind: .images, max: if max < 1 { 1 } else { max })
  return picked.map(m => m.path)
}

/// Shows the system's photo picker (no permission asked) for images,
/// videos or both, up to max of them (0: as many as the user likes, up
/// to the platform's limit), and returns copies of what was picked in the
/// order it was picked; none if the user cancelled. ordered numbers them
/// as they're picked (iOS, Android's photo picker). An image is given as
/// it is (a HEIC stays HEIC) unless maxSize or quality is set: then it's
/// scaled down to at most maxSize pixels on its long side (0: as it is)
/// and written upright as a JPEG of quality (0 to 1; 0: 0.9). Videos are
/// given as they are.
pub async fn pickMedia(kind: MediaKind = .images, max: int = 1, ordered: bool = false, maxSize: int = 0, quality: float = 0) throws -> [Media] {
  var n = max
  if n < 0 { n = 0 }
  if n > 255 { n = 255 }
  let size = if maxSize < 0 { 0 } else { maxSize }
  let q = if quality < 0 || quality > 1 { 0.0 } else { quality }
  if let f = fakedPicker {
    f.asked = f.asked + [PickRequest(kind: kind, max: n, ordered: ordered, maxSize: size, quality: q)]
    let all = f.picked.filter(m => kind == .all || m.video == (kind == .videos))
    if n > 0 && all.count() > n {
      return all.prefix(n)
    }
    return all
  }
  let ms = try await made().pickMedia(kind: kind, max: n, ordered: ordered, maxSize: size, quality: q)
  return ms.map(m => Media(path: m.path, name: m.name, type: m.type, video: m.video, width: m.width, height: m.height,
    duration: m.durationMs * 1ms, size: m.size))
}

/// Shows the system's document picker (no permission asked) and returns
/// copies of the files picked, none if the user cancelled. types are MIME
/// types ("application/pdf", "image/*", "text/csv"); none: any file.
pub async fn pickFiles(types: [string] = [], multiple: bool = false) throws -> [File] {
  return try await made().pickFiles(types: types, multiple: multiple)
}

/// Shows the system's share sheet for a text or a link: a Mac's share
/// menu, Windows' share UI, the browser's Web Share sheet. Linux has
/// none: the text goes on the clipboard, with a toast (as a browser
/// without one does).
pub native fn share(text: string)

/// Shows the share sheet for files (their paths): a video to send, a PDF
/// to save to Files, photos for AirDrop. It returns once the sheet is
/// gone, whether the user shared or not (Windows: once it shows), and
/// throws when it couldn't show (a file that isn't there). mime is the
/// files' type, which the apps on the sheet go by (default: from the
/// first file's extension); uti is iOS's Uniform Type Identifier
/// (com.adobe.pdf), ahead of mime; title the sheet's (Android's chooser,
/// a mail's subject on iOS); from the view the sheet points at where it's
/// a popover (an iPad, a Mac), usually the button that shares (none: the
/// screen's middle). Linux has no share sheet: the files go on the
/// clipboard; a browser without Web Share for files downloads each.
pub async fn shareFiles(paths: [string], mime: string = "", uti: string = "", title: string = "", from: Ref? = none) throws {
  try await coreShareFiles(paths, mime, uti, title, from)
}

native async fn coreShareFiles(paths: [string], mime: string, uti: string, title: string, from: Ref?) throws

/// Haptic feedback, from the lightest to a result's.
pub enum Haptic {
  /// A selection changing: a picker's value, a segment.
  selection
  /// A light impact: a small element snapping into place.
  light
  /// A medium impact.
  medium
  /// A heavy impact: a large element landing.
  heavy
  /// A task succeeded.
  success
  /// A task produced a warning.
  warning
  /// A task failed.
  error
}

/// Plays haptic feedback: UIFeedbackGenerator on iOS,
/// performHapticFeedback on Android. A Mac plays the trackpad's (a Force
/// Touch trackpad: an alignment for selection, a level change for the
/// rest); a browser vibrates where it can (Chrome on Android); Windows
/// and Linux have no haptics, and do nothing.
pub native fn haptic(kind: Haptic)

/// Puts text on the clipboard (copyImage puts an image there).
pub native fn copy(text: string)

/// The clipboard's text, none if it has none (copy writes it). iOS asks
/// the user the first time an app reads what another app put there.
pub async fn clipboardText() throws -> string? {
  return try await made().clipboardText()
}

/// What the clipboard holds, without reading it.
pub async fn clipboardHas() throws -> ClipboardKinds {
  return try await made().clipboardHas()
}

/// The clipboard's image, read into a file in the app's caches in the
/// format the copying app gave it (PNG, JPEG, HEIC...: its extension
/// says); none if it has none. iOS asks the user the first time the app
/// reads what another app put there.
pub async fn clipboardImage() throws -> string? {
  return try await made().clipboardImage()
}

/// The clipboard's rich text, as HTML (what a browser, a mail or a word
/// processor copied: its bold, links, lists), none if it has none (only
/// plain text, or nothing): Electron's clipboard.readHTML. iOS asks, as
/// clipboardText does.
pub async fn clipboardHTML() throws -> string? {
  return try await made().clipboardHTML()
}

/// Puts rich text on the clipboard: html for the apps that paste it
/// (mail, notes, documents), text for those that paste plain text
/// (empty: html's text, its tags left out).
pub async fn copyHTML(html: string, text: string = "") throws {
  try await made().copyHTML(html: html, text: if text.isEmpty() { plainOf(html) } else { text })
}

/// s before sep's first place and after it, and whether it's there (else
/// s and "").
fn cutAt(s: string, sep: string) -> (string, string, bool) {
  if let i = s.find(sep) {
    return (s.byteSlice(0, i), s.byteSlice(i + sep.byteCount()), true)
  }
  return (s, "", false)
}

/// html's text: its tags left out (a style's and a script's contents
/// too), its common entities read, a line for each <br>, paragraph,
/// heading, list item and table row.
fn plainOf(html: string) -> string {
  let lines = ["br", "p", "div", "li", "tr", "h1", "h2", "h3", "h4", "h5", "h6"]
  var out = ""
  var rest = html
  while true {
    let (before, after, found) = cutAt(rest, "<")
    out += before
    if !found { break }
    let (tag, tail, closed) = cutAt(after, ">")
    if !closed { break }
    let name = tag.trimPrefix("/").split(" ")[0].trimSuffix("/").lower()
    rest = tail
    if (name == "style" || name == "script") && !tag.hasPrefix("/") {
      let (_, past, _) = cutAt(rest, "</{name}>")
      rest = past
      continue
    }
    if lines.contains(name) && !out.isEmpty() && !out.hasSuffix("\n") {
      out += "\n"
    }
  }
  let text = out.replace("&nbsp;", " ").replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&#39;", "'").replace("&amp;", "&")
  return text.trim()
}

/// Puts the image file at path (PNG, JPEG, HEIC...) on the clipboard,
/// for pasting in another app.
pub async fn copyImage(path: string) throws {
  try await made().copyImage(path: path)
}

/// The files on the clipboard (what a file manager copied, or
/// copyFiles), in order; none if it has none. On a Mac, Windows and Linux
/// they're the files' own paths, to read or copy (not the app's to move);
/// on iOS, Android and the web they're copies in the app's caches, the
/// app's to keep or move, and an image on the clipboard counts as a file.
/// iOS asks the user the first time the app reads what another app put
/// there.
pub async fn clipboardFiles() throws -> [string] {
  return try await made().clipboardFiles()
}

/// Puts the files at paths on the clipboard, for pasting in a file
/// manager (Finder, Explorer, GNOME's Files: a copy, not a move) or an
/// app that takes files (a mail, a chat). On iOS and Android each file's
/// content goes with its name (Files, Mail and the like paste it); a
/// browser can't put files there: it throws unsupported.
pub async fn copyFiles(paths: [string]) throws {
  if paths.isEmpty() {
    throw Error("device: no files to copy")
  }
  try await made().copyFiles(paths: paths)
}

/// The formats on the clipboard now, without reading their data: MIME
/// types where the platform's name has one ("text/plain", "text/html",
/// "image/png", an app's "application/x.drawing+json"), else the
/// platform's own name (a UTI, a Windows format's name, an X11 target).
/// What clipboardData reads, as Electron's clipboard.availableFormats.
pub async fn clipboardFormats() throws -> [string] {
  return try await made().clipboardFormats()
}

/// The clipboard's data of type, none if it has none: an app's own
/// format that copyData or copyFormats put there (here or in another copy
/// of the app), or another app's (type as clipboardFormats names it).
/// text/plain's and text/html's come as UTF-8. iOS asks, as clipboardText
/// does; a browser reads only text/plain, text/html, image/png and the
/// formats a page put (Chrome's web custom formats).
pub async fn clipboardData(type: string) throws -> bytes? {
  let t = formatType(type)
  if t.isEmpty() {
    throw Error("device: a clipboard format needs a type")
  }
  return try await made().clipboardData(type: t)
}

/// Puts data of type (an app's own format: a MIME type, see
/// ClipboardFormat) on the clipboard, with text for the apps that paste
/// plain text (empty: none), as Electron's clipboard.writeBuffer. Another
/// copy of the app (or an app that knows the type) reads it back with
/// clipboardData.
pub async fn copyData(type: string, data: bytes, text: string = "") throws {
  var formats = [ClipboardFormat(type: type, data: data)]
  if !text.isEmpty() {
    formats.push(ClipboardFormat(type: "text/plain", data: text.bytes()))
  }
  try await copyFormats(formats)
}

/// Puts several formats on the clipboard together, in place of what it
/// held: an app's own data with HTML and text for other apps (a
/// spreadsheet's cells as its own, an HTML table and tab-separated text).
/// Each type once; text/plain and text/html go as the platform's text and
/// rich text (HTML without text/plain gets its text, as copyHTML's does),
/// image/png as its image.
pub async fn copyFormats(formats: [ClipboardFormat]) throws {
  try await made().copyFormats(formats: try checkedFormats(formats))
}

/// A format's type as the platforms take it: trimmed, a MIME type in
/// lower case (a platform's own name as it is).
fn formatType(type: string) -> string {
  let t = type.trim()
  return if t.contains("/") { t.lower() } else { t }
}

/// formats with their types as the platforms take them, and text/html's
/// text as text/plain if they have none; throws for none, a type that's
/// empty, or one given twice.
fn checkedFormats(formats: [ClipboardFormat]) throws -> [ClipboardFormat] {
  if formats.isEmpty() {
    throw Error("device: no formats to copy")
  }
  var out: [ClipboardFormat] = []
  var seen = Set<string>()
  for f in formats {
    let t = formatType(f.type)
    if t.isEmpty() {
      throw Error("device: a clipboard format needs a type")
    }
    if !seen.insert(t.lower()) {
      throw Error("device: the clipboard format {t} is given twice")
    }
    out.push(ClipboardFormat(type: t, data: f.data))
  }
  if seen.contains("text/html") && !seen.contains("text/plain") {
    if let html = out.find(f => f.type == "text/html") {
      out.push(ClipboardFormat(type: "text/plain", data: plainOf(html.data.string()).bytes()))
    }
  }
  return out
}

/// What the clipboard holds at each change while the app is in front
/// (another app's copy is seen as the app comes back, on iOS): read it
/// then with clipboardText or clipboardImage. Nothing where the platform
/// doesn't say.
pub fn clipboardChanges() -> Stream<ClipboardKinds> = Stream(send => {
  if let p = platform {
    try await p.watchClipboard(changed: k => send(k))
  }
})

/// Keeps the screen on (the system's idle timer off) while on is true: a
/// video, a recipe, a navigation screen. Apple Watch's screen sleeps as
/// the wrist comes down whatever the app says: it does nothing there.
pub fn keepAwake(on: bool) {
  if let p = platform {
    try? p.keepAwake(on: on)
  }
}

// ---------------------------------------------------------------------
// Testing

/// What pickMedia (or pickPhotos) was asked for, as the fake keeps it.
pub struct PickRequest {
  kind: MediaKind
  max: int
  ordered: bool
  maxSize: int
  quality: float
}

state fakedPicker: FakePicker? = none

/// The fake photo picker fakePicker() makes, which a test sets and reads.
pub store FakePicker {
  /// What the user picks: pickMedia gives those of the kind asked, at
  /// most max of them (none: the user cancelled).
  pub state picked: [Media] = []
  /// What the pickers were asked for, in order.
  pub state asked: [PickRequest] = []
}

/// Fakes the photo picker for an app's tests: pickMedia and pickPhotos
/// answer at once with what the fake's picked holds.
pub fn fakePicker() -> FakePicker {
  let f = FakePicker()
  fakedPicker = f
  return f
}
