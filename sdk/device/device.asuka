// Package platform/device is what the platform offers apps beyond views:
// what device it is, links opened in other apps and in its in-app
// browser, the share sheet, haptic feedback, its photo and document
// pickers, the clipboard (text and images), and keeping the screen on.
//
//   let info = try await device.info()          // "iPhone", "iOS", "26.0"
//   device.openURL("mailto:hi@example.com")     // in the app that takes it
//   try await device.browse("https://go.dev")   // in the app
//   device.share("https://go.dev")              // the share sheet
//   device.haptic(.success)
//   device.copy("Copied")
//   let photos = try await device.pickPhotos(max: 3)
//   if let text = try await device.clipboardText() { paste(text) }
//
// The pickers need no permission: PHPicker and the document picker on
// iOS, the Photo Picker and the storage picker on Android, the system's
// open dialog on desktops, the browser's file picker. What they give are
// copies in the app's caches, the app's to keep or move.

import std/time

/// The device and the app.
pub struct Info {
  /// "iPhone", "Pixel 9", "Mac", "PC".
  model: string = ""
  /// "iOS", "Android", "macOS", "Windows", "Linux".
  system: string = ""
  /// "26.0", "16".
  systemVersion: string = ""
  /// asuka.toml's version.
  appVersion: string = ""
  /// asuka.toml's build.
  build: string = ""
  /// Where the app came from: a store, TestFlight, a download, a
  /// developer's build.
  source: InstallSource = .unknown
  /// When it was installed on this device (iOS, Android, the desktops);
  /// none where the platform doesn't say (the web).
  installedAt: time.Time? = none
  /// When this version of it was installed: an update's time, else
  /// installedAt.
  updatedAt: time.Time? = none
}

/// Info as the platform's code makes it: its times as milliseconds since
/// 1970 (0: none), which Info's are made of.
struct NativeInfo {
  model: string = ""
  system: string = ""
  systemVersion: string = ""
  appVersion: string = ""
  build: string = ""
  source: InstallSource = .unknown
  installedMs: int = 0
  updatedMs: int = 0
}

/// Where an app came from, as its platform tells: to show a beta's
/// banner, to point a sideloaded copy at the store.
pub enum InstallSource {
  /// The platform doesn't say (the web).
  unknown
  /// The App Store, the Mac App Store.
  appStore
  /// TestFlight: a beta, from App Store Connect.
  testFlight
  /// Google Play.
  playStore
  /// Another store: an Android one (Galaxy Store, F-Droid), the Microsoft
  /// Store, Flathub.
  otherStore
  /// Not from a store: a download, an installer, a sideloaded APK.
  direct
  /// A developer's build: asuka dev's, the simulator's, a debug build.
  development
}

/// A file the user picked.
pub struct File {
  /// A copy in the app's caches: the app's to keep or move.
  path: string
  /// Its name where it was ("Invoice.pdf").
  name: string
  /// Its MIME type, if known ("application/pdf").
  type: string = ""
  /// Its size, in bytes.
  size: int = 0
}

/// What the clipboard holds, said without reading it (iOS doesn't ask
/// the user for this): to show a Paste button only when there's
/// something to paste.
pub struct ClipboardKinds {
  text: bool = false
  image: bool = false
  url: bool = false
}

/// The platform's side.
native interface Platform {
  /// The device and the app.
  async fn info() -> NativeInfo
  /// Shows a web page in the app (or the browser, on desktops).
  async fn browse(url: string)
  /// The photo picker, for up to max images; their copies' paths.
  async fn pickPhotos(max: int) -> [string]
  /// The document picker (types: MIME types, none: any file).
  async fn pickFiles(types: [string], multiple: bool) -> [File]
  /// The clipboard's text; none if it has none.
  async fn clipboardText() -> string?
  /// What the clipboard holds.
  async fn clipboardHas() -> ClipboardKinds
  /// The clipboard's image, as a file in the app's caches; none if it
  /// has none.
  async fn clipboardImage() -> string?
  /// Puts the image file at path on the clipboard.
  async fn copyImage(path: string)
  /// Calls changed with what the clipboard holds at each change, until
  /// the task is cancelled.
  async fn watchClipboard(changed: fn(ClipboardKinds))
  /// Keeps the screen on while on.
  /// @mainThread
  fn keepAwake(on: bool)
}

// Made once; none where the platform has no code for it.
let platform = try? Platform()

fn made() throws -> Platform {
  if let p = platform {
    return p
  }
  throw Error("unsupported: no device here")
}

/// The device and the app.
pub async fn info() throws -> Info {
  let n = try await made().info()
  let at = (ms: int) => if ms > 0 { time.unixMilli(ms) } else { none }
  return Info(model: n.model, system: n.system, systemVersion: n.systemVersion, appVersion: n.appVersion, build: n.build,
    source: n.source, installedAt: at(n.installedMs), updatedAt: at(n.updatedMs))
}

/// Asks the system to open url in the app that takes it: a web address in
/// the browser, another scheme (tel:, mailto:, another app's) in the app
/// that handles it. browse shows a web page in the app instead.
pub native fn openURL(url: string)

/// Shows a web page in the app, over it: SFSafariViewController on iOS,
/// a Custom Tab on Android; desktops and the web open it in the user's
/// browser. (openURL leaves the app for the browser on phones too.)
pub async fn browse(url: string) throws {
  try await made().browse(url: url)
}

/// Shows the system's photo picker for up to max images (no permission
/// asked) and returns their files, which Image shows; none if the user
/// cancelled.
pub async fn pickPhotos(max: int = 1) throws -> [string] {
  var n = max
  if n < 1 { n = 1 }
  if n > 255 { n = 255 }
  return try await made().pickPhotos(max: n)
}

/// Shows the system's document picker (no permission asked) and returns
/// copies of the files picked, none if the user cancelled. types are MIME
/// types ("application/pdf", "image/*", "text/csv"); none: any file.
pub async fn pickFiles(types: [string] = [], multiple: bool = false) throws -> [File] {
  return try await made().pickFiles(types: types, multiple: multiple)
}

/// Shows the system's share sheet for a text or a link: a Mac's share
/// menu, Windows' share UI, the browser's Web Share sheet. Linux has
/// none: the text goes on the clipboard, with a toast (as a browser
/// without one does).
pub native fn share(text: string)

/// Shows the share sheet for files (their paths): a video to send, a PDF
/// to save to Files, photos for AirDrop. It returns once the sheet is
/// gone, whether the user shared or not (Windows: once it shows), and
/// throws when it couldn't show (a file that isn't there). mime is the
/// files' type, which the apps on the sheet go by (default: from the
/// first file's extension); uti is iOS's Uniform Type Identifier
/// (com.adobe.pdf), ahead of mime; title the sheet's (Android's chooser,
/// a mail's subject on iOS); from the view the sheet points at where it's
/// a popover (an iPad, a Mac), usually the button that shares (none: the
/// screen's middle). Linux has no share sheet: the files go on the
/// clipboard; a browser without Web Share for files downloads each.
pub async fn shareFiles(paths: [string], mime: string = "", uti: string = "", title: string = "", from: Ref? = none) throws {
  try await coreShareFiles(paths, mime, uti, title, from)
}

native async fn coreShareFiles(paths: [string], mime: string, uti: string, title: string, from: Ref?) throws

/// Haptic feedback, from the lightest to a result's.
pub enum Haptic {
  /// A selection changing: a picker's value, a segment.
  selection
  /// A light impact: a small element snapping into place.
  light
  /// A medium impact.
  medium
  /// A heavy impact: a large element landing.
  heavy
  /// A task succeeded.
  success
  /// A task produced a warning.
  warning
  /// A task failed.
  error
}

/// Plays haptic feedback: UIFeedbackGenerator on iOS,
/// performHapticFeedback on Android. A Mac plays the trackpad's (a Force
/// Touch trackpad: an alignment for selection, a level change for the
/// rest); a browser vibrates where it can (Chrome on Android); Windows
/// and Linux have no haptics, and do nothing.
pub native fn haptic(kind: Haptic)

/// Puts text on the clipboard (copyImage puts an image there).
pub native fn copy(text: string)

/// The clipboard's text, none if it has none (copy writes it). iOS asks
/// the user the first time an app reads what another app put there.
pub async fn clipboardText() throws -> string? {
  return try await made().clipboardText()
}

/// What the clipboard holds, without reading it.
pub async fn clipboardHas() throws -> ClipboardKinds {
  return try await made().clipboardHas()
}

/// The clipboard's image, read into a file in the app's caches in the
/// format the copying app gave it (PNG, JPEG, HEIC...: its extension
/// says); none if it has none. iOS asks the user the first time the app
/// reads what another app put there.
pub async fn clipboardImage() throws -> string? {
  return try await made().clipboardImage()
}

/// Puts the image file at path (PNG, JPEG, HEIC...) on the clipboard,
/// for pasting in another app.
pub async fn copyImage(path: string) throws {
  try await made().copyImage(path: path)
}

/// What the clipboard holds at each change while the app is in front
/// (another app's copy is seen as the app comes back, on iOS): read it
/// then with clipboardText or clipboardImage. Nothing where the platform
/// doesn't say.
pub fn clipboardChanges() -> Stream<ClipboardKinds> = Stream(send => {
  if let p = platform {
    try await p.watchClipboard(changed: k => send(k))
  }
})

/// Keeps the screen on (the system's idle timer off) while on is true: a
/// video, a recipe, a navigation screen.
pub fn keepAwake(on: bool) {
  if let p = platform {
    try? p.keepAwake(on: on)
  }
}
