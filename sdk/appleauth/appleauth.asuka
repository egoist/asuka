// Package platform/appleauth is Sign in with Apple: the system's sheet,
// Face ID and the Apple Account the device is signed in with, and
// Apple's button for it. The App Store requires it of an app that offers
// another company's sign-in for its accounts (guideline 4.8).
//
//   appleauth.SignInButton {
//     on press { let c = try await appleauth.signIn(scopes: [.fullName, .email]) }
//   }
//
// It's iOS's and macOS's: elsewhere available() is false, signIn throws
// notAvailable and the button shows nothing (sign in with Apple there on
// the web, through platform/webauth). An app that imports it is given the
// Sign in with Apple entitlement; its App ID needs the capability
// (developer.apple.com) for a signed build. Send the credential's
// identityToken (a JWT Apple signs) and authorizationCode to the app's
// server, which checks them with Apple.
//
// Tests drive a fake: appleauth.fake() answers as the user would.

/// What the app asks for, besides who the user is.
pub enum Scope {
  fullName
  email
}

/// Who signed in.
pub struct Credential {
  /// The user's stable ID for this app's team: the account's key.
  user: string = ""
  /// A JWT Apple signs, for the app's server to check.
  identityToken: string = ""
  /// Short-lived, for the server to exchange with Apple for tokens.
  authorizationCode: string = ""
  state: string = ""
  /// The email and the name come only the first time the user signs in
  /// to the app (if asked for): keep them then.
  email: string = ""
  givenName: string = ""
  familyName: string = ""
  /// Apple is confident it's a person.
  realUser: bool = false
}

/// An Apple Account's standing with the app.
pub enum CredentialState {
  /// The user stopped using Sign in with Apple for the app: sign them out.
  revoked
  authorized
  /// No such user for the app.
  notFound
  /// The app moved to another team.
  transferred
}

/// The button's title.
pub enum ButtonType {
  /// "Sign in with Apple"
  signIn
  /// "Continue with Apple"
  continueWithApple
  /// "Sign up with Apple"
  signUp
}

/// The button's colors.
pub enum ButtonVariant {
  /// On light backgrounds.
  black
  /// On dark ones.
  white
  /// White, outlined, on white.
  whiteOutline
  /// Black in light mode, white in dark.
  automatic
}

/// Sign in with Apple's errors.
pub enum AppleAuthError: Error {
  /// appleauth: canceled
  canceled
  /// appleauth: not available
  notAvailable

  /// The error's text: "appleauth: " and what went wrong, as each case's
  /// comment says.
  fn message() -> string = match self {
    .canceled => "appleauth: canceled"
    .notAvailable => "appleauth: not available"
  }
}

/// The platform's Sign in with Apple.
native interface Provider {
  fn available() -> bool
  /// Shows the sheet; throws canceled.
  async fn signIn(scopes: [Scope], nonce: string, state: string) -> Credential
  async fn credentialState(user: string) -> CredentialState
}

/// Apple's Sign in with Apple button (ASAuthorizationAppleIDButton): as
/// wide as it's given, 44 points tall (32 on the Mac) unless its style
/// says. Its press calls signIn.
pub native component SignInButton() {
  prop type: ButtonType = .signIn
  /// Its colors.
  prop variant: ButtonVariant = .automatic
  /// Rounds it (negative: the system's).
  prop cornerRadius: float = -1
  event press
}

let platform = try? Provider()

state faked: FakeAppleID? = none

/// Whether Sign in with Apple is on this device.
pub fn available() -> bool {
  if let f = faked {
    return f.available
  }
  if let p = platform {
    return (try? p.available()) ?? false
  }
  return false
}

/// Shows the system's Sign in with Apple sheet and returns the
/// credential; throws AppleAuthError.canceled. nonce is a value the
/// app's server made, echoed in the identity token; state is echoed in
/// the credential.
pub async fn signIn(scopes: [Scope] = [], nonce: string = "", state: string = "") throws -> Credential {
  if let f = faked {
    return try f.signIn(scopes, nonce, state)
  }
  if let p = platform {
    return try await p.signIn(scopes: scopes, nonce: nonce, state: state)
  }
  throw AppleAuthError.notAvailable
}

/// The user's standing (Credential.user): check it at launch, and sign
/// out a revoked user.
pub async fn credentialState(user: string) throws -> CredentialState {
  if let f = faked {
    return f.states[user] ?? .notFound
  }
  if let p = platform {
    return try await p.credentialState(user: user)
  }
  throw AppleAuthError.notAvailable
}

// ---------------------------------------------------------------------
// Testing

/// Sign in with Apple as a test drives it: fake() installs one. The
/// sheet answers credential (cancel: the user closes it), and asks for
/// the scopes it's given; states are the users' standings.
///
///   let apple = appleauth.fake()
///   apple.credential = appleauth.Credential(user: "001", email: "a@example.com")
pub store FakeAppleID {
  /// What available() answers; false makes signIn throw notAvailable.
  pub state available = true
  /// Who signs in: signIn returns it, with the email and the name only
  /// when its scopes ask for them, and with signIn's state.
  pub state credential: Credential = Credential(user: "000000.fake", identityToken: "fake.jwt.token", authorizationCode: "fake-code", realUser: true)
  /// The user closes the sheet.
  pub state cancel = false
  /// What credentialState answers, by user (notFound for one not in it).
  /// A sign-in sets its user's to authorized; set one to revoked to test
  /// signing out.
  pub state states: [string: CredentialState] = [:]
  /// The sheets shown, and what the last asked for.
  pub state shown = 0
  /// The scopes the last sheet asked for.
  pub state scopes: [Scope] = []
  /// The nonce the last sheet was given.
  pub state nonce = ""

  fn signIn(s: [Scope], n: string, st: string) throws -> Credential {
    if !available {
      throw AppleAuthError.notAvailable
    }
    shown += 1
    scopes = s
    nonce = n
    if cancel {
      throw AppleAuthError.canceled
    }
    let c = credential
    states[c.user] = .authorized
    // The name and the email come the first time only, if asked for.
    return Credential(user: c.user, identityToken: c.identityToken, authorizationCode: c.authorizationCode, state: st,
      email: if s.contains(.email) { c.email } else { "" },
      givenName: if s.contains(.fullName) { c.givenName } else { "" },
      familyName: if s.contains(.fullName) { c.familyName } else { "" },
      realUser: c.realUser)
  }
}

/// Installs a FakeAppleID, for a test: from now on the package reads it,
/// not the platform.
pub fn fake() -> FakeAppleID {
  let f = FakeAppleID()
  faked = f
  return f
}
