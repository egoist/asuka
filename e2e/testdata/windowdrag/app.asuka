// Window Drag shows a Window the user moves by its title and resizes by
// its corner (e2e's TestWindowDragWeb).

component Chart {
  state labs = true

  Column {
    padding: 24
    Text("status: ready")
    Window {
      bind open: labs
      title: "Lab results"
      width: 300
      height: 200
      minWidth: 200
      minHeight: 150
      Text("Sodium 139 mmol/L")
    }
  }
}

app { Chart() }

test "it shows its window" {
  let app = mount(Chart())
  app.expect("Sodium 139 mmol/L")
}
