// A Table of many rows (sortable, several selected, opened, a context
// menu), an Outline whose children load as they're expanded, a view
// with its own pointer, and the app's undo beside a field's own.
struct File {
  id: int
  name: string
  size: int
}

fn makeFiles(n: int) -> [File] = (0..<n).map(i => File(id: i, name: "File {i}", size: (i * 7919) % 1000))

fn sortFiles(files: [File], by: [SortKey]) -> [File] {
  if by.isEmpty() {
    return files
  }
  let k = by[0]
  return files.sorted((a, b) => {
    let less = if k.column == "size" { a.size < b.size || (a.size == b.size && a.id < b.id) } else { a.id < b.id }
    let more = if k.column == "size" { a.size > b.size || (a.size == b.size && a.id > b.id) } else { a.id > b.id }
    return if k.ascending { less } else { more }
  })
}

component Tables {
  state files = makeFiles(100_000)
  state sort: [SortKey] = []
  state selection: [int] = []
  state opened = "none"
  state chose = "none"
  state open: [string] = []
  state loaded: [string: [string]] = [:]
  state count = 0
  state note = ""
  state columns = "none"

  let shown = sortFiles(files, sort)

  fn load(id: string) {
    if loaded.has(id) {
      return
    }
    loaded[id] = ["{id}/A", "{id}/B"]
  }

  MenuBar {
    Menu("Edit") {
      MenuItem("") { role: .undo }
      MenuItem("") { role: .redo }
    }
  }
  Column {
    grow: 1
    Row {
      gap: 8
      padding: 8
      align: .center
      Button("Add") {
        on press {
          count += 1
          undo.register("Add", undo: () => { count -= 1 }, redo: () => { count += 1 })
        }
      }
      Text("Count {count}")
      Text("Hand here") {
        cursor: .pointer
        padding: 4
      }
      Text("Grab here") {
        cursor: .grab
        padding: 4
      }
      TextField {
        bind text: note
        placeholder: "Note"
        width: 160
      }
    }
    Text("Selected {selection.map(i => shown[i].name).joined(", ")}")
    Text("Opened {opened}")
    Text("Chose {chose}")
    Text("Expanded {open.joined(", ")}")
    Text("Columns {columns}")
    Row {
      grow: 1
      Outline(["Home", "Work"]) {
        width: 200
        childrenOf: id => loaded.get(id) ?? []
        expandable: id => !id.hasSuffix("/B")
        text: id => id.split("/").last() ?? id
        icon: id => "folder"
        bind expanded: open
        on expand(id, expanded) {
          if expanded {
            load(id)
          }
        }
        on open(id) { opened = id }
      }
      Table {
        grow: 1
        columns: [
          TableColumn(id: "name", title: "Name", width: 200, minWidth: 120, sortable: true),
          TableColumn(id: "size", title: "Size", width: 100, sortable: true, align: .end),
        ]
        selectionMode: .multiple
        columnsMovable: true
        on columnResize(c, w) { columns = "{c} {w}" }
        on columnMove(c, i) { columns = "{c} at {i}" }
        bind sort: sort
        bind selection: selection
        on open(row) { opened = shown[row].name }
        menu: row => [
          .button(title: "Star", run: () => { chose = "Star " + shown[row].name }),
          .button(title: "Delete", role: .destructive, run: () => { chose = "Delete " + shown[row].name }),
        ]
        for f in shown key f.id {
          TableRow([f.name, "{f.size}"]) {
            icon: "doc"
          }
        }
      }
    }
  }
}

app { Tables() }
