<?xml version="1.0" encoding="utf-8"?>
<!-- platform/widget's Layout: a toggle before Android 12, taking the space left (WidgetLayout.kt adds and sets it). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/asuka_wl"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/asuka_wl_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/asuka_widget_on_surface"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/asuka_wl_switch"
        android:layout_width="52dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/asuka_wl_switch_off" />
</LinearLayout>
